store:
  create: false   # ClusterSecretStore is rendered by the top-level openbao-store release

externalSecrets:
  - name: calendars-cluster-app
    target: calendars-cluster-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.calendars.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/calendars" .Environment.Name | quote }}
        property: database
  - name: calendars-cluster-superuser
    target: calendars-cluster-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/calendars" .Environment.Name | quote }}
        property: database_admin
  - name: calendars-valkey-auth
    target: calendars-valkey-auth
    data:
      - secretKey: default
        remoteKey: {{ printf "%s/calendars" .Environment.Name | quote }}
        property: password

  - name: calendars
    target: calendars
    type: Opaque
    data:
      - secretKey: DJANGO_SECRET_KEY
        remoteKey: {{ printf "%s/calendars" .Environment.Name | quote }}
        property: secretkey
      - secretKey: SALT_KEY
        remoteKey: {{ printf "%s/calendars" .Environment.Name | quote }}
        property: saltkey
      - secretKey: DB_PASSWORD
        remoteKey: {{ printf "%s/calendars" .Environment.Name | quote }}
        property: database
      - secretKey: PGPASSWORD
        remoteKey: {{ printf "%s/calendars" .Environment.Name | quote }}
        property: database
      - secretKey: OIDC_RP_CLIENT_SECRET
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: calendars_client_secret
      - secretKey: EMAIL_HOST_PASSWORD
        remoteKey: {{ printf "%s/smtp" .Environment.Name | quote }}
        property: password
      - secretKey: CALDAV_INBOUND_API_KEY
        remoteKey: {{ printf "%s/calendars" .Environment.Name | quote }}
        property: caldav_inbound
      - secretKey: CALDAV_OUTBOUND_API_KEY
        remoteKey: {{ printf "%s/calendars" .Environment.Name | quote }}
        property: caldav_outbound
      - secretKey: CALDAV_INTERNAL_API_KEY
        remoteKey: {{ printf "%s/calendars" .Environment.Name | quote }}
        property: caldav_internal
      - secretKey: MESSAGES_API_KEY
        remoteKey: {{ printf "%s/calendars" .Environment.Name | quote }}
        property: messages-calendars-channel-api-key
      - secretKey: password
        remoteKey: {{ printf "%s/calendars" .Environment.Name | quote }}
        property: password
        hidden: true
    templateData:
      REDIS_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@calendars-valkey:6379/0"
      DRAMATIQ_BROKER_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@calendars-valkey:6379/0"
      DRAMATIQ_RESULT_BACKEND_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@calendars-valkey:6379/1"
  - name: calendars-superuser
    target: calendars-superuser
    type: Opaque
    data:
      - secretKey: DJANGO_SUPERUSER_PASSWORD
        remoteKey: {{ printf "%s/calendars" .Environment.Name | quote }}
        property: adminPassword
    staticData:
      DJANGO_SUPERUSER_EMAIL: {{ .Values.secret.calendars.adminUser | quote }}
  - name: calendars-caldav-messages-channel
    target: calendars-caldav-messages-channel
    type: Opaque
    data:
      - secretKey: CALDAV_MESSAGES_CHANNEL_ID
        remoteKey: {{ printf "%s/calendars" .Environment.Name | quote }}
        property: messages-caldav-channel-id
      - secretKey: CALDAV_MESSAGES_CHANNEL_TOKEN
        remoteKey: {{ printf "%s/calendars" .Environment.Name | quote }}
        property: messages-caldav-channel-token
