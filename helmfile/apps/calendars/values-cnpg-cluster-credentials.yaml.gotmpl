name: calendars-cluster
owner: {{ .Values.database.calendars.user }}
password: {{ .Values.database.calendars.password }}
adminPassword: {{ .Values.database.calendars.adminpassword }}

# When the app is migrated to OpenBao-backed secrets, ESO provisions the
# `calendars-cluster-app` / `calendars-cluster-superuser` Secrets and this chart must not
# render its own.
external: {{ eq (dig "secrets" "backend" "derived" .Values) "external" }}
