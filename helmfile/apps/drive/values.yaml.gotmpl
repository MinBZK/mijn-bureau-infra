global:
  ## Global Docker image parameters
  ## Please, note that this will override the image parameters, including dependencies, configured to use the global value
  ## @param global.imageRegistry Global Docker Image registry
  ## @param global.imagePullSecrets Global Docker registry secret names as an array
  ##
  imageRegistry: {{(coalesce .Values.container.drive_backend.registry .Values.container.default.registry) | quote }}
  {{- with (coalesce .Values.container.drive_backend.imagePullSecret .Values.container.default.imagePullSecret) }}
  imagePullSecrets:
    - name: {{ . | quote }}
  {{- end }}
  ## @param global.defaultStorageClass Global default StorageClass for Persistent Volume(s)
  ##
  defaultStorageClass: {{ .Values.pvc.default.storageClass | quote }}


clusterDomain: {{ .Values.cluster.networking.domain | default "cluster.local" | quote }}

drive:
  image:
    registry: {{(coalesce .Values.container.drive_backend.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.drive_backend.repository | quote }}
    tag: {{ .Values.container.drive_backend.tag | quote }}

  resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.drive.backend .Values.global.resourcesPreset | quote }}
  resources: {{ .Values.resource.drive.driveBackend | toYaml | nindent 4 }}
  podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext:  {{ .Values.security.default.containerSecurityContext | toYaml | nindent 4 }}
  autoscaling:
    hpa: {{ .Values.autoscaling.horizontal.drive.backend | toYaml | nindent 6 }}
  pdb: {{ .Values.pdb.drive.backend | toYaml | nindent 4 }}
  runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}
  secretKey: {{ .Values.application.drive.secretKey | quote }}
  # Env-load the full drive secret (contains DB passwords, S3 keys and the
  # DJANGO_EMAIL_HOST_PASSWORD rendered by this chart), same as the meet chart.
  extraEnvVarsSecret: drive
  email:
    host: {{ .Values.smtp.host | quote }}
    port: {{ .Values.smtp.port | quote }}
    hostUser: {{ .Values.smtp.username | quote }}
    hostPassword: {{ .Values.smtp.password | quote }}
    useTls: {{ ternary "true" "false" (dig "tls" "enabled" true (.Values.smtp | default dict)) | quote }}
    useSsl: "false"
    from: {{ .Values.smtp.from.email | quote }}
    brandName: {{ .Values.smtp.from.name | quote }}
    logoImg: {{ .Values.smtp.from.logoImage | quote }}
    urlApp: "https://{{ .Values.global.hostname.drive }}.{{ .Values.global.domain }}"
  CSRFTrustedOrigins: "https://{{ .Values.global.hostname.drive }}.{{ .Values.global.domain }},http://{{ .Values.global.hostname.drive }}.{{ .Values.global.domain }}"
  CORSAllowedOrigins: "https://{{ .Values.global.hostname.drive }}.{{ .Values.global.domain }},http://{{ .Values.global.hostname.drive }}.{{ .Values.global.domain }}"
  AllowedHosts: "{{ .Values.global.hostname.drive }}.{{ .Values.global.domain }}"

  superuserEmail: {{  .Values.secret.drive.adminUser | quote }}
  superuserPassword: {{  .Values.secret.drive.adminPassword | quote }}
  serverToServerKey: {{ .Values.application.drive.secrettoServerKey | quote }}
  baseUrl: "https://{{ .Values.global.hostname.drive }}.{{ .Values.global.domain }}"
  externalMinioAPI: "https://{{ .Values.global.hostname.drive }}-minio.{{ .Values.global.domain }}"
  # Enforce per-user storage limits (default 10 GiB = 10737418240 bytes).
  # Empty ENTITLEMENTS_BACKEND_PARAMETERS falls back to local-backend defaults.
  # Per-user overrides are managed in the Django admin (storage_limit_override).
  extraEnvVars:
    - name: ENTITLEMENTS_BACKEND
      value: "core.entitlements.backends.local.LocalEntitlementsBackend"
    - name: ENTITLEMENTS_BACKEND_PARAMETERS
      value: '{"default_storage_limit": 10737418240}'
    {{- if .Values.application.messages.enabled }}
    # Messages integration: allow the messages OIDC client's access tokens on
    # the external API, and let the messages frontend drive the file picker
    # (SDK relay pages + CORS).
    - name: OIDC_RS_ALLOWED_AUDIENCES
      value: {{ .Values.authentication.client.messages.client_id | quote }}
    - name: SDK_ENABLED
      value: "true"
    - name: SDK_CORS_ALLOWED_ORIGINS
      value: "https://{{ .Values.global.hostname.messages }}.{{ .Values.global.domain }}"
    {{- end }}
    {{- if and .Values.application.clamav.enabled .Values.antivirus.icap.enabled }}
    {{- $icapHost := printf "%s.%s.svc.cluster.local" .Values.antivirus.icap.host (.Values.application.clamav.namespace | default "mijnbureau-clamav") }}
    # Malware detection: scan uploads with ClamAV through the ICAP sidecar of
    # the ClamAV release (django-lasuite ICAPBackend). The ClamAV namespace
    # must be allowed by its NetworkPolicy (addExternalClientAccess or an
    # ingress rule for this namespace).
    - name: MALWARE_DETECTION_BACKEND
      value: "lasuite.malware_detection.backends.icap.ICAPBackend"
    - name: MALWARE_DETECTION_PARAMETERS
      value: {{ printf `{"callback_path": "core.malware_detection.malware_detection_callback", "server_address": "%s", "server_port": %d, "service": "avscan"}` $icapHost (int .Values.antivirus.icap.port) | quote }}
    {{- end }}
  frontendCssUrl: "https://static-{{ .Values.global.hostname.drive }}.{{ .Values.global.domain }}/iframe-hide.css"
  frontendJsUrl: "https://static-{{ .Values.global.hostname.drive }}.{{ .Values.global.domain }}/bureaublad-button.js"
  logoutRedirectUrl: "https://{{ .Values.global.hostname.bureaublad }}.{{ .Values.global.domain }}"
  frontendExternalHomeUrl: "https://{{ .Values.global.hostname.bureaublad }}.{{ .Values.global.domain }}"

  {{ if .Values.application.collabora.enabled }}
  wopiClients: "collabora"
  collaborDiscoveryUrl: "https://{{ .Values.global.hostname.collabora }}.{{ .Values.global.domain }}/hosting/discovery"
  {{ end }}

  celery:
    resources: {{ .Values.resource.drive.celery | toYaml | nindent 6 }}
    autoscaling:
      hpa: {{ .Values.autoscaling.horizontal.drive.celery | toYaml | nindent 8 }}
    configuration:
      concurrency:
        min: 3
        max: 9
    pdb: {{ .Values.pdb.drive.celery | toYaml | nindent 6 }}
  celeryBeat:
    resources: {{ .Values.resource.drive.celeryBeat | toYaml | nindent 6 }}

drive_frontend:
  image:
    registry: {{(coalesce .Values.container.drive_frontend.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.drive_frontend.repository | quote }}
    tag: {{ .Values.container.drive_frontend.tag | quote }}

  resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.drive.frontend .Values.global.resourcesPreset | quote }}
  resources: {{ .Values.resource.drive.driveFrontend | toYaml | nindent 4 }}
  podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext:  {{ .Values.security.default.containerSecurityContext | toYaml | nindent 4 }}
  autoscaling:
    hpa: {{ .Values.autoscaling.horizontal.drive.frontend | toYaml | nindent 6 }}
  pdb: {{ .Values.pdb.drive.frontend | toYaml | nindent 4 }}
  runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}



ingress:
  ## @param ingress.enabled Enable ingress record generation for drive
  ##
  enabled: true
  hostname: {{ .Values.global.hostname.drive }}.{{ .Values.global.domain }}
  tls: {{ .Values.global.tls.enabled | default true }}
  selfSigned: {{ and .Values.global.tls.enabled .Values.global.tls.selfSigned | default false }}
  extraTls: {{ .Values.tls.drive | toYaml | nindent 4 }}
  ingressClassName: {{ .Values.cluster.ingress.className | quote }}
  annotations:
    {{- if .Values.cluster.ingress.annotations }}
    {{ .Values.cluster.ingress.annotations | toYaml | nindent 4 }}
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "nginx" }}
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    nginx.ingress.kubernetes.io/configuration-snippet: |
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "haproxy-openshift" }}
    haproxy.router.openshift.io/hsts_header: max-age=31536000;includeSubDomains;preload
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "traefik" }}
    traefik.ingress.kubernetes.io/router.middlewares: '{{ .Release.Namespace }}-hsts-header@kubernetescrd'
    {{- end }}

ingressMedia:
  enabled: true
  pathType: Prefix
  hostname: {{ .Values.global.hostname.drive }}.{{ .Values.global.domain }}
  ingressClassName: {{ .Values.cluster.ingress.className | quote }}
  path: /media
  extraPaths:
    - path: /media-auth
      pathType: Prefix
      backend:
        service:
          name: drive-nginx
          port:
            name: http
  annotations:
    {{- if .Values.cluster.ingress.annotations }}
    {{ .Values.cluster.ingress.annotations | toYaml | nindent 4 }}
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "nginx" }}
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    nginx.ingress.kubernetes.io/configuration-snippet: |
      add_header Content-Security-Policy "default-src 'none'" always;
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    {{- else if eq .Values.cluster.ingress.type "haproxy-openshift" }}
    haproxy.router.openshift.io/hsts_header: max-age=31536000;includeSubDomains;preload
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "traefik" }}
    traefik.ingress.kubernetes.io/router.middlewares: '{{ .Release.Namespace }}-hsts-header@kubernetescrd'
    {{- end }}
  tls: {{ .Values.global.tls.enabled | default true }}
  selfSigned: {{ and .Values.global.tls.enabled .Values.global.tls.selfSigned | default false }}
  extraTls: {{ .Values.tls.drive | toYaml | nindent 4 }}

ingressMediaPreview:
  enabled: true
  pathType: Prefix
  hostname: {{ .Values.global.hostname.drive }}.{{ .Values.global.domain }}
  ingressClassName: {{ .Values.cluster.ingress.className | quote }}
  path: /media/preview
  annotations:
    {{- if .Values.cluster.ingress.annotations }}
    {{ .Values.cluster.ingress.annotations | toYaml | nindent 4 }}
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "nginx" }}
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    nginx.ingress.kubernetes.io/configuration-snippet: |
      add_header Content-Security-Policy "default-src 'none'" always;
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    {{- else if eq .Values.cluster.ingress.type "haproxy-openshift" }}
    haproxy.router.openshift.io/hsts_header: max-age=31536000;includeSubDomains;preload
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "traefik" }}
    traefik.ingress.kubernetes.io/router.middlewares: '{{ .Release.Namespace }}-hsts-header@kubernetescrd'
    {{- end }}
  tls: {{ .Values.global.tls.enabled | default true }}
  selfSigned: {{ and .Values.global.tls.enabled .Values.global.tls.selfSigned | default false }}
  extraTls: {{ .Values.tls.drive | toYaml | nindent 4 }}

externalRedis:
  host: {{ .Values.cache.drive.host | quote }}
  port: {{ .Values.cache.drive.port | quote }}
  password: {{ .Values.cache.drive.password | quote }}

externalMinio:
  endpoint: {{ .Values.objectstore.drive.endpoint | quote }}
  port: {{ .Values.objectstore.drive.port | quote }}
  accessKey: {{ .Values.objectstore.drive.username | quote }}
  secretKey: {{ .Values.objectstore.drive.rootPassword | quote }}
  bucket: {{ .Values.objectstore.drive.bucket | quote }}
  useSSL: {{ .Values.objectstore.drive.useSSL | quote }}
  pathStyle: true

externalDatabase:
  database: {{ .Values.database.drive.name | quote }}
  username: {{ .Values.database.drive.user | quote }}
  host: {{ .Values.database.drive.host | quote }}
  password: {{ .Values.database.drive.password | quote }}
  port: {{ .Values.database.drive.port | quote }}
  type: {{ .Values.database.drive.type | quote }}
  logging: true

authentication:
  issuer: {{ .Values.authentication.oidc.issuer | quote }}
  authorization_endpoint: {{ .Values.authentication.oidc.authorization_endpoint | quote }}
  token_endpoint: {{ .Values.authentication.oidc.token_endpoint | quote }}
  introspection_endpoint: {{ .Values.authentication.oidc.introspection_endpoint | quote }}
  userinfo_endpoint: {{ .Values.authentication.oidc.userinfo_endpoint | quote }}
  end_session_endpoint: {{ .Values.authentication.oidc.end_session_endpoint | quote }}
  jwks_uri: {{ .Values.authentication.oidc.jwks_uri | quote }}
  claims:
    username: {{ .Values.authentication.oidc.claims.username | quote }}
    display_name: {{ .Values.authentication.oidc.claims.display_name | quote }}
    given_name: {{ .Values.authentication.oidc.claims.given_name | quote }}
    family_name: {{ .Values.authentication.oidc.claims.family_name | quote }}

  client:
    client_id: {{ .Values.authentication.client.drive.client_id | quote }}
    client_secret: {{ .Values.authentication.client.drive.client_secret | quote }}

{{- if ne .Values.global.resourcesPreset "none" }}
job:
  resources:
    requests:
      memory: 256Mi
      cpu: 100m
    limits:
      memory: 512Mi
      cpu: 200m
  {{- end }}

{{- if and .Values.application.clamav.enabled .Values.antivirus.icap.enabled }}
# django-lasuite maintenance for the ICAP malware detection backend: recover
# analyses stuck in PENDING/PROCESSING on worker restarts or ICAP timeouts.
# Without these a lost analysis would leave the upload stuck in ANALYZING.
# Same maintenance cronjobs as the upstream Drive chart ships.
extraDeploy:
  - apiVersion: batch/v1
    kind: CronJob
    metadata:
      name: drive-malware-check-pending
      labels:
        app.kubernetes.io/component: drive-backend
        app.kubernetes.io/part-of: drive
    spec:
      schedule: "*/5 * * * *"
      concurrencyPolicy: Forbid
      successfulJobsHistoryLimit: 3
      failedJobsHistoryLimit: 1
      jobTemplate:
        spec:
          template:
            metadata:
              labels:
                app.kubernetes.io/instance: drive
                app.kubernetes.io/name: drive
                app.kubernetes.io/component: drive-backend
            spec:
              restartPolicy: Never
              serviceAccountName: "drive"
              {{- with (coalesce .Values.container.drive_backend.imagePullSecret .Values.container.default.imagePullSecret) }}
              imagePullSecrets:
                - name: {{ . | quote }}
              {{- end }}
              {{- with .Values.cluster.runtimeClassName }}
              runtimeClassName: {{ . | quote }}
              {{- end }}
              containers:
                - name: check-pending-malware-analysis
                  image: "{{ (coalesce .Values.container.drive_backend.registry .Values.container.default.registry) }}/{{ .Values.container.drive_backend.repository }}:{{ .Values.container.drive_backend.tag }}"
                  imagePullPolicy: IfNotPresent
                  command: ["python", "manage.py", "check_analysis_pending"]
                  securityContext: {{ omit .Values.security.default.containerSecurityContext "enabled" | toYaml | nindent 20 }}
                  envFrom:
                    - configMapRef:
                        name: drive
                    - secretRef:
                        name: drive
                  resources: {{ (index ((.Values.resource | default dict).drive | default dict) "job" | default dict) | toYaml | nindent 20 }}
  - apiVersion: batch/v1
    kind: CronJob
    metadata:
      name: drive-malware-reschedule-processing
      labels:
        app.kubernetes.io/component: drive-backend
        app.kubernetes.io/part-of: drive
    spec:
      schedule: "0 4 * * *"
      concurrencyPolicy: Forbid
      successfulJobsHistoryLimit: 3
      failedJobsHistoryLimit: 1
      jobTemplate:
        spec:
          template:
            metadata:
              labels:
                app.kubernetes.io/instance: drive
                app.kubernetes.io/name: drive
                app.kubernetes.io/component: drive-backend
            spec:
              restartPolicy: Never
              serviceAccountName: "drive"
              {{- with (coalesce .Values.container.drive_backend.imagePullSecret .Values.container.default.imagePullSecret) }}
              imagePullSecrets:
                - name: {{ . | quote }}
              {{- end }}
              {{- with .Values.cluster.runtimeClassName }}
              runtimeClassName: {{ . | quote }}
              {{- end }}
              containers:
                - name: reschedule-processing-malware-analysis
                  image: "{{ (coalesce .Values.container.drive_backend.registry .Values.container.default.registry) }}/{{ .Values.container.drive_backend.repository }}:{{ .Values.container.drive_backend.tag }}"
                  imagePullPolicy: IfNotPresent
                  command: ["python", "manage.py", "reschedule_processing_analysis"]
                  securityContext: {{ omit .Values.security.default.containerSecurityContext "enabled" | toYaml | nindent 20 }}
                  envFrom:
                    - configMapRef:
                        name: drive
                    - secretRef:
                        name: drive
                  resources: {{ (index ((.Values.resource | default dict).drive | default dict) "job" | default dict) | toYaml | nindent 20 }}
{{- end }}
