name: drive-cluster
owner: {{ .Values.database.drive.user }}
password: {{ .Values.database.drive.password }}
adminPassword: {{ .Values.database.drive.adminpassword }}
# When the app is migrated to OpenBao-backed secrets, ESO provisions the
# `drive-cluster-app` / `drive-cluster-superuser` Secrets and this chart must
# not render its own.
external: {{ eq (dig "secrets" "backend" "derived" .Values) "external" }}
