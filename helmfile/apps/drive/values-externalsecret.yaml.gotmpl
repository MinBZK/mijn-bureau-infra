store:
  create: false   # ClusterSecretStore is rendered by the top-level openbao-store release

externalSecrets:
  # --- CNPG database credentials ---
  - name: drive-cluster-app
    target: drive-cluster-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.drive.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/drive" .Environment.Name | quote }}
        property: database
  - name: drive-cluster-superuser
    target: drive-cluster-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/drive" .Environment.Name | quote }}
        property: database_admin

  # --- Valkey ---
  - name: drive-valkey-auth
    target: drive-valkey-auth
    data:
      - secretKey: default
        remoteKey: {{ printf "%s/drive" .Environment.Name | quote }}
        property: password

  # --- SeaweedFS object store ---
  - name: drive-seaweedfs
    target: drive-seaweedfs
    staticData:
      access-key: "admin"
    data:
      - secretKey: secret-key
        remoteKey: {{ printf "%s/seaweedfs" .Environment.Name | quote }}
        property: drive

  # --- App Secret (pure + composed values) ---
  - name: drive
    target: drive
    type: Opaque
    data:
      - secretKey: DJANGO_SECRET_KEY
        remoteKey: {{ printf "%s/drive" .Environment.Name | quote }}
        property: secretkey
      - secretKey: DJANGO_SERVER_TO_SERVER_API_TOKENS
        remoteKey: {{ printf "%s/drive" .Environment.Name | quote }}
        property: secrettoServerKey
      - secretKey: DB_PASSWORD
        remoteKey: {{ printf "%s/drive" .Environment.Name | quote }}
        property: database
      - secretKey: OIDC_RP_CLIENT_SECRET
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: drive_client_secret
      - secretKey: AWS_S3_SECRET_ACCESS_KEY
        remoteKey: {{ printf "%s/seaweedfs" .Environment.Name | quote }}
        property: drive
      - secretKey: DJANGO_EMAIL_HOST_PASSWORD
        remoteKey: {{ printf "%s/smtp" .Environment.Name | quote }}
        property: password
      # valkey password, used only to compose the redis URLs below
      - secretKey: password
        remoteKey: {{ printf "%s/drive" .Environment.Name | quote }}
        property: password
        hidden: true
    templateData:
      AWS_S3_ACCESS_KEY_ID: "admin"
      REDIS_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@{{ .Values.cache.drive.host }}:{{ .Values.cache.drive.port }}/0"
      CELERY_BROKER_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@{{ .Values.cache.drive.host }}:{{ .Values.cache.drive.port }}/0"

  # --- Superuser ---
  - name: drive-superuser
    target: drive-superuser
    type: Opaque
    staticData:
      DJANGO_SUPERUSER_EMAIL: {{ .Values.secret.drive.adminUser | quote }}
    data:
      - secretKey: DJANGO_SUPERUSER_PASSWORD
        remoteKey: {{ printf "%s/drive" .Environment.Name | quote }}
        property: adminPassword
