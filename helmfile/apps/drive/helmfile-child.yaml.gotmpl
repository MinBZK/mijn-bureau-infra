bases:
  - "../../bases/default.yaml.gotmpl"

releases:
  - name: drive-cluster-credentials
    chart: ../common/charts/cnpg-cluster-credentials
    {{- if .Values.application.drive.namespace }}
    namespace: {{ .Values.application.drive.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.drive.enabled) | toYaml }}
    values:
      - "values-cnpg-cluster-credentials.yaml.gotmpl"

  - name: drive-cluster
    chart: ../common/charts/cluster
    {{- if .Values.application.drive.namespace }}
    namespace: {{ .Values.application.drive.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.drive.enabled) | toYaml }}
    needs:
      - {{ if .Values.application.drive.namespace }}{{ .Values.application.drive.namespace }}/{{ end }}drive-cluster-credentials
    values:
      - "values-cnpg-cluster.yaml.gotmpl"

  - name: drive-valkey
    chart: ../common/charts/valkey
    {{- if .Values.application.drive.namespace }}
    namespace: {{ .Values.application.drive.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.drive.enabled) | toYaml }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-valkey.yaml.gotmpl"
      - "values-valkey.yaml.gotmpl"

  - name: drive-minio
    chart: ../common/charts/minio
    version: "17.0.11"
    {{- if .Values.application.drive.namespace }}
    namespace: {{ .Values.application.drive.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.drive.enabled) | toYaml }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-cluster-ingress.yaml.gotmpl"
      - "values-minio.yaml.gotmpl"

  - name: drive
    chart: charts/drive
    condition: application.drive.enabled
    {{- if .Values.application.drive.namespace }}
    namespace: {{ .Values.application.drive.namespace }}
    {{- end }}
    {{- if and (eq .Environment.Name "demo") ( .Values.application.drive.enabled) }}
    needs:
      - {{ if .Values.application.drive.namespace }}{{ .Values.application.drive.namespace }}/{{ end }}drive-cluster
      - {{ if .Values.application.drive.namespace }}{{ .Values.application.drive.namespace }}/{{ end }}drive-valkey
      - {{ if .Values.application.drive.namespace }}{{ .Values.application.drive.namespace }}/{{ end }}drive-minio
    {{- end }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-cluster-ingress.yaml.gotmpl"
      - "values.yaml.gotmpl"

  - name: drive-nginx
    chart: ../common/charts/nginx
    {{- if .Values.application.drive.namespace }}
    namespace: {{ .Values.application.drive.namespace }}
    {{- end }}
    installed: {{ and .Values.application.drive.enabled (or (eq .Values.cluster.ingress.type "haproxy-openshift") (eq .Values.cluster.ingress.type "traefik")) | toYaml }}
    needs:
      - {{ if .Values.application.drive.namespace }}{{ .Values.application.drive.namespace }}/{{ end }}drive
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-cluster-ingress.yaml.gotmpl"
      - "values-nginx.yaml.gotmpl"

  - name: drive-static
    chart: ../common/charts/nginx
    {{- if .Values.application.drive.namespace }}
    namespace: {{ .Values.application.drive.namespace }}
    {{- end }}
    installed: {{ and .Values.application.drive.enabled (or (eq .Values.cluster.ingress.type "haproxy-openshift") (eq .Values.cluster.ingress.type "traefik")) | toYaml }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-cluster-ingress.yaml.gotmpl"
      - "values-static-nginx.yaml.gotmpl"
