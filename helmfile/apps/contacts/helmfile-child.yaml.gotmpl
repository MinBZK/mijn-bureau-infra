bases:
  - "../../bases/default.yaml.gotmpl"

releases:
  - name: contacts-cluster-credentials
    labels:
      app: contacts
    chart: ../common/charts/cnpg-cluster-credentials
    {{- if .Values.application.contacts.namespace }}
    namespace: {{ .Values.application.contacts.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.contacts.enabled) | toYaml }}
    values:
      - "values-cnpg-cluster-credentials.yaml.gotmpl"

  - name: contacts-cluster
    labels:
      app: contacts
    chart: ../common/charts/cluster
    {{- if .Values.application.contacts.namespace }}
    namespace: {{ .Values.application.contacts.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.contacts.enabled) | toYaml }}
    needs:
      - {{ if .Values.application.contacts.namespace }}{{ .Values.application.contacts.namespace }}/{{ end }}contacts-cluster-credentials
    values:
      - "values-cnpg-cluster.yaml.gotmpl"

  - name: contacts-valkey
    labels:
      app: contacts
    chart: ../common/charts/valkey
    {{- if .Values.application.contacts.namespace }}
    namespace: {{ .Values.application.contacts.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.contacts.enabled) | toYaml }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-valkey.yaml.gotmpl"
      - "values-valkey.yaml.gotmpl"

  - name: contacts
    labels:
      app: contacts
    chart: charts/contacts
    condition: application.contacts.enabled
    {{- if .Values.application.contacts.namespace }}
    namespace: {{ .Values.application.contacts.namespace }}
    {{- end }}
    {{- if and (eq .Environment.Name "demo") ( .Values.application.contacts.enabled) }}
    needs:
      - {{ if .Values.application.contacts.namespace }}{{ .Values.application.contacts.namespace }}/{{ end }}contacts-cluster
      - {{ if .Values.application.contacts.namespace }}{{ .Values.application.contacts.namespace }}/{{ end }}contacts-valkey
    {{- end }}
    values:
      - "../common/values-cluster-ingress.yaml.gotmpl"
      - "values.yaml.gotmpl"
