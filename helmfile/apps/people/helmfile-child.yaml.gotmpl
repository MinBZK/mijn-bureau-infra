bases:
  - "../../bases/default.yaml.gotmpl"

releases:
  - name: people-cluster-credentials
    labels:
      app: people
    chart: ../common/charts/cnpg-cluster-credentials
    {{- if .Values.application.people.namespace }}
    namespace: {{ .Values.application.people.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.people.enabled) | toYaml }}
    values:
      - "values-cnpg-cluster-credentials.yaml.gotmpl"

  - name: people-cluster
    labels:
      app: people
    chart: ../common/charts/cluster
    {{- if .Values.application.people.namespace }}
    namespace: {{ .Values.application.people.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.people.enabled) | toYaml }}
    needs:
      - {{ if .Values.application.people.namespace }}{{ .Values.application.people.namespace }}/{{ end }}people-cluster-credentials
    values:
      - "values-cnpg-cluster.yaml.gotmpl"

  - name: people-valkey
    labels:
      app: people
    chart: ../common/charts/valkey
    {{- if .Values.application.people.namespace }}
    namespace: {{ .Values.application.people.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.people.enabled) | toYaml }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-valkey.yaml.gotmpl"
      - "values-valkey.yaml.gotmpl"

  - name: people-seaweedfs
    labels:
      app: people
    chart: ../common/charts/seaweedfs
    {{- if .Values.application.people.namespace }}
    namespace: {{ .Values.application.people.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.people.enabled) | toYaml }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-cluster-ingress.yaml.gotmpl"
      - "../common/values-seaweedfs.yaml.gotmpl"
      - "values-seaweedfs.yaml.gotmpl"

  - name: people
    labels:
      app: people
    chart: charts/desk
    condition: application.people.enabled
    {{- if .Values.application.people.namespace }}
    namespace: {{ .Values.application.people.namespace }}
    {{- end }}
    {{- if and (eq .Environment.Name "demo") ( .Values.application.people.enabled) }}
    needs:
      - {{ if .Values.application.people.namespace }}{{ .Values.application.people.namespace }}/{{ end }}people-cluster
      - {{ if .Values.application.people.namespace }}{{ .Values.application.people.namespace }}/{{ end }}people-valkey
      - {{ if .Values.application.people.namespace }}{{ .Values.application.people.namespace }}/{{ end }}people-seaweedfs
    {{- end }}
    values:
      - "../common/values-cluster-ingress.yaml.gotmpl"
      - "values.yaml.gotmpl"

  # ESO-synced infra secrets (OpenBao -> Kubernetes). Rendered only when
  # the app is switched to external secrets; replaces the inline CNPG/
  # valkey/seaweedfs Secrets rendered by the releases above.
  - name: people-externalsecret
    chart: ../common/charts/externalsecret
    {{- if .Values.application.people.namespace }}
    namespace: {{ .Values.application.people.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.people.enabled) (eq (dig "secrets" "backend" "derived" .Values) "external") | toYaml }}
    values:
      - "values-externalsecret.yaml.gotmpl"
