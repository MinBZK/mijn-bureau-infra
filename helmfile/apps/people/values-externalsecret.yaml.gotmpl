store:
  create: false   # ClusterSecretStore is rendered by the top-level openbao-store release

externalSecrets:
  - name: people-cluster-app
    target: people-cluster-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.people.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/people" .Environment.Name | quote }}
        property: database
  - name: people-cluster-superuser
    target: people-cluster-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/people" .Environment.Name | quote }}
        property: database_admin
  - name: people-valkey-auth
    target: people-valkey-auth
    data:
      - secretKey: default
        remoteKey: {{ printf "%s/people" .Environment.Name | quote }}
        property: password
  - name: people-minio
    target: people-minio
    staticData:
      root-user: "admin"
    data:
      - secretKey: root-password
        remoteKey: {{ printf "%s/minio" .Environment.Name | quote }}
        property: people

  - name: people
    target: people
    type: Opaque
    data:
      - secretKey: DJANGO_SECRET_KEY
        remoteKey: {{ printf "%s/people" .Environment.Name | quote }}
        property: secretkey
      - secretKey: DJANGO_SUPERUSER_PASSWORD
        remoteKey: {{ printf "%s/people" .Environment.Name | quote }}
        property: adminPassword
      - secretKey: DB_PASSWORD
        remoteKey: {{ printf "%s/people" .Environment.Name | quote }}
        property: database
      - secretKey: OIDC_RP_CLIENT_SECRET
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: people_client_secret
      - secretKey: AWS_S3_SECRET_ACCESS_KEY
        remoteKey: {{ printf "%s/minio" .Environment.Name | quote }}
        property: people
      - secretKey: DJANGO_EMAIL_HOST_PASSWORD
        remoteKey: {{ printf "%s/smtp" .Environment.Name | quote }}
        property: password
      - secretKey: password
        remoteKey: {{ printf "%s/people" .Environment.Name | quote }}
        property: password
        hidden: true
    staticData:
      DJANGO_SUPERUSER_EMAIL: {{ .Values.secret.people.adminUser | quote }}
      AWS_S3_ACCESS_KEY_ID: "admin"
    templateData:
      REDIS_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@people-valkey:6379/1"
      DJANGO_CELERY_BROKER_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@people-valkey:6379/0"
