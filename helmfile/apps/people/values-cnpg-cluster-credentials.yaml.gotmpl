name: people-cluster
owner: {{ .Values.database.people.user }}
password: {{ .Values.database.people.password }}
adminPassword: {{ .Values.database.people.adminpassword }}

# When the app is migrated to OpenBao-backed secrets, ESO provisions the
# `people-cluster-app` / `people-cluster-superuser` Secrets and this chart must not
# render its own.
external: {{ eq (dig "secrets" "backend" "derived" .Values) "external" }}
