store:
  create: false   # ClusterSecretStore is rendered by the top-level openbao-store release

externalSecrets:
  - name: livekit-valkey-auth
    target: livekit-valkey-auth
    data:
      - secretKey: default
        remoteKey: {{ printf "%s/livekit" .Environment.Name | quote }}
        property: password

  # --- livekit-server (keys file + redis password) ---
  - name: livekit-server
    target: livekit-server
    type: Opaque
    data:
      - secretKey: REDIS_PASSWORD
        remoteKey: {{ printf "%s/livekit" .Environment.Name | quote }}
        property: password
      - secretKey: apikey_secret
        remoteKey: {{ printf "%s/livekit" .Environment.Name | quote }}
        property: meet_apiSecret
        hidden: true
      - secretKey: elementcall_secret
        remoteKey: {{ printf "%s/livekit" .Environment.Name | quote }}
        property: elementcall
        hidden: true
    templateData:
      keyfile.txt: "apikey: {{ "{{" }} .apikey_secret {{ "}}" }}\nelementcall: {{ "{{" }} .elementcall_secret {{ "}}" }}"

  # --- livekit-egress (config file) ---
  - name: livekit-egress
    target: livekit-egress
    type: Opaque
    data:
      - secretKey: api_secret
        remoteKey: {{ printf "%s/livekit" .Environment.Name | quote }}
        property: meet_apiSecret
        hidden: true
      - secretKey: redis_password
        remoteKey: {{ printf "%s/livekit" .Environment.Name | quote }}
        property: password
        hidden: true
      - secretKey: s3_secret
        remoteKey: {{ printf "%s/minio" .Environment.Name | quote }}
        property: meet
        hidden: true
    templateData:
      config.yaml: "api_key: apikey\napi_secret: {{ "{{" }} .api_secret {{ "}}" }}\ncpu_cost:\n  room_composite_cpu_cost: 2\n  track_composite_cpu_cost: 1\n  track_cpu_cost: 0.5\nenable_chrome_sandbox: false\nhealth_port: 8080\ninsecure: false\nlogging:\n  level: info\nprometheus_port: 9090\nredis:\n  address: livekit-valkey:6379\n  password: {{ "{{" }} .redis_password {{ "}}" }}\n  username: default\ns3:\n  access_key: admin\n  bucket: meet-media-storage\n  endpoint: http://meet-minio.mijnbureau-meet.svc.cluster.local:9000\n  force_path_style: true\n  region: eu-west-1\n  secret: {{ "{{" }} .s3_secret {{ "}}" }}\nws_url: wss://livekit.open-desk.nl"
