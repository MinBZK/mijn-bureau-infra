fullnameOverride: livekit-valkey

auth:
  {{- if eq (dig "secrets" "backend" "derived" .Values) "external" }}
  usersExistingSecret: livekit-valkey-auth
  {{- end }}
  aclUsers:
    default:
      permissions: "~* &* +@all"
      {{- if not (eq (dig "secrets" "backend" "derived" .Values) "external") }}
      password: {{ .Values.cache.livekit.password | quote }}
      {{- end }}

dataStorage:
  enabled: true
  requestedSize: {{ coalesce .Values.pvc.livekit.valkey.size .Values.pvc.default.size "1Gi" | quote }}
  {{- with (coalesce .Values.pvc.livekit.valkey.storageClass .Values.pvc.default.storageClass) }}
  className: {{ . | quote }}
  {{- end }}
  accessModes: {{ coalesce .Values.pvc.livekit.valkey.accessModes .Values.pvc.default.accessModes (list "ReadWriteOnce") | toYaml | nindent 4 }}

{{- with .Values.resource.livekit.valkey }}
resources: {{ toYaml . | nindent 2 }}
{{- end }}
