#
# SPDX-License-Identifier: APACHE-2.0

## Central branding assets host.
##
## Serves, on {{ printf "%s.%s" (index .Values.global.hostname "branding") .Values.global.domain }},
## one folder per application:
##   /<app>/v3-*.svg            MijnBureau header logos
##   /<app>/theme.css           per-app runtime styling (loaded by the app's
##                              FRONTEND_CSS_URL/frontendCssUrl hook)
##
## Wired apps today: docs, drive, conversations and meet (css / theme
## customization). calendars/messages/projects/dictaphone/element have folders
## ready but no upstream runtime hook yet.
##
## File contents live next to this file under files/<app>/ and are embedded in
## the branding-files ConfigMap keyed as <app>-<file>; nginx maps
## /<app>/<file> onto the flat ConfigMap key space (see serverBlock rewrite).
##
## The header images are generated by scripts/gen-logos4.py.

{{- $hostname := printf "%s.%s" (index .Values.global.hostname "branding") .Values.global.domain }}

## @section Global parameters
global:
  imageRegistry: {{ (coalesce .Values.container.nginx.registry .Values.container.default.registry) | quote }}
  {{- with (coalesce .Values.container.nginx.imagePullSecret .Values.container.default.imagePullSecret) }}
  imagePullSecrets:
    - {{ . | quote }}
  {{- end }}
  security:
    allowInsecureImages: true
  compatibility:
    openshift:
      adaptSecurityContext: auto

nameOverride: ""
fullnameOverride: ""
namespaceOverride: ""
clusterDomain: {{ .Values.cluster.networking.domain | default "cluster.local" | quote }}

## @param commonLabels Add labels to all the deployed resources
##
commonLabels:
  app.kubernetes.io/part-of: branding

## @param extraDeploy Extra objects to deploy (value evaluated as a template)
## This ConfigMap contains the static branding files served by this nginx
## instance. Keys are "<app>-<file>" (ConfigMap keys cannot contain "/");
## nginx rewrites /<app>/<file> requests to the flat key space.
##
extraDeploy:
  - apiVersion: v1
    kind: ConfigMap
    metadata:
      name: branding-files
      namespace: '{{ "{{ .Release.Namespace }}" }}'
      labels:
        app.kubernetes.io/instance: '{{ "{{ .Release.Name }}" }}'
        app.kubernetes.io/managed-by: '{{ "{{ .Release.Service }}" }}'
        app.kubernetes.io/name: '{{ "{{ include \"common.names.name\" . }}" }}'
        app.kubernetes.io/version: '{{ "{{ .Chart.AppVersion }}" }}'
        helm.sh/chart: '{{ "{{ include \"common.names.chart\" . }}" }}'
        app.kubernetes.io/part-of: branding
    data:
      docs-v3-documents.svg: |
{{ readFile "./files/docs/v3-documents.svg" | nindent 8 }}
      docs-theme.css: |
{{ readFile "./files/docs/theme.css" | nindent 8 }}
      drive-v3-bestanden.svg: |
{{ readFile "./files/drive/v3-bestanden.svg" | nindent 8 }}
      drive-theme.css: |
{{ readFile "./files/drive/theme.css" | nindent 8 }}
      conversations-v3-ai-assistent.svg: |
{{ readFile "./files/conversations/v3-ai-assistent.svg" | nindent 8 }}
      conversations-theme.css: |
{{ readFile "./files/conversations/theme.css" | nindent 8 }}
      meet-v3-videobellen.svg: |
{{ readFile "./files/meet/v3-videobellen.svg" | nindent 8 }}
      meet-theme.css: |
{{ readFile "./files/meet/theme.css" | nindent 8 }}
      calendars-v3-kalender.svg: |
{{ readFile "./files/calendars/v3-kalender.svg" | nindent 8 }}
      calendars-theme.css: |
{{ readFile "./files/calendars/theme.css" | nindent 8 }}
      messages-v3-email.svg: |
{{ readFile "./files/messages/v3-email.svg" | nindent 8 }}
      messages-theme.css: |
{{ readFile "./files/messages/theme.css" | nindent 8 }}
      projects-v3-projecten.svg: |
{{ readFile "./files/projects/v3-projecten.svg" | nindent 8 }}
      projects-theme.css: |
{{ readFile "./files/projects/theme.css" | nindent 8 }}
      dictaphone-v3-opnemen.svg: |
{{ readFile "./files/dictaphone/v3-opnemen.svg" | nindent 8 }}
      dictaphone-theme.css: |
{{ readFile "./files/dictaphone/theme.css" | nindent 8 }}
      element-v3-chat.svg: |
{{ readFile "./files/element/v3-chat.svg" | nindent 8 }}
      element-theme.css: |
{{ readFile "./files/element/theme.css" | nindent 8 }}

## @section NGINX parameters

image:
  registry: {{ (coalesce .Values.container.nginx.registry .Values.container.default.registry) | quote }}
  repository: {{ .Values.container.nginx.repository | default "nginx/nginx-unprivileged" | quote }}
  tag: {{ .Values.container.nginx.tag | default "1.30.6-alpine-slim" | quote }}
  digest: ""
  pullPolicy: Always
  {{- with (coalesce .Values.container.nginx.imagePullSecret .Values.container.default.imagePullSecret) }}
  pullSecrets:
    - {{ . | quote }}
  {{- end }}

replicaCount: 1

podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 2 }}
containerSecurityContext: {{ .Values.security.default.containerSecurityContext | toYaml | nindent 2 }}

containerPorts:
  http: 8080

resourcesPreset: {{ .Values.global.resourcesPreset | quote }}
resources: {{ .Values.resource.branding | toYaml | nindent 2 }}

## Probes hit the /health endpoint defined in serverBlock
##
livenessProbe:
  enabled: true
  initialDelaySeconds: 30
  timeoutSeconds: 5
  periodSeconds: 10
  failureThreshold: 6
  successThreshold: 1
readinessProbe:
  enabled: true
  path: /health
  initialDelaySeconds: 5
  timeoutSeconds: 3
  periodSeconds: 5
  failureThreshold: 3
  successThreshold: 1

## @param extraVolumes Array to add extra volumes
## Mounts the ConfigMap containing the branding files
##
extraVolumes:
  - name: static-files
    configMap:
      name: branding-files

## @param extraVolumeMounts Array to add extra mount
##
extraVolumeMounts:
  - name: static-files
    mountPath: /static
    readOnly: true

serviceAccount:
  create: true
  name: ""
  annotations: {}
  automountServiceAccountToken: false

sidecars: []
initContainers: []

pdb:
  create: true
  minAvailable: ""
  maxUnavailable: ""

## @section Custom NGINX application parameters

## @param serverBlock Custom server block to be added to NGINX configuration
## Serves the branding files as /<app>/<file> with a /health endpoint for
## Kubernetes probes. ConfigMap keys are flat ("<app>-<file>"), so the
## per-app prefix is rewritten onto them.
##
serverBlock: |-
  server {
    listen 8080;
    server_tokens off;

    # Health check endpoint for Kubernetes probes
    location /health {
      return 200 'ok';
      add_header Content-Type text/plain;
    }

    # /<app>/<file> -> /static/<app>-<file>
    rewrite ^/([a-z0-9-]+)/(.+)$ /$1-$2 break;

    location / {
      root /static;
      add_header Cache-Control "public, max-age=3600";
      add_header Access-Control-Allow-Origin "*";
      add_header X-Content-Type-Options "nosniff";
      add_header X-Frame-Options "DENY";
    }
  }

## @section Traffic Exposure parameters

service:
  type: ClusterIP
  ports:
    http: 80
    https: 443
  targetPort:
    http: http
    https: http
  externalTrafficPolicy: Cluster

## Network Policies
## Ref: https://kubernetes.io/docs/concepts/services-networking/network-policies/
##
networkPolicy:
  enabled: true
  allowExternal: true
  allowExternalEgress: false
  extraIngress: []
  extraEgress: []
  ingressNSMatchLabels: {}
  ingressNSPodMatchLabels: {}

## Configure the ingress resource that allows you to access the
## Nginx installation. Set up the URL
## ref: https://kubernetes.io/docs/concepts/services-networking/ingress/
##
ingress:
  enabled: true
  selfSigned: {{ and .Values.global.tls.enabled .Values.global.tls.selfSigned | default false }}
  pathType: Prefix
  apiVersion: ""
  hostname: {{ $hostname }}
  path: /
  annotations:
    {{- if .Values.cluster.ingress.annotations }}
    {{ .Values.cluster.ingress.annotations | toYaml | nindent 4 }}
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "nginx" }}
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    nginx.ingress.kubernetes.io/configuration-snippet: |
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "haproxy-openshift" }}
    haproxy.router.openshift.io/hsts_header: max-age=31536000;includeSubDomains;preload
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "traefik" }}
    traefik.ingress.kubernetes.io/router.middlewares: '{{ .Release.Namespace }}-hsts-header@kubernetescrd'
    {{- end }}
    {{- if and (hasKey .Values.cluster "certificate") (hasKey .Values.cluster.certificate "issuerRef") }}
    {{- if eq .Values.cluster.certificate.issuerRef.kind "ClusterIssuer" }}
    cert-manager.io/cluster-issuer: {{ .Values.cluster.certificate.issuerRef.name }}
    {{- else if eq .Values.cluster.certificate.issuerRef.kind "Issuer" }}
    cert-manager.io/issuer: {{ .Values.cluster.certificate.issuerRef.name }}
    {{- end }}
    {{- end }}
  ingressClassName: {{ .Values.cluster.ingress.className | quote }}
  tls: {{ .Values.global.tls.enabled | default true }}
  tlsWwwPrefix: false

nodeSelector: {}
tolerations: []

metrics:
  enabled: false
