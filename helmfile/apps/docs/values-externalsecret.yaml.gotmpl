store:
  create: false   # ClusterSecretStore is rendered by the top-level openbao-store release

externalSecrets:
  - name: docs-cluster-app
    target: docs-cluster-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.docs.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/docs" .Environment.Name | quote }}
        property: database
  - name: docs-cluster-superuser
    target: docs-cluster-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/docs" .Environment.Name | quote }}
        property: database_admin
  - name: docs-valkey-auth
    target: docs-valkey-auth
    data:
      - secretKey: default
        remoteKey: {{ printf "%s/docs" .Environment.Name | quote }}
        property: password
  - name: docs-minio
    target: docs-minio
    staticData:
      root-user: "admin"
    data:
      - secretKey: root-password
        remoteKey: {{ printf "%s/minio" .Environment.Name | quote }}
        property: docs

  - name: docs
    target: docs
    type: Opaque
    data:
      - secretKey: DJANGO_SECRET_KEY
        remoteKey: {{ printf "%s/docs" .Environment.Name | quote }}
        property: djangoSecretKey
      - secretKey: DJANGO_SERVER_TO_SERVER_API_TOKENS
        remoteKey: {{ printf "%s/docs" .Environment.Name | quote }}
        property: serverToServerApiToken
      - secretKey: DJANGO_SUPERUSER_PASSWORD
        remoteKey: {{ printf "%s/docs" .Environment.Name | quote }}
        property: superUserPassword
      - secretKey: OIDC_RP_CLIENT_SECRET
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: docs_client_secret
      - secretKey: Y_PROVIDER_API_KEY
        remoteKey: {{ printf "%s/docs" .Environment.Name | quote }}
        property: yProviderKey
      - secretKey: DB_PASSWORD
        remoteKey: {{ printf "%s/docs" .Environment.Name | quote }}
        property: database
      - secretKey: AI_API_KEY
        remoteKey: {{ printf "%s/ai" .Environment.Name | quote }}
        property: llm_apiKey
      - secretKey: OPENAI_SDK_API_KEY
        remoteKey: {{ printf "%s/ai" .Environment.Name | quote }}
        property: llm_apiKey
      - secretKey: DJANGO_EMAIL_HOST_PASSWORD
        remoteKey: {{ printf "%s/smtp" .Environment.Name | quote }}
        property: password
      - secretKey: password
        remoteKey: {{ printf "%s/docs" .Environment.Name | quote }}
        property: password
        hidden: true
      - secretKey: dbpassword
        remoteKey: {{ printf "%s/docs" .Environment.Name | quote }}
        property: database
        hidden: true
    templateData:
      REDIS_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@docs-valkey:6379/1"
      DJANGO_CELERY_BROKER_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@docs-valkey:6379/1"
      REDIS: "redis://default:{{ "{{" }} .password {{ "}}" }}@docs-valkey:6379/0"
      POSTGRES: "postgres://docs:{{ "{{" }} .dbpassword {{ "}}" }}@docs-cluster-rw:5432/yhub"
