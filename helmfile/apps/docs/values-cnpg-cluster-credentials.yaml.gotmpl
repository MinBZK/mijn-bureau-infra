name: docs-cluster
owner: {{ .Values.database.docs.user }}
password: {{ .Values.database.docs.password }}
adminPassword: {{ .Values.database.docs.adminpassword }}

# When the app is migrated to OpenBao-backed secrets, ESO provisions the
# `docs-cluster-app` / `docs-cluster-superuser` Secrets and this chart must not
# render its own.
external: {{ eq (dig "secrets" "backend" "derived" .Values) "external" }}
