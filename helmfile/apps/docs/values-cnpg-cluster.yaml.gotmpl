fullnameOverride: docs-cluster

type: postgresql

version:
  postgresql: "17"

mode: standalone

cluster:
  imageName: {{ printf "%s/%s:%s" .Values.container.cnpg_postgres.registry .Values.container.cnpg_postgres.repository .Values.container.cnpg_postgres.tag }}
  instances: 1

  enableSuperuserAccess: true
  superuserSecret: docs-cluster-superuser

  {{- with (coalesce .Values.container.cnpg_postgres.imagePullSecret .Values.container.default.imagePullSecret) }}
  imagePullSecrets:
    - name: {{ . | quote }}
  {{- end }}

  storage:
    size: {{ coalesce .Values.pvc.docs.postgresql.size .Values.pvc.default.size "8Gi" }}
    {{- with (coalesce .Values.pvc.docs.postgresql.storageClass .Values.pvc.default.storageClass) }}
    storageClass: {{ . }}
    {{- end }}

  {{- with .Values.resource.docs.postgresql }}
  resources: {{ toYaml . | nindent 4 }}
  {{- end }}

  monitoring:
    enabled: {{ .Values.metric.enabled | default false }}
    podMonitor:
      enabled: {{ .Values.metric.serviceMonitor.enabled | default false }}

  initdb:
    database: {{ .Values.database.docs.name }}
    owner: {{ .Values.database.docs.user }}
    secret:
      name: docs-cluster-app
    # impress migrations (0002, 0021) run CREATE EXTENSION IF NOT EXISTS.
    # Provision them at bootstrap so the migrate job can run as the app user
    # instead of the CNPG superuser, keeping table ownership with the app user.
    postInitApplicationSQL:
      - CREATE EXTENSION IF NOT EXISTS pg_trgm;
      - CREATE EXTENSION IF NOT EXISTS unaccent;

backups:
  enabled: false
