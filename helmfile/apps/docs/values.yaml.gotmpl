{{- $hostname := printf "%s.%s" .Values.global.hostname.docs .Values.global.domain }}
{{- $sslPostfix := ternary "s" "" (.Values.global.tls.enabled | default true) }}
{{- $baseUrl := printf "http%s://%s" $sslPostfix $hostname }}
{{- $redisUrl := printf "redis://default:%s@%s:%d/1" .Values.cache.docs.password .Values.cache.docs.host .Values.cache.docs.port -}}

global:
  security:
    allowInsecureImages: true

  {{- with (coalesce .Values.container.docs.imagePullSecret .Values.container.default.imagePullSecret) }}
  imagePullSecrets:
    - name: {{ . | quote }}
  {{- end }}

commonLabels:
  app.kubernetes.io/part-of: docs

clusterDomain: {{ .Values.cluster.networking.domain | default "cluster.local" | quote }}

backend:
  image:
    registry: {{(coalesce .Values.container.docs.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.docs.backend.repository | quote }}
    tag: {{ .Values.container.docs.backend.tag | quote }}
  replicaCount: 1
  resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.docs.backend .Values.global.resourcesPreset | quote }}
  resources: {{ .Values.resource.docs.backend | toYaml | nindent 4 }}
  podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext: {{ .Values.security.default.containerSecurityContext | toYaml | nindent 4 }}
  runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}
  pdb: {{ .Values.pdb.docs.backend | toYaml | nindent 4 }}
  autoscaling:
    hpa: {{ .Values.autoscaling.horizontal.docs.backend | toYaml | nindent 6 }}
    vpa: {{ .Values.autoscaling.vertical.docs.backend | toYaml | nindent 6 }}
  networkPolicy:
    extraEgress:
      # Database connectivity
      - ports:
          - port: {{ .Values.database.docs.port }}
            protocol: TCP
        {{- if .Values.database.docs.isInternal }}
        to:
          - podSelector:
              matchLabels:
                cnpg.io/cluster: docs-cluster
                role: primary
        {{- end }}
      # Redis connectivity
      - ports:
          - port: {{ .Values.cache.docs.port }}
            protocol: TCP
        {{- if .Values.cache.docs.isInternal }}
        to:
          - podSelector:
              matchLabels:
                app.kubernetes.io/name: valkey
                app.kubernetes.io/component: primary
        {{- end }}
      # MinIO connectivity
      - ports:
          - port: {{ .Values.objectstore.docs.port }}
            protocol: TCP
        {{- if .Values.objectstore.docs.isInternal }}
        to:
          - podSelector:
              matchLabels:
                app.kubernetes.io/name: minio
        {{- end }}
      {{- if .Values.ai.llm.endpoint.isInternal }}
      # AI connectivity
      - ports:
          - port: {{ .Values.ai.llm.endpoint.port }}
            protocol: TCP
        to:
          - podSelector:
              matchLabels:
                app.kubernetes.io/name: ollama
      {{- end }}
      # Docspec connectivity
      - ports:
          - port: 4000
            protocol: TCP
        to:
          - podSelector:
              matchLabels:
                app.kubernetes.io/name: docs-docspec
      # Allow https egress for keycloak connection and external AI
      - ports:
          - port: 443
      # Keycloak OIDC connectivity (internal service and pod ports)
      - ports:
          - port: 80
            protocol: TCP
          - port: 8080
            protocol: TCP
        to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: {{ .Values.application.keycloak.namespace | default "mijnbureau-keycloak" | quote }}
            podSelector:
              matchLabels:
                app.kubernetes.io/instance: keycloak-keycloak
                app.kubernetes.io/name: keycloak
      {{- if and .Values.application.clamav.enabled .Values.antivirus.icap.enabled }}
      # ClamAV ICAP malware scanning (ICAP sidecar on the clamav release,
      # cross-namespace). The celery-worker NetworkPolicy of this chart reuses
      # backend.networkPolicy.extraEgress, so one entry covers both.
      - ports:
          - port: {{ int .Values.antivirus.icap.port }}
            protocol: TCP
        to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: {{ .Values.application.clamav.namespace | default "mijnbureau-clamav" | quote }}
            podSelector:
              matchLabels:
                app.kubernetes.io/name: clamav
                app.kubernetes.io/instance: clamav
      {{- end }}
      # yProvider (converter) connection
      - ports:
          - port: 4444
      # yhub (collaboration REST API) connection
      - ports:
          - port: 3002
  jobs:
    # Jobs carry helm.sh/hook annotations (chart-level), so a fixed name +
    # before-hook-creation recreates them on each release. No timestamp suffix.
    releaseSuffix: ""
    jobs:
      - name: migrate
        annotations:
          argocd.argoproj.io/sync-options: Replace=true,Force=true
        weight: "-10"
        command:
          - /bin/sh
          - "-c"
          - |
            while ! python manage.py check --database default > /dev/null 2>&1
            do
              echo "Database not ready"
              sleep 2
            done

            echo "Database is ready"

            python manage.py migrate --no-input
        restartPolicy: OnFailure
      - name: createSuperUser
        annotations:
          argocd.argoproj.io/sync-options: Replace=true,Force=true
        weight: "0"
        command:
          - "/bin/sh"
          - "-c"
          - |
            while ! python manage.py check --database default > /dev/null 2>&1
            do
              echo "Database not ready"
              sleep 2
            done

            echo "Database is ready"

            python manage.py createsuperuser --email $DJANGO_SUPERUSER_EMAIL --password $DJANGO_SUPERUSER_PASSWORD
        restartPolicy: OnFailure
      {{- if and .Values.application.find.enabled .Values.application.find.searchEnabled }}
      # Enable the Find full-text/hybrid search feature flags for everyone
      # (django-waffle). Safe to re-run; the find integration env vars in
      # backend.envVars make these flags reach the Find API.
      - name: find-search-flags
        weight: "10"
        command:
          - /bin/sh
          - "-c"
          - |
            python manage.py waffle_flag flag_find_full_text_search --everyone --create
            python manage.py waffle_flag flag_find_hybrid_search --everyone --create
        restartPolicy: OnFailure
      {{- end }}
  envVars:
    AWS_S3_ENDPOINT_URL: {{ printf "http%s://%s:%d" (ternary "s" "" .Values.objectstore.docs.useSSL) .Values.objectstore.docs.endpoint .Values.objectstore.docs.port | quote }}
    AWS_S3_ACCESS_KEY_ID: {{ .Values.objectstore.docs.username | quote }}
    AWS_S3_SECRET_ACCESS_KEY: {{ .Values.objectstore.docs.rootPassword | quote }}
    AWS_STORAGE_BUCKET_NAME: {{ .Values.objectstore.docs.bucket | quote }}
    AI_FEATURE_ENABLED: {{ not (empty .Values.ai.llm.model) | quote }}
    {{- if .Values.ai.llm.endpoint.host }}
    {{- $aiEndpointBase := printf "http%s://%s" (ternary "s" "" .Values.ai.llm.endpoint.isSsl) .Values.ai.llm.endpoint.host }}
    {{- $aiEndpointIsInternal := .Values.ai.llm.endpoint.isInternal | default false }}
    {{- $aiEndpointPort := .Values.ai.llm.endpoint.port | default 0 | int }}
    {{- if not $aiEndpointIsInternal }}
    {{- $aiEndpointPort = 0 }}
    {{- end }}
    {{- $aiEndpointPath := .Values.ai.llm.endpoint.path | default "v1" }}
    {{- $aiEndpoint := $aiEndpointBase }}
    {{- if gt $aiEndpointPort 0 }}
    {{- $aiEndpoint = printf "%s:%d" $aiEndpoint $aiEndpointPort }}
    {{- end }}
    {{- $aiEndpoint = printf "%s/%s" $aiEndpoint $aiEndpointPath }}
    AI_ALLOW_REACH_FROM: "authenticated"
    AI_API_KEY: {{ .Values.ai.llm.apiKey | quote }}
    AI_BASE_URL: {{ $aiEndpoint }}
    AI_MODEL: {{ .Values.ai.llm.model | quote }}
    # BlockNote AI (current AI): agent-based in-editor editing, richer UX.
    # ⚠️ BlockNote xl-ai is GPL licensed — enabling this means complying with
    # the BlockNote license (https://www.blocknotejs.org/). The agent uses
    # pydantic-ai with OpenAI SDK params; OPENAI_SDK_* are set explicitly
    # instead of relying on the AI_API_KEY/AI_BASE_URL retrocompatibility
    # fallbacks. Never set MISTRAL_SDK_* alongside these (backend rejects it).
    AI_FEATURE_BLOCKNOTE_ENABLED: "true"
    OPENAI_SDK_API_KEY: {{ .Values.ai.llm.apiKey | quote }}
    OPENAI_SDK_BASE_URL: {{ $aiEndpoint }}
    {{- end }}
    API_USERS_LIST_LIMIT: "5"
    API_USERS_LIST_THROTTLE_RATE_BURST: "30/minute"
    API_USERS_LIST_THROTTLE_RATE_SUSTAINED: "180/hour"
    CACHES_DEFAULT_TIMEOUT: "30"
    # v6: yhub serves /collaboration/. The ws url ends in the yhub org name
    # (YHUB_ORG) and no longer carries the room in a query param. The backend
    # reaches the yhub REST API in-cluster; client-facing urls keep the public
    # hostname. COLLABORATION_SERVER_SECRET / _WS_NOT_CONNECTED_READY_ONLY /
    # NO_WEBSOCKET_CACHE_TIMEOUT were removed upstream (service-to-service auth
    # is now RS256 JWT, see the jwtKeys section).
    COLLABORATION_WS_URL: {{ printf "ws%s://%s/collaboration/ws/v1/%s" $sslPostfix $hostname "docs" | quote }}
    CONVERSION_API_CONTENT_FIELD: "content"
    CONVERSION_API_ENDPOINT: "convert"
    CONVERSION_API_SECURE: "false"
    CONVERSION_UPLOAD_ENABLED: "true"
    DOCSPEC_API_URL: http://docs-docspec:4000/conversion
    CRISP_WEBSITE_ID: ""
    DOCUMENT_IMAGE_MAX_SIZE: "10485760"
    # Central branding host (branding release, per-app folder "docs").
    FRONTEND_CSS_URL: "https://{{ index .Values.global.hostname "branding" }}.{{ .Values.global.domain }}/docs/theme.css"
    FRONTEND_HOMEPAGE_FEATURE_ENABLED: "false"
    FRONTEND_SILENT_LOGIN_ENABLED: "true"
    FRONTEND_THEME: ""
    DB_ENGINE: {{ .Values.database.docs.engine | quote}}
    DB_HOST: {{ .Values.database.docs.host | quote }}
    DB_PORT: {{ .Values.database.docs.port | quote }}
    DB_NAME: {{ .Values.database.docs.name | quote }}
    DB_USER: {{ .Values.database.docs.user | quote }}
    DB_PASSWORD: {{ .Values.database.docs.password | quote }}
    # The in-cluster service name must be allowed too: yhub and the y-provider
    # call the backend REST API and fetch its JWKS from
    # http://docs-backend (COLLABORATION_BACKEND_BASE_URL); Django rejects
    # those calls with 400 when the Host is not listed here.
    DJANGO_ALLOWED_HOSTS: {{ printf "%s,docs-backend" $hostname | quote }}
    DJANGO_CELERY_BROKER_URL: {{ $redisUrl | quote }}
    DJANGO_CELERY_BROKER_TRANSPORT_OPTIONS: ""
    DJANGO_CORS_ALLOW_ALL_ORIGINS: "false"
    DJANGO_CORS_ALLOWED_ORIGIN_REGEXES: ""
    DJANGO_CORS_ALLOWED_ORIGINS: {{ $baseUrl | quote }}
    DJANGO_CSRF_TRUSTED_ORIGINS: {{ $baseUrl | quote }}
    DJANGO_CONFIGURATION: "Production"
    DJANGO_EMAIL_BACKEND: "django.core.mail.backends.smtp.EmailBackend"
    DJANGO_EMAIL_BRAND_NAME: {{ .Values.smtp.from.name | quote }}
    DJANGO_EMAIL_FROM: {{ .Values.smtp.from.email | quote }}
    DJANGO_EMAIL_HOST: {{ .Values.smtp.host | quote }}
    DJANGO_EMAIL_HOST_PASSWORD: {{ .Values.smtp.password | quote }}
    DJANGO_EMAIL_HOST_USER: {{ .Values.smtp.username | quote }}
    DJANGO_EMAIL_LOGO_IMG: {{ .Values.smtp.from.logoImage | quote }}
    DJANGO_EMAIL_PORT: {{ .Values.smtp.port | quote }}
    DJANGO_EMAIL_URL_APP: {{ $baseUrl | quote }}
    DJANGO_EMAIL_USE_SSL: "false"
    DJANGO_EMAIL_USE_TLS: {{ .Values.smtp.tls.enabled | quote }}
    DJANGO_SERVER_TO_SERVER_API_TOKENS: {{ .Values.application.docs.serverToServerApiToken | quote }}
    DJANGO_SECRET_KEY: {{ .Values.application.docs.backend.django.secretKey | quote }}
    DJANGO_SETTINGS_MODULE: "impress.settings"
    # RS256 key the backend signs service tokens with (yhub, converter calls)
    # and publishes on /api/v1.0/jwks. Mounted by the chart from the
    # cluster-generated jwt-keys secret.
    JWT_PRIVATE_KEY_FILE: "/data/jwt/private.pem"
    DJANGO_SUPERUSER_EMAIL: {{ .Values.secret.docs.superUser.email | quote }}
    DJANGO_SUPERUSER_PASSWORD: {{ .Values.secret.docs.superUser.password | quote }}
    LANGUAGE_CODE: {{ .Values.global.defaultLocale | default "nl" | quote }}
    LOGGING_LEVEL_HANDLERS_CONSOLE: "ERROR"
    LOGGING_LEVEL_LOGGERS_APP: "INFO"
    LOGGING_LEVEL_LOGGERS_ROOT: "INFO"
    LOGIN_REDIRECT_URL: {{ $baseUrl | quote }}
    LOGIN_REDIRECT_URL_FAILURE: {{ $baseUrl | quote }}
    LOGOUT_REDIRECT_URL: {{ printf "https://%s.%s" .Values.global.hostname.bureaublad .Values.global.domain | quote }}
    {{- if and .Values.application.clamav.enabled .Values.antivirus.icap.enabled }}
    {{- $icapHost := printf "%s.%s.svc.cluster.local" .Values.antivirus.icap.host (.Values.application.clamav.namespace | default "mijnbureau-clamav") }}
    # Malware detection: scan uploads with ClamAV through the ICAP sidecar of
    # the ClamAV release (django-lasuite ICAPBackend), same as drive and
    # conversations. The backend netpol gets matching egress to the ClamAV
    # namespace (covered by backend.networkPolicy.extraEgress, which the
    # celery-worker policy reuses in this chart).
    MALWARE_DETECTION_BACKEND: "lasuite.malware_detection.backends.icap.ICAPBackend"
    MALWARE_DETECTION_PARAMETERS: {{ printf `{"callback_path": "core.malware_detection.malware_detection_callback", "server_address": "%s", "server_port": %d, "service": "avscan"}` $icapHost (int .Values.antivirus.icap.port) | quote }}
    {{- else }}
    MALWARE_DETECTION_BACKEND: "lasuite.malware_detection.backends.dummy.DummyBackend"
    MALWARE_DETECTION_PARAMETERS: '{"callback_path": "core.malware_detection.malware_detection_callback",}'
    {{- end }}
    MEDIA_BASE_URL: {{ $baseUrl | quote }}
    OIDC_ALLOW_DUPLICATE_EMAILS: "false"
    OIDC_AUTH_REQUEST_EXTRA_PARAMS: "{}"
    OIDC_CREATE_USER: "false"
    OIDC_FALLBACK_TO_EMAIL_FOR_IDENTIFICATION: "true"
    OIDC_OP_JWKS_ENDPOINT: {{ .Values.authentication.oidc.jwks_uri | quote }}
    OIDC_OP_AUTHORIZATION_ENDPOINT: {{ .Values.authentication.oidc.authorization_endpoint | quote }}
    OIDC_OP_TOKEN_ENDPOINT: {{ .Values.authentication.oidc.token_endpoint | quote }}
    OIDC_OP_USER_ENDPOINT: {{ .Values.authentication.oidc.userinfo_endpoint | quote }}
    OIDC_OP_LOGOUT_ENDPOINT: {{ .Values.authentication.oidc.end_session_endpoint | quote }}
    OIDC_REDIRECT_ALLOWED_HOSTS: "[{{ $baseUrl }}]"
    OIDC_REDIRECT_REQUIRE_HTTPS: "true"
    OIDC_RP_CLIENT_ID: {{ .Values.authentication.client.docs.client_id | quote }}
    OIDC_RP_CLIENT_SECRET: {{ .Values.authentication.client.docs.client_secret | quote }}
    OIDC_RP_SIGN_ALGO: "RS256"
    OIDC_RP_SCOPES: "openid email"
    OIDC_STORE_ID_TOKEN: "true"
    {{- if .Values.application.find.enabled }}
    # LaSuite Find global search (helmfile/apps/find). The backend indexes
    # every document into Find and (when application.find.searchEnabled, via
    # the waffle flags job below) proxies full-text search to it. Search needs
    # the user's OIDC tokens stored in the session for Menshen exchange.
    SEARCH_INDEXER_CLASS: "core.services.search_indexers.FindDocumentIndexer"
    INDEXING_URL: {{ printf "http%s://%s.%s/api/v1.0/documents/index/" $sslPostfix .Values.global.hostname.find .Values.global.domain | quote }}
    SEARCH_URL: {{ printf "http%s://%s.%s/api/v1.0/documents/search/" $sslPostfix .Values.global.hostname.find .Values.global.domain | quote }}
    SEARCH_INDEXER_SECRET: {{ .Values.application.find.serviceTokens.docs | quote }}
    SEARCH_INDEXER_COUNTDOWN: "10"
    OIDC_STORE_ACCESS_TOKEN: "true"
    OIDC_STORE_REFRESH_TOKEN: "true"
    OIDC_STORE_REFRESH_TOKEN_KEY: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "docs" "oidcStoreRefreshTokenKey" | sha256sum | trunc 32 | b64enc | quote }}
    {{- end }}
    # Edit-in-Docs (conversations): the external API is only mounted when the
    # OIDC resource server is enabled. Conversations calls it with the user's
    # stored OIDC access token; Docs introspects it in Keycloak with the docs
    # client and requires the token's client_id to be the conversations client.
    {{- $oidcOpUrl := .Values.authentication.oidc.issuer | default "" -}}
    {{- if not $oidcOpUrl }}{{ $oidcOpUrl = regexReplaceAll "/protocol/openid-connect.*" (.Values.authentication.oidc.introspection_endpoint | default "") "" }}{{ end }}
    OIDC_RESOURCE_SERVER_ENABLED: "true"
    OIDC_OP_URL: {{ $oidcOpUrl | quote }}
    OIDC_OP_INTROSPECTION_ENDPOINT: {{ .Values.authentication.oidc.introspection_endpoint | quote }}
    OIDC_RS_CLIENT_ID: {{ .Values.authentication.client.docs.client_id | quote }}
    OIDC_RS_CLIENT_SECRET: {{ .Values.authentication.client.docs.client_secret | quote }}
    # ListValue in this image splits on commas, not JSON: plain string list.
    OIDC_RS_ALLOWED_AUDIENCES: {{ .Values.authentication.client.conversations.client_id | quote }}
    OIDC_USE_NONCE: "true"
    OIDC_USERINFO_FULLNAME_FIELDS: "{{ .Values.authentication.oidc.claims.given_name }},{{ .Values.authentication.oidc.claims.family_name }}"
    OIDC_USERINFO_SHORTNAME_FIELD: {{ .Values.authentication.oidc.claims.display_name | quote }}
    PYTHONPATH: "/app"
    REDIS_URL: {{ $redisUrl | quote }}
    SENTRY_DSN: ""
    SESSION_COOKIE_AGE: "43200"
    SPECTACULAR_SETTINGS_ENABLE_DJANGO_DEPLOY_CHECK: "false"
    STORAGES_STATICFILES_BACKEND: "django.contrib.staticfiles.storage.StaticFilesStorage"
    THEME_CUSTOMIZATION_CACHE_TIMEOUT: "86400"
    # THEME_CUSTOMIZATION_FILE_PATH intentionally unset: upstream default
    # (/app/impress/configuration/theme/default.json) matches the chart's
    # themeCustomization mount path. Setting it to "" disables customization.
    USER_OIDC_ESSENTIAL_CLAIMS: ""
    # v6: the yhub collaboration server (REST API reached in-cluster).
    # YHUB_ORG must match yhub's YHUB_ORG; it is the last segment of
    # COLLABORATION_WS_URL.
    YHUB_API_BASE_URL: "http://docs-yhub:443"
    YHUB_ORG: "docs"
    Y_PROVIDER_API_BASE_URL: "http://docs-y-provider:443/api/"
    # Throttle-bypass header value shared with yhub (X-Y-Provider-Key).
    Y_PROVIDER_API_KEY: {{ .Values.application.docs.yProvider.key | quote }}
  celery:
    livenessProbe:
      enabled: false
    readinessProbe:
      enabled: false
    resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.docs.celery .Values.global.resourcesPreset | quote }}
    resources: {{ .Values.resource.docs.celery | toYaml | nindent 6 }}
    podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 6 }}
    containerSecurityContext: {{ .Values.security.default.containerSecurityContext | toYaml | nindent 6 }}
    runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}
    autoscaling:
      hpa: {{ .Values.autoscaling.horizontal.docs.celery | toYaml | nindent 8 }}
      vpa: {{ .Values.autoscaling.vertical.docs.celery | toYaml | nindent 8 }}
    pdb: {{ .Values.pdb.docs.celery | toYaml | nindent 6 }}
    networkPolicy:
      extraEgress:
        # Database connectivity
        - ports:
            - port: {{ .Values.database.docs.port }}
              protocol: TCP
          {{- if .Values.database.docs.isInternal }}
          to:
            - podSelector:
                matchLabels:
                  cnpg.io/cluster: docs-cluster
                  role: primary
          {{- end }}
        # Redis connectivity
        - ports:
            - port: {{ .Values.cache.docs.port }}
              protocol: TCP
          {{- if .Values.cache.docs.isInternal }}
          to:
            - podSelector:
                matchLabels:
                  app.kubernetes.io/name: valkey
                  app.kubernetes.io/component: primary
          {{- end }}
        # MinIO connectivity
        - ports:
            - port: {{ .Values.objectstore.docs.port }}
              protocol: TCP
          {{- if .Values.objectstore.docs.isInternal }}
          to:
            - podSelector:
                matchLabels:
                  app.kubernetes.io/name: minio
          {{- end }}
    configuration:
      concurrency:
        min: 3
        max: 9

  # Theme customization: replaces the header icon (top-left logo) with the
  # MijnBureau header image served by the branding release. The rest of the
  # file mirrors the image's built-in default.json to keep footer/home/favicon
  # behaviour unchanged.
  themeCustomization:
    enabled: true
    fileContent: |
      {
        "footer": {
          "default": {
            "logo": {
              "src": "/assets/icon-docs.svg",
              "alt": "Docs Logo",
              "width": 54,
              "height": 63,
              "style": { "width": "54px", "height": "auto" },
              "withTitle": true
            },
            "externalLinks": [
              {
                "label": "GitHub",
                "href": "https://github.com/suitenumerique/docs/"
              },
              {
                "label": "DINUM",
                "href": "https://www.numerique.gouv.fr/dinum/"
              },
              {
                "label": "ZenDiS",
                "href": "https://zendis.de/"
              },
              {
                "label": "BlockNote.js",
                "href": "https://www.blocknotejs.org/"
              }
            ],
            "bottomInformation": {
              "label": "Unless otherwise stated, all content on this site is under",
              "link": {
                "label": "licence etalab-2.0",
                "href": "https://github.com/etalab/licence-ouverte/blob/master/LO.md"
              }
            }
          },
          "en": {
            "legalLinks": [
              {
                "label": "Legal Notice",
                "href": "#"
              },
              {
                "label": "Personal data and cookies",
                "href": "#"
              },
              {
                "label": "Accessibility",
                "href": "#"
              }
            ],
            "bottomInformation": {
              "label": "Unless otherwise stated, all content on this site is under",
              "link": {
                "label": "licence MIT",
                "href": "https://github.com/suitenumerique/docs/blob/main/LICENSE"
              }
            }
          },
          "fr": {
            "legalLinks": [
              {
                "label": "Mentions légales",
                "href": "#"
              },
              {
                "label": "Données personnelles et cookies",
                "href": "#"
              },
              {
                "label": "Accessibilité",
                "href": "#"
              }
            ],
            "bottomInformation": {
              "label": "Sauf mention contraire, tout le contenu de ce site est sous",
              "link": {
                "label": "licence MIT",
                "href": "https://github.com/suitenumerique/docs/blob/main/LICENSE"
              }
            }
          },
          "de": {
            "legalLinks": [
              {
                "label": "Impressum",
                "href": "#"
              },
              {
                "label": "Personenbezogene Daten und Cookies",
                "href": "#"
              },
              {
                "label": "Barrierefreiheit",
                "href": "#"
              }
            ],
            "bottomInformation": {
              "label": "Sofern nicht anders angegeben, steht der gesamte Inhalt dieser Webseite unter",
              "link": {
                "label": "licence MIT",
                "href": "https://github.com/suitenumerique/docs/blob/main/LICENSE"
              }
            }
          },
          "nl": {
            "legalLinks": [
              {
                "label": "Wettelijke bepalingen",
                "href": "#"
              },
              {
                "label": "Persoonlijke gegevens en cookies",
                "href": "#"
              },
              {
                "label": "Toegankelijkheid",
                "href": "#"
              }
            ],
            "bottomInformation": {
              "label": "Tenzij anders vermeld, is alle inhoud van deze site ondergebracht onder",
              "link": {
                "label": "licence MIT",
                "href": "https://github.com/suitenumerique/docs/blob/main/LICENSE"
              }
            }
          }
        },
        "home": {
          "with-proconnect": false,
          "icon-banner": {
            "src": "/assets/icon-docs.svg",
            "width": 64,
            "height": 74,
            "style": {
              "width": "64px",
              "height": "auto"
            },
            "alt": ""
          }
        },
        "header": {
          "logo": {},
          "icon": {
            "src": "https://{{ index .Values.global.hostname "branding" }}.{{ .Values.global.domain }}/docs/v3-documents.svg",
            "width": 120,
            "height": 32,
            "style": {
              "width": "120px",
              "height": "32px"
            },
            "alt": "MijnBureau Documents",
            "withTitle": false
          }
        },
        "favicon": {
          "light": {
            "href": "/assets/favicon-light.png",
            "type": "image/png"
          },
          "dark": {
            "href": "/assets/favicon-dark.png",
            "type": "image/png"
          }
        },
        "onboarding": {
          "enabled": true,
          "learn_more_url": "",
          "ready_template_url": ""
        },
        "help": {
          "documentation_url": "",
          "support_mailto": "",
          "legal_links": {
            "personal_data": "",
            "terms_of_use": "",
            "accessibility_statement": "",
            "legal_notice": ""
          }
        }
      }

frontend:
  image:
    registry: {{(coalesce .Values.container.docs.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.docs.frontend.repository | quote }}
    tag: {{ .Values.container.docs.frontend.tag | quote }}
  replicaCount: 1
  resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.docs.frontend .Values.global.resourcesPreset | quote }}
  resources: {{ .Values.resource.docs.backend | toYaml | nindent 4 }}
  podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext: {{ .Values.security.default.containerSecurityContext | toYaml | nindent 4 }}
  runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}
  pdb: {{ .Values.pdb.docs.frontend | toYaml | nindent 4 }}
  autoscaling:
    hpa: {{ .Values.autoscaling.horizontal.docs.frontend | toYaml | nindent 6 }}
    vpa: {{ .Values.autoscaling.vertical.docs.frontend | toYaml | nindent 6 }}
  configuration:
    publishAsMit: {{ .Values.application.docs.frontend.publishAsMit }}

docspec:
  image:
    registry: {{(coalesce .Values.container.docspec.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.docspec.repository | quote }}
    tag: {{ .Values.container.docspec.tag | quote }}
  replicaCount: 1
  resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.docs.docspec .Values.global.resourcesPreset | quote }}
  resources: {{ .Values.resource.docs.docspec | toYaml | nindent 4 }}
  podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext: {{ .Values.security.default.containerSecurityContext | toYaml | nindent 4 }}
  runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}
  pdb: {{ .Values.pdb.docs.docspec | toYaml | nindent 4 }}
  autoscaling:
    hpa: {{ .Values.autoscaling.horizontal.docs.docspec | toYaml | nindent 6 }}

yProvider:
  image:
    registry: {{(coalesce .Values.container.docs.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.docs.yProvider.repository | quote }}
    tag: {{ .Values.container.docs.yProvider.tag | quote }}
  replicaCount: 1
  resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.docs.yProvider .Values.global.resourcesPreset | quote }}
  resources: {{ .Values.resource.docs.backend | toYaml | nindent 4 }}
  podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext: {{ .Values.security.default.containerSecurityContext | toYaml | nindent 4 }}
  runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}
  pdb: {{ .Values.pdb.docs.yProvider | toYaml | nindent 4 }}
  autoscaling:
    hpa: {{ .Values.autoscaling.horizontal.docs.yProvider | toYaml | nindent 6 }}
    vpa: {{ .Values.autoscaling.vertical.docs.yProvider | toYaml | nindent 6 }}
  networkPolicy:
    extraEgress:
      # Database connectivity
      - ports:
          - port: {{ .Values.database.docs.port }}
            protocol: TCP
        {{- if .Values.database.docs.isInternal }}
        to:
          - podSelector:
              matchLabels:
                cnpg.io/cluster: docs-cluster
                role: primary
        {{- end }}
      # Redis connectivity
      - ports:
          - port: {{ .Values.cache.docs.port }}
            protocol: TCP
        {{- if .Values.cache.docs.isInternal }}
        to:
          - podSelector:
              matchLabels:
                app.kubernetes.io/name: valkey
                app.kubernetes.io/component: primary
        {{- end }}
      # MinIO connectivity
      - ports:
          - port: {{ .Values.objectstore.docs.port }}
            protocol: TCP
        {{- if .Values.objectstore.docs.isInternal }}
        to:
          - podSelector:
              matchLabels:
                app.kubernetes.io/name: minio
        {{- end }}
      # Allow https egress for backend connection
      - ports:
          - port: 443
      # Backend REST API in-cluster: the caller JWTs are verified against its
      # JWKS endpoint (COLLABORATION_BACKEND_BASE_URL in v6).
      - ports:
          - port: 80
        to:
          - podSelector:
              matchLabels:
                app.kubernetes.io/component: backend
  configuration:
    api:
      key: {{ .Values.application.docs.yProvider.key }}

# v6 collaboration server in the same chart (websocket + document state).
yhub:
  image:
    registry: {{(coalesce .Values.container.docs.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.docs.yhub.repository | quote }}
    tag: {{ .Values.container.docs.yhub.tag | quote }}
    pullPolicy: Always
  replicaCount: 1
  resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.docs.yhub .Values.global.resourcesPreset "small" | quote }}
  resources: {{ (.Values.resource.docs.yhub | default dict) | toYaml | nindent 4 }}
  podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext: {{ .Values.security.default.containerSecurityContext | toYaml | nindent 4 }}
  runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}
  pdb: {{ (.Values.pdb.docs.yhub | default (dict "create" false)) | toYaml | nindent 4 }}
  networkPolicy:
    extraEgress:
      # Database connectivity (own yhub database on the docs cluster)
      - ports:
          - port: {{ .Values.database.docs.port }}
            protocol: TCP
        {{- if .Values.database.docs.isInternal }}
        to:
          - podSelector:
              matchLabels:
                cnpg.io/cluster: docs-cluster
                role: primary
        {{- end }}
      # Redis connectivity (live document state)
      - ports:
          - port: {{ .Values.cache.docs.port }}
            protocol: TCP
        {{- if .Values.cache.docs.isInternal }}
        to:
          - podSelector:
              matchLabels:
                app.kubernetes.io/name: valkey
                app.kubernetes.io/component: primary
        {{- end }}
      # Legacy S3 bucket for soft migration of pre-v6 documents
      - ports:
          - port: {{ .Values.objectstore.docs.port }}
            protocol: TCP
        {{- if .Values.objectstore.docs.isInternal }}
        to:
          - podSelector:
              matchLabels:
                app.kubernetes.io/name: minio
        {{- end }}
      # Backend via the public https hostname (see envVar note)
      - ports:
          - port: 443
  envVars:
    # Live document state. Prefix namespaced on the shared valkey instance.
    REDIS: {{ printf "redis://default:%s@%s:%d/0" .Values.cache.docs.password .Values.cache.docs.host .Values.cache.docs.port | quote }}
    REDIS_PREFIX: "yhub"
    # Own database (created declaratively by the docs CNPG cluster release,
    # see values-cnpg-cluster.yaml.gotmpl → databases). On an external database
    # a "yhub" database owned by the docs user must exist.
    POSTGRES: {{ printf "postgres://%s:%s@%s:%d/yhub" .Values.database.docs.user .Values.database.docs.password .Values.database.docs.host (.Values.database.docs.port | int) | quote }}
    # The backend redirects plain http to https (SECURE_SSL_REDIRECT in the
    # Production config), so in-cluster http is useless: route through the
    # public https hostname instead.
    COLLABORATION_BACKEND_BASE_URL: {{ $baseUrl | quote }}
    COLLABORATION_SERVER_ORIGIN: {{ $baseUrl | quote }}
    YHUB_ORG: "docs"
    # Same value as the backend's Y_PROVIDER_API_KEY: throttle-bypass header.
    Y_PROVIDER_API_KEY: {{ .Values.application.docs.yProvider.key | quote }}
    # Seed rooms from the legacy Django/S3 document store on first access;
    # keep on until `python manage.py migrate_documents` has backfilled every
    # document, then flip to false.
    SOFT_MIGRATION: "false"
    LEGACY_S3_ENDPOINT_URL: {{ printf "http%s://%s:%d" (ternary "s" "" .Values.objectstore.docs.useSSL) .Values.objectstore.docs.endpoint .Values.objectstore.docs.port | quote }}
    LEGACY_S3_ACCESS_KEY_ID: {{ .Values.objectstore.docs.username | quote }}
    LEGACY_S3_SECRET_ACCESS_KEY: {{ .Values.objectstore.docs.rootPassword | quote }}
    LEGACY_S3_BUCKET_NAME: {{ .Values.objectstore.docs.bucket | quote }}
    LEGACY_S3_REGION_NAME: "eu-west-1"

jwtKeys:
  image:
    registry: {{(coalesce .Values.container.openssl.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.openssl.repository | quote }}
    tag: {{ .Values.container.openssl.tag | quote }}
    pullPolicy: Always
  kubectlImage:
    registry: {{(coalesce .Values.container.helm_kubectl.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.helm_kubectl.repository | quote }}
    tag: {{ .Values.container.helm_kubectl.tag | quote }}
    pullPolicy: Always

ingress:
  enabled: true
  hostname: {{ $hostname }}
  ingressClassName: {{ .Values.cluster.ingress.className | quote }}
  annotations:
    {{- if .Values.cluster.ingress.annotations }}
    {{ .Values.cluster.ingress.annotations | toYaml | nindent 4 }}
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "nginx" }}
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    nginx.ingress.kubernetes.io/configuration-snippet: |
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    {{- else if eq .Values.cluster.ingress.type "haproxy-openshift" }}
    haproxy.router.openshift.io/hsts_header: max-age=31536000;includeSubDomains;preload
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "traefik" }}
    traefik.ingress.kubernetes.io/router.middlewares: '{{ .Release.Namespace }}-hsts-header@kubernetescrd'
    {{- end }}
  tls: {{ .Values.global.tls.enabled | default true }}
  selfSigned: {{ and .Values.global.tls.enabled .Values.global.tls.selfSigned | default false }}
  extraTls: {{ .Values.tls.docs | toYaml | nindent 4 }}

ingressAdmin:
  enabled: true
  hostname: {{ .Values.global.hostname.docs }}.{{ .Values.global.domain }}
  ingressClassName: {{ .Values.cluster.ingress.className | quote }}
  annotations:
    {{- if .Values.cluster.ingress.annotations }}
    {{ .Values.cluster.ingress.annotations | toYaml | nindent 4 }}
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "nginx" }}
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    nginx.ingress.kubernetes.io/configuration-snippet: |
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    {{- else if eq .Values.cluster.ingress.type "haproxy-openshift" }}
    haproxy.router.openshift.io/hsts_header: max-age=31536000;includeSubDomains;preload
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "traefik" }}
    traefik.ingress.kubernetes.io/router.middlewares: '{{ .Release.Namespace }}-hsts-header@kubernetescrd'
    {{- end }}

  tls: {{ .Values.global.tls.enabled | default true }}
  selfSigned: {{ and .Values.global.tls.enabled .Values.global.tls.selfSigned | default false }}
  extraTls: {{ .Values.tls.docs | toYaml | nindent 4 }}

ingressCollaborationApi:
  enabled: true
  hostname: {{ $hostname }}
  ingressClassName: {{ .Values.cluster.ingress.className | quote }}
  annotations:
    {{- if .Values.cluster.ingress.annotations }}
    {{ .Values.cluster.ingress.annotations | toYaml | nindent 4 }}
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "nginx" }}
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    nginx.ingress.kubernetes.io/configuration-snippet: |
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    {{- else if eq .Values.cluster.ingress.type "haproxy-openshift" }}
    haproxy.router.openshift.io/hsts_header: max-age=31536000;includeSubDomains;preload
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "traefik" }}
    traefik.ingress.kubernetes.io/router.middlewares: '{{ .Release.Namespace }}-hsts-header@kubernetescrd'
    {{- end }}
  tls: {{ .Values.global.tls.enabled | default true }}
  selfSigned: {{ and .Values.global.tls.enabled .Values.global.tls.selfSigned | default false }}
  extraTls: {{ .Values.tls.docs | toYaml | nindent 4 }}

ingressCollaborationWS:
  enabled: true
  hostname: {{ $hostname }}
  ingressClassName: {{ .Values.cluster.ingress.className | quote }}
  annotations:
    {{- if .Values.cluster.ingress.annotations }}
    {{ .Values.cluster.ingress.annotations | toYaml | nindent 4 }}
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "nginx" }}
    nginx.ingress.kubernetes.io/enable-websocket: "true"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "86400"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "86400"
    nginx.ingress.kubernetes.io/upstream-hash-by: $arg_room
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    nginx.ingress.kubernetes.io/configuration-snippet: |
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    {{- else if eq .Values.cluster.ingress.type "haproxy-openshift" }}
    haproxy.router.openshift.io/timeout-tunnel: "86400"
    haproxy.router.openshift.io/hsts_header: max-age=31536000;includeSubDomains;preload
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "traefik" }}
    traefik.ingress.kubernetes.io/router.middlewares: '{{ .Release.Namespace }}-hsts-header@kubernetescrd'
    traefik.ingress.kubernetes.io/service.serverstransport: {{ .Release.Namespace }}-docs-transport@kubernetescrd
    traefik.ingress.kubernetes.io/service.sticky.cookie: "true"
    traefik.ingress.kubernetes.io/service.sticky.cookie.name: "DOCS_STICKY"
    {{- end }}
  tls: {{ .Values.global.tls.enabled | default true }}
  selfSigned: {{ and .Values.global.tls.enabled .Values.global.tls.selfSigned | default false }}
  extraTls: {{ .Values.tls.docs | toYaml | nindent 4 }}

ingressCollaborationsApi:
  enabled: true
  hostname: {{ $hostname }}
  ingressClassName: {{ .Values.cluster.ingress.className | quote }}
  annotations:
    {{- if .Values.cluster.ingress.annotations }}
    {{ .Values.cluster.ingress.annotations | toYaml | nindent 4 }}
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "nginx" }}
    nginx.ingress.kubernetes.io/upstream-hash-by: $arg_room
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    nginx.ingress.kubernetes.io/configuration-snippet: |
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    {{- else if eq .Values.cluster.ingress.type "haproxy-openshift" }}
    haproxy.router.openshift.io/hsts_header: max-age=31536000;includeSubDomains;preload
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "traefik" }}
    traefik.ingress.kubernetes.io/router.middlewares: '{{ .Release.Namespace }}-hsts-header@kubernetescrd'
    traefik.ingress.kubernetes.io/service.sticky.cookie: "true"
    traefik.ingress.kubernetes.io/service.sticky.cookie.name: "DOCS_STICKY"
    {{- end }}
  tls: {{ .Values.global.tls.enabled | default true }}
  selfSigned: {{ and .Values.global.tls.enabled .Values.global.tls.selfSigned | default false }}
  extraTls: {{ .Values.tls.docs | toYaml | nindent 4 }}

ingressMedia:
  enabled: true
  pathType: Prefix
  hostname: {{ $hostname }}
  ingressClassName: {{ .Values.cluster.ingress.className | quote }}
  path: /media
  extraPaths:
    - path: /media-auth
      pathType: Prefix
      backend:
        service:
          name: docs-nginx
          port:
            name: http
  annotations:
    {{- if .Values.cluster.ingress.annotations }}
    {{ .Values.cluster.ingress.annotations | toYaml | nindent 4 }}
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "nginx" }}
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    nginx.ingress.kubernetes.io/configuration-snippet: |
      add_header Content-Security-Policy "default-src 'none'" always;
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    {{- else if eq .Values.cluster.ingress.type "haproxy-openshift" }}
    haproxy.router.openshift.io/hsts_header: max-age=31536000;includeSubDomains;preload
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "traefik" }}
    traefik.ingress.kubernetes.io/router.middlewares: '{{ .Release.Namespace }}-hsts-header@kubernetescrd'
    {{- end }}
  tls: {{ .Values.global.tls.enabled | default true }}
  selfSigned: {{ and .Values.global.tls.enabled .Values.global.tls.selfSigned | default false }}
  extraTls: {{ .Values.tls.docs | toYaml | nindent 4 }}
