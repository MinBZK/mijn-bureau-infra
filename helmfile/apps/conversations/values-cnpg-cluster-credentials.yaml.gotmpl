name: conversations-cluster
owner: {{ .Values.database.conversations.user }}
password: {{ .Values.database.conversations.password }}
adminPassword: {{ .Values.database.conversations.adminpassword }}

# When the app is migrated to OpenBao-backed secrets, ESO provisions the
# `conversations-cluster-app` / `conversations-cluster-superuser` Secrets and this chart must not
# render its own.
external: {{ eq (dig "secrets" "backend" "derived" .Values) "external" }}
