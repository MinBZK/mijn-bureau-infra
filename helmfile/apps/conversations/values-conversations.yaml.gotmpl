global:
  ## Global Docker image parameters
  ## Please, note that this will override the image parameters, including dependencies, configured to use the global value
  ## @param global.imageRegistry Global Docker Image registry
  ## @param global.imagePullSecrets Global Docker registry secret names as an array
  ##
  imageRegistry: {{(coalesce .Values.container.conversations_backend.registry .Values.container.default.registry) | quote }}
  {{- with (coalesce .Values.container.conversations_backend.imagePullSecret .Values.container.default.imagePullSecret) }}
  imagePullSecrets:
    - name: {{ . | quote }}
  {{- end }}
  ## @param global.defaultStorageClass Global default StorageClass for Persistent Volume(s)
  ##
  defaultStorageClass: {{ .Values.pvc.default.storageClass | quote }}


clusterDomain: {{ .Values.cluster.networking.domain | default "cluster.local" | quote }}

conversations:
  image:
    registry: {{(coalesce .Values.container.conversations_backend.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.conversations_backend.repository | quote }}
    tag: {{ .Values.container.conversations_backend.tag | quote }}

  resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.conversations.backend .Values.global.resourcesPreset | quote }}
  resources: {{ .Values.resource.conversations.conversationsBackend | toYaml | nindent 4 }}
  podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext:  {{ .Values.security.default.containerSecurityContext | toYaml | nindent 4 }}
  autoscaling:
    hpa: {{ .Values.autoscaling.horizontal.conversations.backend | toYaml | nindent 6 }}
  pdb: {{ .Values.pdb.conversations.backend | toYaml | nindent 4 }}
  runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}

  secretKey: {{ .Values.application.conversations.secretKey | quote }}

  {{- if or .Values.smtp.host (and .Values.application.clamav.enabled .Values.antivirus.icap.enabled) }}
  extraEnvVars:
    {{- if .Values.smtp.host }}
    # Invitation and notification e-mail (conversations only mails when its
    # EMAIL_* settings are present; by default the backend is SMTP-disabled).
    - name: EMAIL_HOST
      value: {{ .Values.smtp.host | quote }}
    - name: EMAIL_PORT
      value: {{ .Values.smtp.port | quote }}
    - name: EMAIL_HOST_USER
      value: {{ .Values.smtp.username | quote }}
    - name: EMAIL_HOST_PASSWORD
      value: {{ .Values.smtp.password | quote }}
    - name: EMAIL_USE_TLS
      value: {{ .Values.smtp.tls.enabled | quote }}
    - name: EMAIL_USE_SSL
      value: "false"
    - name: EMAIL_FROM
      value: {{ .Values.smtp.from.email | quote }}
    - name: EMAIL_BRAND_NAME
      value: {{ .Values.smtp.from.name | quote }}
    - name: EMAIL_LOGO_IMG
      value: {{ .Values.smtp.from.logoImage | quote }}
    {{- end }}
    {{- if and .Values.application.clamav.enabled .Values.antivirus.icap.enabled }}
    {{- $icapHost := printf "%s.%s.svc.cluster.local" .Values.antivirus.icap.host (.Values.application.clamav.namespace | default "mijnbureau-clamav") }}
    # Malware detection: scan chat attachments with ClamAV through the ICAP
    # sidecar of the ClamAV release (django-lasuite ICAPBackend). The same
    # variables are injected into the Celery worker below; the analysis task
    # runs there while the callback is invoked from the backend.
    - name: MALWARE_DETECTION_BACKEND
      value: "lasuite.malware_detection.backends.icap.ICAPBackend"
    - name: MALWARE_DETECTION_PARAMETERS
      value: {{ printf `{"callback_path": "core.file_upload.malware_detection.malware_detection_callback", "server_address": "%s", "server_port": %d, "service": "avscan"}` $icapHost (int .Values.antivirus.icap.port) | quote }}
    {{- end }}
  {{- end }}

  CSRFTrustedOrigins: "https://{{ .Values.global.hostname.conversations }}.{{ .Values.global.domain }},http://{{ .Values.global.hostname.conversations }}.{{ .Values.global.domain }}"
  CORSAllowedOrigins: "https://{{ .Values.global.hostname.conversations }}.{{ .Values.global.domain }},http://{{ .Values.global.hostname.conversations }}.{{ .Values.global.domain }}"
  AllowedHosts: "{{ .Values.global.hostname.conversations }}.{{ .Values.global.domain }}"
  baseUrl: "https://{{ .Values.global.hostname.conversations }}.{{ .Values.global.domain }}"
  logoutRedirectUrl: "https://{{ .Values.global.hostname.bureaublad }}.{{ .Values.global.domain }}"
  {{- if .Values.application.docs.enabled }}
  docsBaseUrl: "https://{{ .Values.global.hostname.docs }}.{{ .Values.global.domain }}"
  {{- end }}

  superuserEmail: {{  .Values.secret.conversations.adminUser | quote }}
  superuserPassword: {{  .Values.secret.conversations.adminPassword | quote }}

  celery:
    resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.conversations.celery .Values.global.resourcesPreset | quote }}
    resources: {{ .Values.resource.conversations.celery | default dict | toYaml | nindent 6 }}
    podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 6 }}
    containerSecurityContext: {{ .Values.security.default.containerSecurityContext | toYaml | nindent 6 }}
    autoscaling:
      hpa: {{ .Values.autoscaling.horizontal.conversations.celery | toYaml | nindent 8 }}
    pdb: {{ .Values.pdb.conversations.celery | toYaml | nindent 6 }}
    runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}
    {{- if or .Values.smtp.host (and .Values.application.clamav.enabled .Values.antivirus.icap.enabled) }}
    extraEnvVars:
      {{- if .Values.smtp.host }}
      - name: EMAIL_HOST
        value: {{ .Values.smtp.host | quote }}
      - name: EMAIL_PORT
        value: {{ .Values.smtp.port | quote }}
      - name: EMAIL_HOST_USER
        value: {{ .Values.smtp.username | quote }}
      - name: EMAIL_HOST_PASSWORD
        value: {{ .Values.smtp.password | quote }}
      - name: EMAIL_USE_TLS
        value: {{ .Values.smtp.tls.enabled | quote }}
      - name: EMAIL_USE_SSL
        value: "false"
      - name: EMAIL_FROM
        value: {{ .Values.smtp.from.email | quote }}
      - name: EMAIL_BRAND_NAME
        value: {{ .Values.smtp.from.name | quote }}
      - name: EMAIL_LOGO_IMG
        value: {{ .Values.smtp.from.logoImage | quote }}
      {{- end }}
      {{- if and .Values.application.clamav.enabled .Values.antivirus.icap.enabled }}
      {{- $icapHost := printf "%s.%s.svc.cluster.local" .Values.antivirus.icap.host (.Values.application.clamav.namespace | default "mijnbureau-clamav") }}
      - name: MALWARE_DETECTION_BACKEND
        value: "lasuite.malware_detection.backends.icap.ICAPBackend"
      - name: MALWARE_DETECTION_PARAMETERS
        value: {{ printf `{"callback_path": "core.file_upload.malware_detection.malware_detection_callback", "server_address": "%s", "server_port": %d, "service": "avscan"}` $icapHost (int .Values.antivirus.icap.port) | quote }}
      {{- end }}
    {{- end }}

  celeryBeat:
    resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.conversations.celeryBeat .Values.global.resourcesPreset | quote }}
    resources: {{ .Values.resource.conversations.celeryBeat | default dict | toYaml | nindent 6 }}
    podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 6 }}
    containerSecurityContext: {{ .Values.security.default.containerSecurityContext | toYaml | nindent 6 }}
    runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}

conversations_frontend:
  frontendCssUrl: "https://static-{{ .Values.global.hostname.conversations }}.{{ .Values.global.domain }}/iframe-hide.css"
  frontendJsUrl: "https://static-{{ .Values.global.hostname.conversations }}.{{ .Values.global.domain }}/bureaublad-button.js"
  image:
    registry: {{(coalesce .Values.container.conversations_frontend.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.conversations_frontend.repository | quote }}
    tag: {{ .Values.container.conversations_frontend.tag | quote }}

  resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.conversations.frontend .Values.global.resourcesPreset | quote }}
  resources: {{ .Values.resource.conversations.conversationsFrontend | toYaml | nindent 4 }}
  podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext:  {{ .Values.security.default.containerSecurityContext | toYaml | nindent 4 }}
  autoscaling:
    hpa: {{ .Values.autoscaling.horizontal.conversations.frontend | toYaml | nindent 6 }}
  pdb: {{ .Values.pdb.conversations.frontend | toYaml | nindent 4 }}
  runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}

ingress:
  ## @param ingress.enabled Enable ingress record generation for conversations
  ##
  enabled: true
  hostname: {{ .Values.global.hostname.conversations }}.{{ .Values.global.domain }}
  tls: {{ .Values.global.tls.enabled | default true }}
  selfSigned: {{ and .Values.global.tls.enabled .Values.global.tls.selfSigned | default false }}
  extraTls: {{ .Values.tls.conversations | toYaml | nindent 4 }}
  ingressClassName: {{ .Values.cluster.ingress.className | quote }}
  annotations:
    {{- if .Values.cluster.ingress.annotations }}
    {{ .Values.cluster.ingress.annotations | toYaml | nindent 4 }}
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "nginx" }}
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    nginx.ingress.kubernetes.io/configuration-snippet: |
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "haproxy-openshift" }}
    haproxy.router.openshift.io/hsts_header: max-age=31536000;includeSubDomains;preload
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "traefik" }}
    traefik.ingress.kubernetes.io/router.middlewares: '{{ .Release.Namespace }}-hsts-header@kubernetescrd'
    {{- end }}

externalRedis:
  host: {{ .Values.cache.conversations.host | quote }}
  port: {{ .Values.cache.conversations.port | quote }}
  password: {{ .Values.cache.conversations.password | quote }}

externalDatabase:
  database: {{ .Values.database.conversations.name | quote }}
  username: {{ .Values.database.conversations.user | quote }}
  host: {{ .Values.database.conversations.host | quote }}
  password: {{ .Values.database.conversations.password | quote }}
  port: {{ .Values.database.conversations.port | quote }}
  type: {{ .Values.database.conversations.type | quote }}
  logging: true

externalObjectStore:
  endpoint: {{ printf "http%s://%s:%d" (ternary "s" "" .Values.objectstore.conversations.useSSL) .Values.objectstore.conversations.endpoint .Values.objectstore.conversations.port | quote }}
  region: {{ .Values.objectstore.conversations.region | quote }}
  accessKey: {{ .Values.objectstore.conversations.username | quote }}
  secretKey: {{ .Values.objectstore.conversations.rootPassword | quote }}
  bucket: {{ .Values.objectstore.conversations.bucket | quote }}


authentication:
  issuer: {{ .Values.authentication.oidc.issuer | quote }}
  authorization_endpoint: {{ .Values.authentication.oidc.authorization_endpoint | quote }}
  token_endpoint: {{ .Values.authentication.oidc.token_endpoint | quote }}
  introspection_endpoint: {{ .Values.authentication.oidc.introspection_endpoint | quote }}
  userinfo_endpoint: {{ .Values.authentication.oidc.userinfo_endpoint | quote }}
  end_session_endpoint: {{ .Values.authentication.oidc.end_session_endpoint | quote }}
  jwks_uri: {{ .Values.authentication.oidc.jwks_uri | quote }}
  claims:
    username: {{ .Values.authentication.oidc.claims.username | quote }}
    display_name: {{ .Values.authentication.oidc.claims.display_name | quote }}
    given_name: {{ .Values.authentication.oidc.claims.given_name | quote }}
    family_name: {{ .Values.authentication.oidc.claims.family_name | quote }}

  client:
    client_id: {{ .Values.authentication.client.conversations.client_id | quote }}
    client_secret: {{ .Values.authentication.client.conversations.client_secret | quote }}


{{- $ollamaEnabled := .Values.application.ollama.enabled }}
{{- $aiModel       := .Values.ai.llm.model                | default (ternary .Values.application.ollama.model "" $ollamaEnabled) }}
{{- $aiHost        := .Values.ai.llm.endpoint.host        | default (ternary "ollama" "" $ollamaEnabled) }}
{{- $aiPort        := .Values.ai.llm.endpoint.port        | default 11434 | int }}
{{- $aiIsSsl       := ternary false .Values.ai.llm.endpoint.isSsl (and $ollamaEnabled (not .Values.ai.llm.endpoint.host)) }}
{{- $aiEndpointIsInternal := .Values.ai.llm.endpoint.isInternal | default false }}
{{- if not $aiEndpointIsInternal }}
{{- $aiPort = 0 }}
{{- end }}
{{- $aiPath        := .Values.ai.llm.endpoint.path        | default "v1" }}
{{- $aiEndpointBase := printf "http%s://%s" (ternary "s" "" $aiIsSsl) $aiHost }}
{{- $aiEndpoint := $aiEndpointBase }}
{{- if gt $aiPort 0 }}
{{- $aiEndpoint = printf "%s:%d" $aiEndpoint $aiPort }}
{{- end }}
{{- $aiEndpoint = printf "%s/%s" $aiEndpoint $aiPath }}

ai:
  model: {{ $aiModel | quote }}
  endpoint: {{ $aiEndpoint | quote }}
  apiKey: {{ .Values.ai.llm.apiKey | default "" | quote }}

{{- if ne .Values.global.resourcesPreset "none" }}
job:
  resources:
    requests:
      memory: 256Mi
      cpu: 100m
    limits:
      memory: 512Mi
      cpu: 200m
{{- end }}

{{- if and .Values.application.clamav.enabled .Values.antivirus.icap.enabled }}
# django-lasuite maintenance for the ICAP malware detection backend: recover
# analyses stuck in PENDING/PROCESSING on worker restarts or ICAP timeouts.
# Without these a lost analysis would leave the attachment stuck in ANALYZING.
extraDeploy:
  - apiVersion: batch/v1
    kind: CronJob
    metadata:
      name: conversations-malware-check-pending
      # extraDeploy entries are rendered raw by this chart, so chase the
      # release namespace and the common label set explicitly; the repo-wide
      # conftest policies require it (policy/namespace.rego, policy/labels.rego).
      namespace: {{ .Values.application.conversations.namespace | default "mijnbureau-conversations" | quote }}
      labels:
        app.kubernetes.io/instance: conversations
        app.kubernetes.io/name: conversations
        app.kubernetes.io/version: {{ regexReplaceAll "^v" .Values.container.conversations_backend.tag "" | quote }}
        app.kubernetes.io/component: conversations-backend
        app.kubernetes.io/part-of: conversations
        app.kubernetes.io/managed-by: Helm
    spec:
      schedule: "*/5 * * * *"
      concurrencyPolicy: Forbid
      successfulJobsHistoryLimit: 3
      failedJobsHistoryLimit: 1
      jobTemplate:
        spec:
          template:
            metadata:
              labels:
                app.kubernetes.io/instance: conversations
                app.kubernetes.io/name: conversations
                app.kubernetes.io/component: conversations-backend
            spec:
              restartPolicy: Never
              serviceAccountName: "conversations"
              {{- with (coalesce .Values.container.conversations_backend.imagePullSecret .Values.container.default.imagePullSecret) }}
              imagePullSecrets:
                - name: {{ . | quote }}
              {{- end }}
              {{- with .Values.cluster.runtimeClassName }}
              runtimeClassName: {{ . | quote }}
              {{- end }}
              containers:
                - name: check-pending-malware-analysis
                  image: "{{ (coalesce .Values.container.conversations_backend.registry .Values.container.default.registry) }}/{{ .Values.container.conversations_backend.repository }}:{{ .Values.container.conversations_backend.tag }}"
                  imagePullPolicy: IfNotPresent
                  command: ["python", "manage.py", "check_analysis_pending"]
                  securityContext: {{ omit .Values.security.default.containerSecurityContext "enabled" | toYaml | nindent 20 }}
                  envFrom:
                    - configMapRef:
                        name: conversations
                    - secretRef:
                        name: conversations
                  resources: {{ (index ((.Values.resource | default dict).conversations | default dict) "job" | default dict) | toYaml | nindent 20 }}
  - apiVersion: batch/v1
    kind: CronJob
    metadata:
      name: conversations-malware-reschedule-processing
      namespace: {{ .Values.application.conversations.namespace | default "mijnbureau-conversations" | quote }}
      labels:
        app.kubernetes.io/instance: conversations
        app.kubernetes.io/name: conversations
        app.kubernetes.io/version: {{ regexReplaceAll "^v" .Values.container.conversations_backend.tag "" | quote }}
        app.kubernetes.io/component: conversations-backend
        app.kubernetes.io/part-of: conversations
        app.kubernetes.io/managed-by: Helm
    spec:
      schedule: "0 4 * * *"
      concurrencyPolicy: Forbid
      successfulJobsHistoryLimit: 3
      failedJobsHistoryLimit: 1
      jobTemplate:
        spec:
          template:
            metadata:
              labels:
                app.kubernetes.io/instance: conversations
                app.kubernetes.io/name: conversations
                app.kubernetes.io/component: conversations-backend
            spec:
              restartPolicy: Never
              serviceAccountName: "conversations"
              {{- with (coalesce .Values.container.conversations_backend.imagePullSecret .Values.container.default.imagePullSecret) }}
              imagePullSecrets:
                - name: {{ . | quote }}
              {{- end }}
              {{- with .Values.cluster.runtimeClassName }}
              runtimeClassName: {{ . | quote }}
              {{- end }}
              containers:
                - name: reschedule-processing-malware-analysis
                  image: "{{ (coalesce .Values.container.conversations_backend.registry .Values.container.default.registry) }}/{{ .Values.container.conversations_backend.repository }}:{{ .Values.container.conversations_backend.tag }}"
                  imagePullPolicy: IfNotPresent
                  command: ["python", "manage.py", "reschedule_processing_analysis"]
                  securityContext: {{ omit .Values.security.default.containerSecurityContext "enabled" | toYaml | nindent 20 }}
                  envFrom:
                    - configMapRef:
                        name: conversations
                    - secretRef:
                        name: conversations
                  resources: {{ (index ((.Values.resource | default dict).conversations | default dict) "job" | default dict) | toYaml | nindent 20 }}
{{- end }}
