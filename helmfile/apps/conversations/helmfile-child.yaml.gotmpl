bases:
  - "../../bases/default.yaml.gotmpl"

releases:
  - name: "conversations"
    chart: "charts/conversations"
    condition: application.conversations.enabled
    {{- if .Values.application.conversations.namespace }}
    namespace: {{ .Values.application.conversations.namespace | quote }}
    {{- end }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-cluster-ingress.yaml.gotmpl"
      - "values-conversations.yaml.gotmpl"
    {{- if and (eq .Environment.Name "demo") ( .Values.application.conversations.enabled) }}
    needs:
      - {{ if .Values.application.conversations.namespace }}{{ .Values.application.conversations.namespace }}/{{ end }}conversations-cluster
      - {{ if .Values.application.conversations.namespace }}{{ .Values.application.conversations.namespace }}/{{ end }}conversations-valkey
    {{- end }}

  - name: conversations-cluster-credentials
    chart: ../common/charts/cnpg-cluster-credentials
    {{- if .Values.application.conversations.namespace }}
    namespace: {{ .Values.application.conversations.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.conversations.enabled) | toYaml }}
    values:
      - "values-cnpg-cluster-credentials.yaml.gotmpl"

  - name: conversations-cluster
    chart: ../common/charts/cluster
    {{- if .Values.application.conversations.namespace }}
    namespace: {{ .Values.application.conversations.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.conversations.enabled) | toYaml }}
    needs:
      - {{ if .Values.application.conversations.namespace }}{{ .Values.application.conversations.namespace }}/{{ end }}conversations-cluster-credentials
    values:
      - "values-cnpg-cluster.yaml.gotmpl"

  - name: conversations-valkey
    chart: ../common/charts/valkey
    {{- if .Values.application.conversations.namespace }}
    namespace: {{ .Values.application.conversations.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.conversations.enabled) | toYaml }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-valkey.yaml.gotmpl"
      - "values-valkey.yaml.gotmpl"

  - name: conversations-static
    chart: ../common/charts/nginx
    {{- if .Values.application.conversations.namespace }}
    namespace: {{ .Values.application.conversations.namespace }}
    {{- end }}
    installed: {{ .Values.application.conversations.enabled | toYaml }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-cluster-ingress.yaml.gotmpl"
      - "values-static-nginx.yaml.gotmpl"
