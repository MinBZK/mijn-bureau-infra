store:
  create: false   # ClusterSecretStore is rendered by the top-level openbao-store release

externalSecrets:
  - name: conversations-cluster-app
    target: conversations-cluster-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.conversations.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/conversations" .Environment.Name | quote }}
        property: database
  - name: conversations-cluster-superuser
    target: conversations-cluster-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/conversations" .Environment.Name | quote }}
        property: database_admin
  - name: conversations-valkey-auth
    target: conversations-valkey-auth
    data:
      - secretKey: default
        remoteKey: {{ printf "%s/conversations" .Environment.Name | quote }}
        property: password
  - name: conversations-minio
    target: conversations-minio
    staticData:
      root-user: "admin"
    data:
      - secretKey: root-password
        remoteKey: {{ printf "%s/minio" .Environment.Name | quote }}
        property: conversations

  - name: conversations
    target: conversations
    type: Opaque
    data:
      - secretKey: COLLABORATION_SERVER_SECRET
        remoteKey: {{ printf "%s/conversations" .Environment.Name | quote }}
        property: secretkey
      - secretKey: DJANGO_SECRET_KEY
        remoteKey: {{ printf "%s/conversations" .Environment.Name | quote }}
        property: secretkey
      - secretKey: DB_PASSWORD
        remoteKey: {{ printf "%s/conversations" .Environment.Name | quote }}
        property: database
      - secretKey: OIDC_RP_CLIENT_SECRET
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: conversations_client_secret
      - secretKey: OIDC_STORE_REFRESH_TOKEN_KEY
        remoteKey: {{ printf "%s/conversations" .Environment.Name | quote }}
        property: oidc-refresh-token-key
      - secretKey: AI_API_KEY
        remoteKey: {{ printf "%s/ai" .Environment.Name | quote }}
        property: llm_apiKey
      - secretKey: password
        remoteKey: {{ printf "%s/conversations" .Environment.Name | quote }}
        property: password
        hidden: true
    templateData:
      REDIS_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@conversations-valkey:6379/1"
      CELERY_BROKER_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@conversations-valkey:6379/0"
      CELERY_RESULT_BACKEND: "redis://default:{{ "{{" }} .password {{ "}}" }}@conversations-valkey:6379/0"
  - name: conversations-superuser
    target: conversations-superuser
    type: Opaque
    data:
      - secretKey: DJANGO_SUPERUSER_PASSWORD
        remoteKey: {{ printf "%s/conversations" .Environment.Name | quote }}
        property: adminPassword
    staticData:
      DJANGO_SUPERUSER_EMAIL: {{ .Values.secret.conversations.adminUser | quote }}

  - name: conversations-ocr-shim
    target: conversations-ocr-shim
    type: Opaque
    data:
      - secretKey: API_KEY
        remoteKey: {{ printf "%s/ai" .Environment.Name | quote }}
        property: ocr_apiKey
