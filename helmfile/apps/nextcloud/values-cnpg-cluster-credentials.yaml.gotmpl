name: nextcloud-cluster
owner: {{ .Values.database.nextcloud.user }}
password: {{ .Values.database.nextcloud.password }}
adminPassword: {{ .Values.database.nextcloud.adminpassword }}

# When the app is migrated to OpenBao-backed secrets, ESO provisions the
# `nextcloud-cluster-app` / `nextcloud-cluster-superuser` Secrets and this chart must not
# render its own.
external: {{ eq (dig "secrets" "backend" "derived" .Values) "external" }}
