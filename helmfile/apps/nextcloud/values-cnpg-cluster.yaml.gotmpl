fullnameOverride: nextcloud-cluster

type: postgresql

version:
  postgresql: "17"

mode: standalone

cluster:
  imageName: {{ printf "%s/%s:%s" .Values.container.cnpg_postgres.registry .Values.container.cnpg_postgres.repository .Values.container.cnpg_postgres.tag }}
  instances: 1

  enableSuperuserAccess: true
  superuserSecret: nextcloud-cluster-superuser

  {{- with (coalesce .Values.container.cnpg_postgres.imagePullSecret .Values.container.default.imagePullSecret) }}
  imagePullSecrets:
    - name: {{ . | quote }}
  {{- end }}

  storage:
    size: {{ coalesce .Values.pvc.nextcloud.postgresql.size .Values.pvc.default.size "8Gi" }}
    {{- with (coalesce .Values.pvc.nextcloud.postgresql.storageClass .Values.pvc.default.storageClass) }}
    storageClass: {{ . }}
    {{- end }}

  {{- with .Values.resource.nextcloud.postgresql }}
  resources: {{ toYaml . | nindent 4 }}
  {{- end }}

  monitoring:
    enabled: {{ .Values.metric.enabled | default false }}
    podMonitor:
      enabled: {{ .Values.metric.serviceMonitor.enabled | default false }}

  initdb:
    database: {{ .Values.database.nextcloud.name }}
    owner: {{ .Values.database.nextcloud.user }}
    secret:
      name: nextcloud-cluster-app

backups:
  # CloudNativePG object-store backups to the external store configured under
  # backup.cnpg (helmfile/environments/default/backup.yaml.gotmpl). Active only
  # when backup.enabled is true AND an endpoint is configured.
  enabled: {{ and .Values.backup.enabled (not (empty (dig "cnpg" "endpointURL" "" .Values.backup))) }}
  {{- if and .Values.backup.enabled (not (empty (dig "cnpg" "endpointURL" "" .Values.backup))) }}
  provider: s3
  endpointURL: {{ (dig "cnpg" "endpointURL" "" .Values.backup) | quote }}
  destinationPath: s3://{{ (dig "cnpg" "bucket" "" .Values.backup) }}/{{ (dig "cnpg" "pathPrefix" "postgresql" .Values.backup) }}/nextcloud
  s3:
    region: {{ (dig "cnpg" "region" "eu-west-1" .Values.backup) | quote }}
    bucket: {{ (dig "cnpg" "bucket" "" .Values.backup) | quote }}
    path: /{{ (dig "cnpg" "pathPrefix" "postgresql" .Values.backup) }}/nextcloud
    accessKey: {{ (dig "cnpg" "accessKey" "" .Values.backup) | quote }}
    secretKey: {{ (dig "cnpg" "secretKey" "" .Values.backup) | quote }}
  wal:
    compression: {{ (dig "cnpg" "walCompression" "gzip" .Values.backup) | quote }}
    encryption: {{ (dig "cnpg" "walEncryption" "AES256" .Values.backup) | quote }}
  data:
    compression: {{ (dig "cnpg" "dataCompression" "gzip" .Values.backup) | quote }}
    encryption: {{ (dig "cnpg" "dataEncryption" "AES256" .Values.backup) | quote }}
  retentionPolicy: {{ (dig "cnpg" "retentionPolicy" "30d" .Values.backup) | quote }}
  scheduledBackups:
    {{- toYaml (dig "cnpg" "scheduledBackups" (list (dict "name" "daily-backup" "schedule" "0 0 0 * * *" "backupOwnerReference" "self" "method" "barmanObjectStore")) .Values.backup) | nindent 4 }}
  {{- end }}
