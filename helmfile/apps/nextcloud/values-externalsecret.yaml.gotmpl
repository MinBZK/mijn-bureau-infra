store:
  create: false   # ClusterSecretStore is rendered by the top-level openbao-store release

externalSecrets:
  - name: nextcloud-cluster-app
    target: nextcloud-cluster-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.nextcloud.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/nextcloud" .Environment.Name | quote }}
        property: database
  - name: nextcloud-cluster-superuser
    target: nextcloud-cluster-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/nextcloud" .Environment.Name | quote }}
        property: database_admin
  - name: nextcloud-valkey-auth
    target: nextcloud-valkey-auth
    data:
      - secretKey: default
        remoteKey: {{ printf "%s/nextcloud" .Environment.Name | quote }}
        property: password
  - name: nextcloud-seaweedfs
    target: nextcloud-seaweedfs
    staticData:
      access-key: "admin"
    data:
      - secretKey: secret-key
        remoteKey: {{ printf "%s/seaweedfs" .Environment.Name | quote }}
        property: nextcloud
