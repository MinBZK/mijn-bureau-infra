store:
  create: false   # ClusterSecretStore is rendered by the top-level openbao-store release

externalSecrets:
  - name: meet-cluster-app
    target: meet-cluster-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.meet.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/meet" .Environment.Name | quote }}
        property: database
  - name: meet-cluster-superuser
    target: meet-cluster-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/meet" .Environment.Name | quote }}
        property: database_admin
  - name: meet-valkey-auth
    target: meet-valkey-auth
    data:
      - secretKey: default
        remoteKey: {{ printf "%s/meet" .Environment.Name | quote }}
        property: password
  - name: meet-minio
    target: meet-minio
    staticData:
      root-user: "admin"
    data:
      - secretKey: root-password
        remoteKey: {{ printf "%s/minio" .Environment.Name | quote }}
        property: meet

  - name: meet
    target: meet
    type: Opaque
    data:
      - secretKey: DJANGO_SECRET_KEY
        remoteKey: {{ printf "%s/meet" .Environment.Name | quote }}
        property: secretkey
      - secretKey: DB_PASSWORD
        remoteKey: {{ printf "%s/meet" .Environment.Name | quote }}
        property: database
      - secretKey: OIDC_RP_CLIENT_SECRET
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: meet_client_secret
      - secretKey: LIVEKIT_API_SECRET
        remoteKey: {{ printf "%s/livekit" .Environment.Name | quote }}
        property: meet_apiSecret
      - secretKey: SUMMARY_SERVICE_API_TOKEN
        remoteKey: {{ printf "%s/meet" .Environment.Name | quote }}
        property: summaryApiToken
      - secretKey: DJANGO_EMAIL_HOST_PASSWORD
        remoteKey: {{ printf "%s/smtp" .Environment.Name | quote }}
        property: password
      - secretKey: password
        remoteKey: {{ printf "%s/meet" .Environment.Name | quote }}
        property: password
        hidden: true
    templateData:
      REDIS_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@meet-valkey:6379/1"
      CELERY_BROKER_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@meet-valkey:6379/0"
  - name: meet-superuser
    target: meet-superuser
    type: Opaque
    data:
      - secretKey: DJANGO_SUPERUSER_PASSWORD
        remoteKey: {{ printf "%s/meet" .Environment.Name | quote }}
        property: adminPassword
    staticData:
      DJANGO_SUPERUSER_EMAIL: {{ .Values.secret.meet.adminUser | quote }}
