bases:
  - "../../bases/default.yaml.gotmpl"

releases:
  - name: meet
    chart: charts/meet
    condition: application.meet.enabled
    {{- if .Values.application.meet.namespace }}
    namespace: {{ .Values.application.meet.namespace }}
    {{- end }}
    {{- if .Values.application.meet.enabled }}
    needs:
      # meet-static creates the `meet-static-files` ConfigMap that meet's
      # inject-bureaublad-button initContainer mounts. Without this needs,
      # a fresh install applies meet first and its frontend pod hangs in
      # ContainerCreating until meet-static catches up.
      - {{ if .Values.application.meet.namespace }}{{ .Values.application.meet.namespace }}/{{ end }}meet-static
      {{- if eq .Environment.Name "demo" }}
      - {{ if .Values.application.meet.namespace }}{{ .Values.application.meet.namespace }}/{{ end }}meet-cluster
      - {{ if .Values.application.meet.namespace }}{{ .Values.application.meet.namespace }}/{{ end }}meet-valkey
      - {{ if .Values.application.meet.namespace }}{{ .Values.application.meet.namespace }}/{{ end }}meet-minio
      {{- end }}
    {{- end }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-cluster-ingress.yaml.gotmpl"
      - "values.yaml.gotmpl"

  - name: meet-cluster-credentials
    chart: ../common/charts/cnpg-cluster-credentials
    {{- if .Values.application.meet.namespace }}
    namespace: {{ .Values.application.meet.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.meet.enabled) | toYaml }}
    values:
      - "values-cnpg-cluster-credentials.yaml.gotmpl"

  - name: meet-cluster
    chart: ../common/charts/cluster
    {{- if .Values.application.meet.namespace }}
    namespace: {{ .Values.application.meet.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.meet.enabled) | toYaml }}
    needs:
      - {{ if .Values.application.meet.namespace }}{{ .Values.application.meet.namespace }}/{{ end }}meet-cluster-credentials
    values:
      - "values-cnpg-cluster.yaml.gotmpl"

  - name: meet-valkey
    chart: ../common/charts/valkey
    {{- if .Values.application.meet.namespace }}
    namespace: {{ .Values.application.meet.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.meet.enabled) | toYaml }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-valkey.yaml.gotmpl"
      - "values-valkey.yaml.gotmpl"

  - name: meet-minio
    chart: ../common/charts/minio
    version: "17.0.11"
    {{- if .Values.application.meet.namespace }}
    namespace: {{ .Values.application.meet.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.meet.enabled) | toYaml }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-cluster-ingress.yaml.gotmpl"
      - "values-minio.yaml.gotmpl"

  - name: meet-static
    chart: ../common/charts/nginx
    {{- if .Values.application.meet.namespace }}
    namespace: {{ .Values.application.meet.namespace }}
    {{- end }}
    installed: {{ .Values.application.meet.enabled | toYaml }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-cluster-ingress.yaml.gotmpl"
      - "values-static-nginx.yaml.gotmpl"
