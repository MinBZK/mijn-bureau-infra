name: meet-cluster
owner: {{ .Values.database.meet.user }}
password: {{ .Values.database.meet.password }}
adminPassword: {{ .Values.database.meet.adminpassword }}

# When the app is migrated to OpenBao-backed secrets, ESO provisions the
# `meet-cluster-app` / `meet-cluster-superuser` Secrets and this chart must not
# render its own.
external: {{ eq (dig "secrets" "backend" "derived" .Values) "external" }}
