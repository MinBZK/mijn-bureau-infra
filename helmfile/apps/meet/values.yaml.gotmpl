{{- $meetHostname := printf "%s.%s" .Values.global.hostname.meet .Values.global.domain -}}
{{- $meetScheme := ternary "https" "http" (.Values.global.tls.enabled | default true) -}}
{{- $meetBaseUrl := printf "%s://%s" $meetScheme $meetHostname -}}
{{- $summaryRedisUrl := printf "redis://default:%s@%s:%v/2" .Values.cache.meet.password .Values.cache.meet.host .Values.cache.meet.port -}}
{{- $meetS3Endpoint := dig "objectstore" "meet" "endpoint" "" .Values -}}
{{- $meetS3Port := dig "objectstore" "meet" "port" 9000 .Values -}}
{{- $meetS3Ssl := dig "objectstore" "meet" "useSSL" false .Values -}}
{{- $meetS3HostPort := "" -}}
{{- $meetS3Url := "" -}}
{{- if $meetS3Endpoint -}}
{{- $meetS3HostPort = printf "%s:%v" $meetS3Endpoint $meetS3Port -}}
{{- $meetS3Url = printf "http%s://%s:%v" (ternary "s" "" (eq (toString $meetS3Ssl) "true")) $meetS3Endpoint $meetS3Port -}}
{{- end -}}
{{- $livekitKey := .Values.livekit.meet.apiKey | default "" -}}
{{- $livekitSecret := .Values.livekit.meet.apiSecret | default "" -}}
{{- $livekitUrl := .Values.livekit.meet.apiURL | default "" -}}
{{- if .Values.application.livekit.enabled -}}
{{- $keyName := .Values.application.livekit.keys | keys | first -}}
{{- $livekitKey = $keyName -}}
{{- $livekitSecret = index .Values.application.livekit.keys $keyName -}}
{{- if and .Values.livekit.meet.apiKey .Values.livekit.meet.apiSecret -}}
{{- $livekitKey = .Values.livekit.meet.apiKey -}}
{{- $livekitSecret = .Values.livekit.meet.apiSecret -}}
{{- else if .Values.livekit.meet.apiSecret -}}
{{- $livekitSecret = .Values.livekit.meet.apiSecret -}}
{{- end -}}
{{- $livekitUrl = coalesce .Values.livekit.meet.apiURL (printf "https://%s.%s" .Values.global.hostname.livekit .Values.global.domain) -}}
{{- end -}}
{{- $summaryApiToken := .Values.secret.meet.summaryApiToken | default .Values.application.meet.secretKey -}}
{{- $summaryWebhookApiToken := .Values.secret.meet.summaryWebhookApiToken | default .Values.application.meet.secretKey -}}
{{- $summaryEnabled := dig "application" "meet" "summary" "enabled" true .Values -}}
{{- $whisperx := .Values.ai.whisperx | default dict -}}
{{- $llmReady := and (not (empty .Values.ai.llm.endpoint.host)) (not (empty .Values.ai.llm.model)) -}}
{{- $whisperxReady := not (empty $whisperx.baseUrl) -}}
{{- $summaryEnv := dict
  "APP_NAME" "summary-microservice"
  "AWS_S3_ENDPOINT_URL" $meetS3Url
  "AWS_S3_SECURE_ACCESS" (ternary "True" "False" (eq (toString $meetS3Ssl) "true"))
  "AWS_S3_REGION_NAME" (dig "objectstore" "meet" "region" "eu-west-1" .Values)
  "AWS_S3_ACCESS_KEY_ID" (dig "objectstore" "meet" "username" "" .Values)
  "AWS_S3_SECRET_ACCESS_KEY" (dig "objectstore" "meet" "rootPassword" "" .Values)
  "AWS_STORAGE_BUCKET_NAME" (dig "objectstore" "meet" "bucket" "" .Values)
  "CELERY_BROKER_URL" $summaryRedisUrl
  "CELERY_RESULT_BACKEND" $summaryRedisUrl
  "TASK_TRACKER_REDIS_URL" $summaryRedisUrl
  "IS_DOCS_INTEGRATION_ENABLED" "True"
  "IS_LASUITE_DOCS_INTEGRATION_ENABLED" "True"
  "LASUITE_DOCS_BASE_URL" (printf "https://%s.%s" .Values.global.hostname.docs .Values.global.domain)
  "LASUITE_DOCS_SERVER_TO_SERVER_API_KEY" (dig "application" "docs" "serverToServerApiToken" "secret-api-key" .Values)
  "IS_SUMMARY_ENABLED" "True"
  "LLM_API_KEY" ""
  "LLM_BASE_URL" ""
  "LLM_MODEL" ""
  "POSTHOG_ENABLED" "False"
  "WHISPERX_API_KEY" ($whisperx.apiKey | default "")
  "WHISPERX_DEFAULT_LANGUAGE" ($whisperx.defaultLanguage | default .Values.global.defaultLocale | default "en")
-}}
{{- with $whisperx.baseUrl -}}
{{- $_ := set $summaryEnv "WHISPERX_BASE_URL" . -}}
{{- end -}}
{{- with $whisperx.asrModel -}}
{{- $_ := set $summaryEnv "WHISPERX_ASR_MODEL" . -}}
{{- end -}}
{{- $summaryTenant := dict
  "id" "meet"
  "api_key" $summaryApiToken
  "webhook_url" (printf "%s/api/v1.0/recordings/external-process-hook/" $meetBaseUrl)
  "webhook_api_key" $summaryWebhookApiToken
  "allowed_push_to_docs" true
-}}
{{- $_ := set $summaryEnv "AUTHORIZED_TENANTS" (list $summaryTenant | toJson) -}}
{{- $llmHost := .Values.ai.llm.endpoint.host | default "" -}}
{{- if $llmHost -}}
{{- $llmSsl := true -}}
{{- if hasKey .Values.ai.llm.endpoint "isSsl" -}}
{{- $llmSsl = .Values.ai.llm.endpoint.isSsl -}}
{{- end -}}
{{- $llmScheme := ternary "https" "http" $llmSsl -}}
{{- $llmPort := .Values.ai.llm.endpoint.port | default 0 | int -}}
{{- $llmPath := .Values.ai.llm.endpoint.path | default "v1" -}}
{{- $llmBaseUrl := printf "%s://%s" $llmScheme $llmHost -}}
{{- if gt $llmPort 0 -}}
{{- $llmBaseUrl = printf "%s:%d" $llmBaseUrl $llmPort -}}
{{- end -}}
{{- $llmBaseUrl = printf "%s/%s" $llmBaseUrl $llmPath -}}
{{- $_ := set $summaryEnv "LLM_BASE_URL" $llmBaseUrl -}}
{{- $_ := set $summaryEnv "LLM_API_KEY" (.Values.ai.llm.apiKey | default "") -}}
{{- $_ := set $summaryEnv "LLM_MODEL" .Values.ai.llm.model -}}
{{- end -}}
{{- $userSummaryEnv := dig "application" "meet" "summary" "envVars" dict .Values -}}
{{- $summaryEnv = mergeOverwrite $summaryEnv $userSummaryEnv -}}
{{- $agentEnv := dict
  "LIVEKIT_URL" $livekitUrl
  "LIVEKIT_API_KEY" $livekitKey
  "LIVEKIT_API_SECRET" $livekitSecret
  "AWS_S3_ENDPOINT_URL" $meetS3HostPort
  "AWS_S3_SECURE_ACCESS" (ternary "True" "False" (eq (toString $meetS3Ssl) "true"))
  "AWS_S3_REGION_NAME" (dig "objectstore" "meet" "region" "eu-west-1" .Values)
  "AWS_S3_ACCESS_KEY_ID" (dig "objectstore" "meet" "username" "" .Values)
  "AWS_S3_SECRET_ACCESS_KEY" (dig "objectstore" "meet" "rootPassword" "" .Values)
  "AWS_STORAGE_BUCKET_NAME" (dig "objectstore" "meet" "bucket" "" .Values)
-}}
{{- $stt := .Values.ai.stt | default dict -}}
{{- $sttProvider := $stt.provider | default "deepgram" -}}
{{- $_ := set $agentEnv "STT_PROVIDER" $sttProvider -}}
{{- if eq $sttProvider "deepgram" -}}
{{- $deepgram := $stt.deepgram | default dict -}}
{{- $_ := set $agentEnv "DEEPGRAM_API_KEY" ($deepgram.apiKey | default "") -}}
{{- $_ := set $agentEnv "DEEPGRAM_STT_MODEL" ($deepgram.model | default "nova-3") -}}
{{- $_ := set $agentEnv "DEEPGRAM_STT_LANGUAGE" ($deepgram.language | default "multi") -}}
{{- else if eq $sttProvider "kyutai" -}}
{{- $kyutai := $stt.kyutai | default dict -}}
{{- $_ := set $agentEnv "KYUTAI_STT_BASE_URL" ($kyutai.baseUrl | default "") -}}
{{- $_ := set $agentEnv "KYUTAI_API_KEY" ($kyutai.apiKey | default "") -}}
{{- else if eq $sttProvider "voxtral-vllm" -}}
{{- $voxtral := $stt.voxtral | default dict -}}
{{- $_ := set $agentEnv "VOXTRAL_VLLM_BASE_URL" ($voxtral.baseUrl | default "") -}}
{{- $_ := set $agentEnv "VOXTRAL_VLLM_API_KEY" ($voxtral.apiKey | default "") -}}
{{- $_ := set $agentEnv "VOXTRAL_VLLM_MODEL" ($voxtral.model | default "voxtral-mini-4b-realtime-2602") -}}
{{- $_ := set $agentEnv "VOXTRAL_VLLM_TARGET_STREAMING_DELAY_MS" (toString ($voxtral.targetStreamingDelayMs | default 480)) -}}
{{- end -}}
{{- $userAgentEnv := dig "application" "meet" "agents" "envVars" dict .Values -}}
{{- $agentEnv = mergeOverwrite $agentEnv $userAgentEnv -}}
{{- $metadataEnv := mergeOverwrite (dict "ENABLE_SILERO_VAD" "false" "AWS_S3_OUTPUT_FOLDER" "metadata") (deepCopy $agentEnv) -}}

global:
  ## Global Docker image parameters
  ## Please, note that this will override the image parameters, including dependencies, configured to use the global value
  ## @param global.imageRegistry Global Docker Image registry
  ## @param global.imagePullSecrets Global Docker registry secret names as an array
  ##
  imageRegistry: {{(coalesce .Values.container.meet_frontend.registry .Values.container.default.registry) | quote }}
  {{- with (coalesce .Values.container.meet_frontend.imagePullSecret .Values.container.default.imagePullSecret) }}
  imagePullSecrets:
    - name: {{ . | quote }}
  {{- end }}
  ## @param global.defaultStorageClass Global default StorageClass for Persistent Volume(s)
  ##
  defaultStorageClass: {{ .Values.pvc.default.storageClass | quote }}


clusterDomain: {{ .Values.cluster.networking.domain | default "cluster.local" | quote }}

meet:
  image:
    registry: {{(coalesce .Values.container.meet_frontend.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.meet_frontend.repository | quote }}
    tag: {{ .Values.container.meet_frontend.tag | quote }}

  resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.meet.frontend .Values.global.resourcesPreset | quote }}
  resources: {{ .Values.resource.meet.meetBackend | toYaml | nindent 4 }}
  podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext:  {{ .Values.security.default.containerSecurityContext | toYaml | nindent 4 }}
  autoscaling:
    hpa: {{ .Values.autoscaling.horizontal.meet.frontend | toYaml | nindent 6 }}
  pdb: {{ .Values.pdb.meet.frontend | toYaml | nindent 4 }}

  runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}

  frontendCssUrl: "https://static-{{ .Values.global.hostname.meet }}.{{ .Values.global.domain }}/iframe-hide.css"
  frontendExternalHomeUrl: "https://{{ .Values.global.hostname.bureaublad }}.{{ .Values.global.domain }}"
  frontendTranscriptionDestination: "https://{{ .Values.global.hostname.docs }}.{{ .Values.global.domain }}"

  # Init containers don't inherit resourcesPreset from the chart, so we mirror
  # Bitnami's common.resources.preset values and select by .Values.global.resourcesPreset.
  # Keep in sync with helmfile/apps/common/charts/common/templates/_resources.tpl.
  {{ $preset := .Values.global.resourcesPreset | default "small" }}
  {{ $cpuReq := "500m" }}{{ $memReq := "512Mi" }}{{ $cpuLim := "750m" }}{{ $memLim := "768Mi" }}
  {{ if eq $preset "nano"    }}{{ $cpuReq = "100m" }}{{ $memReq = "128Mi"  }}{{ $cpuLim = "150m" }}{{ $memLim = "192Mi"   }}{{ end }}
  {{ if eq $preset "micro"   }}{{ $cpuReq = "250m" }}{{ $memReq = "256Mi"  }}{{ $cpuLim = "375m" }}{{ $memLim = "384Mi"   }}{{ end }}
  {{ if eq $preset "medium"  }}{{ $cpuReq = "500m" }}{{ $memReq = "1024Mi" }}{{ $cpuLim = "750m" }}{{ $memLim = "1536Mi"  }}{{ end }}
  {{ if eq $preset "large"   }}{{ $cpuReq = "1.0"  }}{{ $memReq = "2048Mi" }}{{ $cpuLim = "1.5"  }}{{ $memLim = "3072Mi"  }}{{ end }}
  {{ if eq $preset "xlarge"  }}{{ $cpuReq = "1.0"  }}{{ $memReq = "3072Mi" }}{{ $cpuLim = "3.0"  }}{{ $memLim = "6144Mi"  }}{{ end }}
  {{ if eq $preset "2xlarge" }}{{ $cpuReq = "1.0"  }}{{ $memReq = "3072Mi" }}{{ $cpuLim = "6.0"  }}{{ $memLim = "12288Mi" }}{{ end }}
  initContainers:
    - name: inject-bureaublad-button
      image: {{ printf "%s/%s:%s" (coalesce .Values.container.meet_frontend.registry .Values.container.default.registry) .Values.container.meet_frontend.repository .Values.container.meet_frontend.tag | quote }}
      imagePullPolicy: Always
      resources:
        requests:
          cpu: {{ $cpuReq | quote }}
          memory: {{ $memReq | quote }}
          ephemeral-storage: "50Mi"
        limits:
          cpu: {{ $cpuLim | quote }}
          memory: {{ $memLim | quote }}
          ephemeral-storage: "2Gi"
      command:
        - /bin/sh
        - -c
        - |
          set -eu
          cp -r /usr/share/nginx/html/. /work/
          find /work -type f -name '*.html' | while IFS= read -r f; do
            awk '{
              i = index($0, "</body>")
              if (i > 0) {
                printf "%s<script>", substr($0, 1, i - 1)
                while ((getline line < "/injection/bureaublad-button.js") > 0) print line
                close("/injection/bureaublad-button.js")
                printf "</script>%s\n", substr($0, i)
              } else {
                print
              }
            }' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
          done
      volumeMounts:
        - name: app-patched
          mountPath: /work
        - name: bureaublad-button-js
          mountPath: /injection
          readOnly: true
  extraVolumes:
    - name: app-patched
      emptyDir: {}
    - name: bureaublad-button-js
      configMap:
        name: meet-static-files
        items:
          - key: bureaublad-button.js
            path: bureaublad-button.js
  extraVolumeMounts:
    - name: app-patched
      mountPath: /usr/share/nginx/html

meet_backend:
  image:
    registry: {{(coalesce .Values.container.meet_backend.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.meet_backend.repository | quote }}
    tag: {{ .Values.container.meet_backend.tag | quote }}

  # The backend needs the S3 credentials from the meet secret for presigned
  # uploads (backgrounds, recordings); the chart does not reference them itself.
  extraEnvVarsSecret: meet

  resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.meet.backend .Values.global.resourcesPreset | quote }}
  resources: {{ .Values.resource.meet.meetFrontend | toYaml | nindent 4 }}
  podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext:  {{ .Values.security.default.containerSecurityContext | toYaml | nindent 4 }}
  autoscaling:
    hpa: {{ .Values.autoscaling.horizontal.meet.backend | toYaml | nindent 6 }}
  pdb: {{ .Values.pdb.meet.backend | toYaml | nindent 4 }}

  runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}

  secretKey: {{ .Values.application.meet.secretKey | quote }}
  email:
    host: {{ .Values.smtp.host | quote }}
    port: {{ .Values.smtp.port | quote }}
    hostUser: {{ .Values.smtp.username | quote }}
    hostPassword: {{ .Values.smtp.password | quote }}
    useTls: {{ .Values.smtp.tls.enabled | default true | quote }}
    useSsl: "false"
    from: {{ .Values.smtp.from.email | quote }}
    brandName: {{ .Values.smtp.from.name | quote }}
    logoImg: {{ .Values.smtp.from.logoImage | quote }}
  recordingEnable: {{ and .Values.application.livekit.enabled .Values.application.livekit.egress.enabled | toYaml }}
  recordingDownloadBaseUrl: "https://{{ .Values.global.hostname.meet }}.{{ .Values.global.domain }}/recording"
  {{- if $summaryEnabled }}
  summaryServiceApiToken: {{ $summaryApiToken | quote }}
  {{- end }}

  {{- if eq .Values.global.defaultLocale "nl" }}
  languageCode: nl-nl
  {{- end }}
  CSRFTrustedOrigins: "https://{{ .Values.global.hostname.meet }}.{{ .Values.global.domain }},http://{{ .Values.global.hostname.meet }}.{{ .Values.global.domain }}"
  CORSAllowedOrigins: "https://{{ .Values.global.hostname.meet }}.{{ .Values.global.domain }},http://{{ .Values.global.hostname.meet }}.{{ .Values.global.domain }}"
  AllowedHosts: "{{ .Values.global.hostname.meet }}.{{ .Values.global.domain }}"

  superuserEmail: {{  .Values.secret.meet.adminUser | quote }}
  superuserPassword: {{  .Values.secret.meet.adminPassword | quote }}

ingress:
  ## @param ingress.enabled Enable ingress record generation for meet
  ##
  enabled: true
  hostname: {{ .Values.global.hostname.meet }}.{{ .Values.global.domain }}
  tls: {{ .Values.global.tls.enabled | default true }}
  selfSigned: {{ and .Values.global.tls.enabled .Values.global.tls.selfSigned | default false }}
  extraTls: {{ .Values.tls.meet | toYaml | nindent 4 }}
  ingressClassName: {{ .Values.cluster.ingress.className | quote }}
  annotations:
    {{- if .Values.cluster.ingress.annotations }}
    {{ .Values.cluster.ingress.annotations | toYaml | nindent 4 }}
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "nginx" }}
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    nginx.ingress.kubernetes.io/configuration-snippet: |
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "haproxy-openshift" }}
    haproxy.router.openshift.io/hsts_header: max-age=31536000;includeSubDomains;preload
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "traefik" }}
    traefik.ingress.kubernetes.io/router.middlewares: '{{ .Release.Namespace }}-hsts-header@kubernetescrd'
    {{- end }}
externalLivekit:
  {{- if .Values.application.livekit.enabled }}
  apiKey: {{ $livekitKey | quote }}
  apiSecret: {{ $livekitSecret | quote }}
  apiUrl: {{ $livekitUrl | quote }}
  {{- else }}
  apiKey: {{ .Values.livekit.meet.apiKey | quote }}
  apiSecret: {{ .Values.livekit.meet.apiSecret | quote }}
  apiUrl: {{ .Values.livekit.meet.apiURL | quote }}
  {{- end }}

externalRedis:
  host: {{ .Values.cache.meet.host | quote }}
  port: {{ .Values.cache.meet.port | quote }}
  password: {{ .Values.cache.meet.password | quote }}

externalMinio:
  # This endpoint is also used in-cluster from other namespaces (livekit-egress
  # uploads recordings), so expand internal minio names to the cluster FQDN.
  endpoint: {{ if (dig "objectstore" "meet" "isInternal" false .Values) }}{{ printf "%s.%s.svc.%s" .Values.objectstore.meet.endpoint (.Values.application.meet.namespace | default "default") (.Values.cluster.networking.domain | default "cluster.local") | quote }}{{ else }}{{ .Values.objectstore.meet.endpoint | quote }}{{ end }}
  port: {{ .Values.objectstore.meet.port | quote }}
  accessKey: {{ .Values.objectstore.meet.username | quote }}
  secretKey: {{ .Values.objectstore.meet.rootPassword | quote }}
  bucket: {{ .Values.objectstore.meet.bucket | quote }}
  useSSL: {{ .Values.objectstore.meet.useSSL | quote }}
  publicUrl: "https://{{ index .Values.global.hostname "meet-minio" }}.{{ .Values.global.domain }}"
  region: {{ .Values.objectstore.meet.region | default "eu-west-1" | quote }}

externalDatabase:
  database: {{ .Values.database.meet.name | quote }}
  username: {{ .Values.database.meet.user | quote }}
  host: {{ .Values.database.meet.host | quote }}
  password: {{ .Values.database.meet.password | quote }}
  port: {{ .Values.database.meet.port | quote }}
  type: {{ .Values.database.meet.type | quote }}
  logging: true


authentication:
  issuer: {{ .Values.authentication.oidc.issuer | quote }}
  authorization_endpoint: {{ .Values.authentication.oidc.authorization_endpoint | quote }}
  token_endpoint: {{ .Values.authentication.oidc.token_endpoint | quote }}
  introspection_endpoint: {{ .Values.authentication.oidc.introspection_endpoint | quote }}
  userinfo_endpoint: {{ .Values.authentication.oidc.userinfo_endpoint | quote }}
  end_session_endpoint: {{ .Values.authentication.oidc.end_session_endpoint | quote }}
  jwks_uri: {{ .Values.authentication.oidc.jwks_uri | quote }}
  claims:
    username: {{ .Values.authentication.oidc.claims.username | quote }}
    display_name: {{ .Values.authentication.oidc.claims.display_name | quote }}
    given_name: {{ .Values.authentication.oidc.claims.given_name | quote }}
    family_name: {{ .Values.authentication.oidc.claims.family_name | quote }}

  client:
    client_id: {{ .Values.authentication.client.meet.client_id | quote }}
    client_secret: {{ .Values.authentication.client.meet.client_secret | quote }}

{{- if ne .Values.global.resourcesPreset "none" }}
job:
  resources:
    requests:
      memory: 256Mi
      cpu: 100m
    limits:
      memory: 512Mi
      cpu: 200m
{{- end }}

{{ $agentsEnabled := dig "application" "meet" "agents" "enabled" true .Values -}}
{{ $subtitlesAgentEnabled := dig "application" "meet" "agents" "subtitles" "enabled" false .Values -}}
{{ $celeryBackendEnabled := dig "application" "meet" "celeryBackend" "enabled" true .Values -}}

agent_metadata:
  enabled: {{ $agentsEnabled }}
  image:
    registry: {{ (coalesce .Values.container.meet_agents.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.meet_agents.repository | quote }}
    tag: {{ .Values.container.meet_agents.tag | default .Values.container.meet_backend.tag | quote }}
    {{- with (coalesce .Values.container.meet_agents.imagePullSecret .Values.container.default.imagePullSecret) }}
    pullSecrets:
      - name: {{ . | quote }}
    {{- end }}
  resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.meet.agents .Values.global.resourcesPreset | quote }}
  resources: {{ .Values.resource.meet.agents | default dict | toYaml | nindent 4 }}
  podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext: {{ .Values.security.default.containerSecurityContext | toYaml | nindent 4 }}
  runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}
  envVars:
    {{- $metadataEnv | toYaml | nindent 4 }}

agent_subtitles:
  enabled: {{ and $agentsEnabled $subtitlesAgentEnabled }}
  image:
    registry: {{ (coalesce .Values.container.meet_agents.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.meet_agents.repository | quote }}
    tag: {{ .Values.container.meet_agents.tag | default .Values.container.meet_backend.tag | quote }}
    {{- with (coalesce .Values.container.meet_agents.imagePullSecret .Values.container.default.imagePullSecret) }}
    pullSecrets:
      - name: {{ . | quote }}
    {{- end }}
  resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.meet.agents .Values.global.resourcesPreset | quote }}
  resources: {{ .Values.resource.meet.agents | default dict | toYaml | nindent 4 }}
  podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext: {{ .Values.security.default.containerSecurityContext | toYaml | nindent 4 }}
  runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}
  envVars:
    {{- $agentEnv | toYaml | nindent 4 }}

celery_backend:
  enabled: {{ $celeryBackendEnabled }}
  image:
    registry: {{ (coalesce .Values.container.meet_backend.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.meet_backend.repository | quote }}
    tag: {{ .Values.container.meet_backend.tag | quote }}
    {{- with (coalesce .Values.container.meet_backend.imagePullSecret .Values.container.default.imagePullSecret) }}
    pullSecrets:
      - name: {{ . | quote }}
    {{- end }}
  # Same Django app: needs the S3 credentials from the meet secret.
  extraEnvVarsSecret: meet
  resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.meet.celeryBackend .Values.global.resourcesPreset | quote }}
  resources: {{ .Values.resource.meet.celeryBackend | default dict | toYaml | nindent 4 }}
  podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext: {{ .Values.security.default.containerSecurityContext | toYaml | nindent 4 }}
  runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}

celery_summarize:
  enabled: {{ and $summaryEnabled $llmReady }}
  image:
    registry: {{ (coalesce .Values.container.meet_summary.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.meet_summary.repository | quote }}
    tag: {{ .Values.container.meet_summary.tag | default .Values.container.meet_backend.tag | quote }}
    {{- with (coalesce .Values.container.meet_summary.imagePullSecret .Values.container.default.imagePullSecret) }}
    pullSecrets:
      - name: {{ . | quote }}
    {{- end }}
  resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.meet.summary .Values.global.resourcesPreset | quote }}
  resources: {{ .Values.resource.meet.summary | default dict | toYaml | nindent 4 }}
  podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext: {{ .Values.security.default.containerSecurityContext | toYaml | nindent 4 }}
  runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}
  envVars:
    {{- $summaryEnv | toYaml | nindent 4 }}

celery_transcribe:
  enabled: {{ and $summaryEnabled $whisperxReady }}
  image:
    registry: {{ (coalesce .Values.container.meet_summary.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.meet_summary.repository | quote }}
    tag: {{ .Values.container.meet_summary.tag | default .Values.container.meet_backend.tag | quote }}
    {{- with (coalesce .Values.container.meet_summary.imagePullSecret .Values.container.default.imagePullSecret) }}
    pullSecrets:
      - name: {{ . | quote }}
    {{- end }}
  resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.meet.summary .Values.global.resourcesPreset | quote }}
  resources: {{ .Values.resource.meet.summary | default dict | toYaml | nindent 4 }}
  podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext: {{ .Values.security.default.containerSecurityContext | toYaml | nindent 4 }}
  runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}
  envVars:
    {{- $summaryEnv | toYaml | nindent 4 }}

summary_api:
  enabled: {{ and $summaryEnabled (or $llmReady $whisperxReady) }}
  image:
    registry: {{ (coalesce .Values.container.meet_summary.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.meet_summary.repository | quote }}
    tag: {{ .Values.container.meet_summary.tag | default .Values.container.meet_backend.tag | quote }}
    {{- with (coalesce .Values.container.meet_summary.imagePullSecret .Values.container.default.imagePullSecret) }}
    pullSecrets:
      - name: {{ . | quote }}
    {{- end }}
  resourcesPreset: {{ coalesce .Values.global.resourcesPresetPerApp.meet.summary .Values.global.resourcesPreset | quote }}
  resources: {{ .Values.resource.meet.summary | default dict | toYaml | nindent 4 }}
  podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext: {{ .Values.security.default.containerSecurityContext | toYaml | nindent 4 }}
  runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}
  envVars:
    {{- $summaryEnv | toYaml | nindent 4 }}
