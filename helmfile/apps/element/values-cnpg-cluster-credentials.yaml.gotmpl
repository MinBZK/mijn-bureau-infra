name: element-cluster
owner: {{ .Values.database.synapse.user }}
password: {{ .Values.database.synapse.password }}
adminPassword: {{ .Values.database.synapse.adminpassword }}

# When the app is migrated to OpenBao-backed secrets, ESO provisions the
# `element-cluster-app` / `element-cluster-superuser` Secrets and this chart must not
# render its own.
external: {{ eq (dig "secrets" "backend" "derived" .Values) "external" }}
