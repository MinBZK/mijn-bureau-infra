name: element-cluster-mas
owner: {{ .Values.database.mas.user }}
password: {{ .Values.database.mas.password }}
adminPassword: {{ .Values.database.mas.adminpassword }}

# When the app is migrated to OpenBao-backed secrets, ESO provisions the
# `element-cluster-mas-app` / `element-cluster-mas-superuser` Secrets and this chart must not
# render its own.
external: {{ eq (dig "secrets" "backend" "derived" .Values) "external" }}
