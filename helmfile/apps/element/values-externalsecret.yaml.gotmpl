store:
  create: false   # ClusterSecretStore is rendered by the top-level openbao-store release

externalSecrets:
  - name: element-cluster-app
    target: element-cluster-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.synapse.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/synapse" .Environment.Name | quote }}
        property: database
  - name: element-cluster-superuser
    target: element-cluster-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/synapse" .Environment.Name | quote }}
        property: database_admin
  - name: element-cluster-mas-app
    target: element-cluster-mas-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.mas.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/mas" .Environment.Name | quote }}
        property: database
  - name: element-cluster-mas-superuser
    target: element-cluster-mas-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/mas" .Environment.Name | quote }}
        property: database_admin
  - name: element-valkey-auth
    target: element-valkey-auth
    data:
      - secretKey: default
        remoteKey: {{ printf "%s/synapse" .Environment.Name | quote }}
        property: password

  # --- lk-jwt-service (LiveKit JWT minting for Element Call) ---
  - name: lk-jwt-service
    target: lk-jwt-service
    type: Opaque
    staticData:
      LIVEKIT_KEY: "elementcall"
    data:
      - secretKey: LIVEKIT_SECRET
        remoteKey: {{ printf "%s/livekit" .Environment.Name | quote }}
        property: elementcall
      - secretKey: LIVEKIT_AS_TOKEN
        remoteKey: {{ printf "%s/lkjwt" .Environment.Name | quote }}
        property: asToken
      - secretKey: LIVEKIT_HS_TOKEN
        remoteKey: {{ printf "%s/lkjwt" .Environment.Name | quote }}
        property: hsToken

  # --- synapse (application-service registration + secrets config) ---
  - name: synapse
    target: synapse
    type: Opaque
    data:
      - secretKey: as_token
        remoteKey: {{ printf "%s/lkjwt" .Environment.Name | quote }}
        property: asToken
        hidden: true
      - secretKey: hs_token
        remoteKey: {{ printf "%s/lkjwt" .Environment.Name | quote }}
        property: hsToken
        hidden: true
      - secretKey: dbpassword
        remoteKey: {{ printf "%s/synapse" .Environment.Name | quote }}
        property: database
        hidden: true
      - secretKey: redispassword
        remoteKey: {{ printf "%s/synapse" .Environment.Name | quote }}
        property: password
        hidden: true
      - secretKey: smtppass
        remoteKey: {{ printf "%s/smtp" .Environment.Name | quote }}
        property: password
        hidden: true
      - secretKey: registration
        remoteKey: {{ printf "%s/synapse" .Environment.Name | quote }}
        property: registrationSharedSecret
        hidden: true
      - secretKey: form
        remoteKey: {{ printf "%s/synapse" .Environment.Name | quote }}
        property: formSecret
        hidden: true
    templateData:
      lk-jwt.yaml: "id: \"LiveKit JWT service\"\nas_token: \"{{ "{{" }} .as_token {{ "}}" }}\"\nhs_token: \"{{ "{{" }} .hs_token {{ "}}" }}\"\nsender_localpart: \"_lk_jwt_service\"\nnamespaces:\n  users:\n    - exclusive: false\n      regex: \".*\"\nurl: null\nio.element.msc4502.scopes: [\"urn:matrix:client:io.element.msc4502:rooms:is_joined\"]\nio.element.msc4512.proxy_prefix: \"rtc/livekit\"\nio.element.msc4512.proxy_url: \"http://lk-jwt-service.mijnbureau-element.svc.cluster.local\""
      secrets.yaml: "database:\n  name: \"psycopg2\"\n  txn_limit: 10000\n  args:\n    host: element-cluster-rw\n    password: {{ "{{" }} .dbpassword {{ "}}" }}\n    port: 5432\n    user: synapse\n\nregistration_shared_secret: \"{{ "{{" }} .registration {{ "}}" }}\"\nform_secret: \"{{ "{{" }} .form {{ "}}" }}\"\n\nredis:\n  enabled: \"true\"\n  host: \"element-valkey\"\n  port: 6379\n  password: \"{{ "{{" }} .redispassword {{ "}}" }}\"\n  password_path:\n  dbid:\n  use_tls: false\n  certificate_file:\n  private_key_file:\n  ca_file:\n  ca_path:\n\nemail:\n  smtp_host: \"messages-mta.mijnbureau-messages.svc.cluster.local\"\n  smtp_port: 25\n  smtp_user: \"\"\n  smtp_pass: \"{{ "{{" }} .smtppass {{ "}}" }}\"\n  enable_tls: false\n  tlsname: \"\"\n  force_tls: false\n  require_transport_security: false\n  enable_notifs: false\n  notif_from: \"Your %(app)s homeserver <noreply@matrix.open-desk.nl>\"\n  app_name: \"Matrix\"\n  notif_for_new_users: true\n  delay_before_maik: \"10m\"\n  client_base_url: \"https://element.open-desk.nl\"\n  validation_token_lifetime: \"1h\"\n  invite_client_location: \"https://element.open-desk.nl\"\n  subjects:\n    email_validation: '[%(server_name)s] Validate your email'\n    invite_from_person: '[%(app)s] %(person)s has invited you to chat on %(app)s...'\n    invite_from_person_to_room: '[%(app)s] %(person)s has invited you to join the %(room)s room on %(app)s...'\n    message_from_person: '[%(app)s] You have a message on %(app)s from %(person)s...'\n    message_from_person_in_room: '[%(app)s] You have a message on %(app)s from %(person)s in the %(room)s room...'\n    messages_from_person: '[%(app)s] You have messages on %(app)s from %(person)s...'\n    messages_from_person_and_others: '[%(app)s] You have messages on %(app)s from %(person)s and others...'\n    messages_in_room: '[%(app)s] You have messages on %(app)s in the %(room)s room...'\n    messages_in_room_and_others: '[%(app)s] You have messages on %(app)s in the %(room)s room and others...'\n    password_reset: '[%(server_name)s] Password reset'\n\noidc_providers:\n  []\n\npassword_config:\n  enabled: false\n  localdb_enabled: true\n  pepper:\n  policy:\n    enabled: false\n    minimum_length: 0\n    require_digit: false\n    require_symbol: false\n    require_lowercase: false\n    require_uppercase: false"

  # --- mas (OIDC broker config + credentials) ---
  - name: element-mas
    target: element-mas
    type: Opaque
    data:
      - secretKey: dbpassword
        remoteKey: {{ printf "%s/mas" .Environment.Name | quote }}
        property: database
        hidden: true
      - secretKey: smtppass
        remoteKey: {{ printf "%s/smtp" .Environment.Name | quote }}
        property: password
        hidden: true
      - secretKey: sharedsecret
        remoteKey: {{ printf "%s/mas" .Environment.Name | quote }}
        property: sharedSecret
        hidden: true
      - secretKey: mas_client_secret
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: mas_client_secret
        hidden: true
    templateData:
      database-password: "{{ "{{" }} .dbpassword {{ "}}" }}"
      smtp-password: "{{ "{{" }} .smtppass {{ "}}" }}"
      secrets.yaml: "database:\n  host: \"element-cluster-rw\"\n  port: 5432\n  database: \"mas\"\n  username: \"mas\"\n  password_file: /etc/mas/database-password\n  max_connections: 10\n  min_connections: 0\n  connect_timeout: 30\n  idle_timeout: 600\n  max_lifetime: 1800\nemail:\n  from: \"Mijn Bureau <noreply@open-desk.nl>\"\n  reply_to: \"Mijn Bureau <noreply@open-desk.nl>\"\n  transport: \"smtp\"\n  mode: \"plain\"\n  hostname: \"messages-mta.mijnbureau-messages.svc.cluster.local\"\n  port: 25\nsecrets:\n  encryption_file: /secrets/encryption\n  keys:\n    - kid: \"default\"\n      key_file: /secrets/signing-key.pem\nmatrix:\n  homeserver: \"element.open-desk.nl\"\n  endpoint: \"http://element-mas.mijnbureau-element.svc.cluster.local\"\n  secret_file: /secrets/matrix-secret\nclients:\n  - client_id: \"01JCCW00000000000000000000\"\n    client_auth_method: client_secret_basic\n    client_secret_file: /secrets/client-secret-0\npasswords:\n  enabled: false\n  minimum_complexity: 3\naccount:\n  password_registration_enabled: false\n  password_change_enabled: false\n  password_recovery_enabled: false\n  email_change_allowed: false\n  displayname_change_allowed: false\n  account_deactivation_allowed: false\ntemplates:\n  path: /usr/local/share/mas-cli/templates/\n  assets_manifest: /usr/local/share/mas-cli/manifest.json\n  translations_path: /usr/local/share/mas-cli/translations/\npolicy:\n  wasm_module: /usr/local/share/mas-cli/policy.wasm\n  client_registration_entrypoint: client_registration/violation\n  register_entrypoint: register/violation\n  authorization_grant_entrypoint: authorization_grant/violation\n  password_entrypoint: password/violation\n  email_entrypoint: email/violation\n  data:\n    client_registration:\n      allow_insecure_uris: true\n      allow_missing_contacts: true\n    admin_users: []\nbranding:\n  service_name: \"Matrix Authentication Service\"\n  policy_uri: null\n  tos_uri: null\n  imprint: null\n  logo_uri: null\nupstream_oauth2:\n  providers:\n    - id: \"01JCCW0000000000000000000K\"\n      synapse_idp_id: \"oidc-mijnbureau\"\n      human_name: \"Mijn Bureau\"\n      issuer: \"https://id.open-desk.nl/realms/mijnbureau\"\n      client_id: \"mas\"\n      client_secret: \"{{ "{{" }} .mas_client_secret {{ "}}" }}\"\n      token_endpoint_auth_method: client_secret_post\n      scope: \"openid profile email\"\nexperimental:\n  access_token_ttl: 300\n  compat_token_ttl: 300"
