store:
  create: false   # ClusterSecretStore is rendered by the top-level openbao-store release

externalSecrets:
  - name: element-cluster-app
    target: element-cluster-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.synapse.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/synapse" .Environment.Name | quote }}
        property: database
  - name: element-cluster-superuser
    target: element-cluster-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/synapse" .Environment.Name | quote }}
        property: database_admin
  - name: element-cluster-mas-app
    target: element-cluster-mas-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.mas.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/mas" .Environment.Name | quote }}
        property: database
  - name: element-cluster-mas-superuser
    target: element-cluster-mas-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/mas" .Environment.Name | quote }}
        property: database_admin
  - name: element-valkey-auth
    target: element-valkey-auth
    data:
      - secretKey: default
        remoteKey: {{ printf "%s/synapse" .Environment.Name | quote }}
        property: password
