global:
  ## Global Docker image parameters
  ## Please, note that this will override the image parameters, including dependencies, configured to use the global value
  ## @param global.imageRegistry Global Docker Image registry
  ## @param global.imagePullSecrets Global Docker registry secret names as an array
  ##
  imageRegistry: {{(coalesce .Values.container.clamav.registry .Values.container.default.registry) | quote }}
  {{- with (coalesce .Values.container.clamav.imagePullSecret .Values.container.default.imagePullSecret) }}
  imagePullSecrets:
    - name: {{ . | quote }}
  {{- end }}
  ## @param global.defaultStorageClass Global default StorageClass for Persistent Volume(s)
  ##
  defaultStorageClass: {{ .Values.pvc.default.storageClass | quote }}

commonLabels:
  app.kubernetes.io/part-of: clamav

clusterDomain: {{ .Values.cluster.networking.domain | default "cluster.local" | quote }}

clamav:
  image:
    registry: {{(coalesce .Values.container.clamav.registry .Values.container.default.registry) | quote }}
    repository: {{ .Values.container.clamav.repository | quote }}
    tag: {{ .Values.container.clamav.tag | quote }}

  # Recreate: the virus database PVC is RWO, a RollingUpdate would deadlock
  # waiting for the old pod to release the volume before the new pod starts.
  updateStrategy:
    type: Recreate

  {{- if .Values.antivirus.icap.enabled }}
  # Only to include the ICAP port in the pod NetworkPolicy ingress rules; the
  # actual port lives on the chart-rendered icap sidecar container. Keep the
  # entry nameless: container port names must be unique pod-wide, and the
  # sidecar already declares an "icap" port.
  extraContainerPorts:
    - containerPort: {{ int .Values.antivirus.icap.port }}
  {{- end }}

  # ICAP sidecar (c-icap + embedded clamd/freshclam) serving LaSuite apps via
  # django-lasuite's ICAPBackend. See the chart's clamav.icap block.
  icap:
    enabled: {{ .Values.antivirus.icap.enabled }}
    image:
      registry: {{(coalesce .Values.container.clamav_icap.registry .Values.container.default.registry) | quote }}
      repository: {{ .Values.container.clamav_icap.repository | quote }}
      tag: {{ .Values.container.clamav_icap.tag | quote }}
    port: {{ int .Values.antivirus.icap.port }}
    resources: {{ (index (.Values.resource.clamav | default dict) "icap") | toYaml | nindent 6 }}

  resourcesPreset: {{ .Values.global.resourcesPreset | quote }}
  # omit the icap subkey: that configures the ICAP sidecar, not clamd itself.
  resources: {{ omit (.Values.resource.clamav | default dict) "icap" | toYaml | nindent 4 }}
  podSecurityContext: {{ .Values.security.default.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext:  {{ .Values.security.default.containerSecurityContext | toYaml | nindent 4 }}
  autoscaling:
    hpa: {{ .Values.autoscaling.horizontal.clamav | toYaml | nindent 6 }}
  pdb: {{ .Values.pdb.clamav | toYaml | nindent 4 }}
  runtimeClassName: {{ .Values.cluster.runtimeClassName | quote }}

  configuration:
    streamMaxLength: {{ int .Values.antivirus.streamMaxLength | quote }}
    milter:
      enabled: {{ .Values.antivirus.mailFilter.enabled }}
      maxFileSize: {{ int .Values.antivirus.mailFilter.maxFileSize | quote }}

persistence:
  enabled: true
  storageClass: {{ coalesce .Values.pvc.clamav.storageClass .Values.pvc.default.storageClass | quote }}
  accessModes: {{ coalesce .Values.pvc.clamav.accessModes .Values.pvc.default.accessModes (list "ReadWriteOnce") | toYaml | nindent 4 }}
  size: {{ coalesce .Values.pvc.clamav.size .Values.pvc.default.size "8Gi" }}

networkPolicy:
  enabled: true
  allowExternal: true
  addExternalClientAccess: true
  allowExternalEgress: false
  extraEgress:
    # Allow HTTPS/HTTP egress for freshclam database updates.
    - ports:
        - port: 443
          protocol: TCP

{{- if .Values.antivirus.icap.enabled }}
service:
  extraPorts:
    - name: icap
      port: {{ int .Values.antivirus.icap.port }}
      targetPort: icap
      protocol: TCP
{{- end }}
