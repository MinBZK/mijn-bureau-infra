store:
  create: false   # ClusterSecretStore is rendered by the top-level openbao-store release

externalSecrets:
  - name: find-cluster-app
    target: find-cluster-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.find.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: database
  - name: find-cluster-superuser
    target: find-cluster-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: database_admin
  - name: find-valkey-auth
    target: find-valkey-auth
    data:
      - secretKey: default
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: password
  - name: menshen-cluster-app
    target: menshen-cluster-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.menshen.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/menshen" .Environment.Name | quote }}
        property: database
  - name: menshen-cluster-superuser
    target: menshen-cluster-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/menshen" .Environment.Name | quote }}
        property: database_admin
  - name: menshen-valkey-auth
    target: menshen-valkey-auth
    data:
      - secretKey: default
        remoteKey: {{ printf "%s/menshen" .Environment.Name | quote }}
        property: password

  - name: find
    target: find
    type: Opaque
    data:
      - secretKey: DB_PASSWORD
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: database
      - secretKey: DJANGO_SECRET_KEY
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: secretkey
      - secretKey: DJANGO_SUPERUSER_PASSWORD
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: superUserPassword
      - secretKey: MENSHEN_CLIENT_SECRET
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: menshenClientFind
      - secretKey: OPENSEARCH_PASSWORD
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: opensearch
      - secretKey: password
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: password
        hidden: true
      - secretKey: docs_token
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: serviceTokenDocs
        hidden: true
      - secretKey: drive_token
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: serviceTokenDrive
        hidden: true
    staticData:
      OPENSEARCH_USER: "admin"
    templateData:
      REDIS_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@find-valkey:6379/1"
      FIND_SERVICE_TOKENS: '{"docs":"{{ "{{" }} .docs_token {{ "}}" }}","drive":"{{ "{{" }} .drive_token {{ "}}" }}"}'

  - name: menshen
    target: menshen
    type: Opaque
    data:
      - secretKey: DB_PASSWORD
        remoteKey: {{ printf "%s/menshen" .Environment.Name | quote }}
        property: database
      - secretKey: DJANGO_SECRET_KEY
        remoteKey: {{ printf "%s/menshen" .Environment.Name | quote }}
        property: secretkey
      - secretKey: DJANGO_SUPERUSER_PASSWORD
        remoteKey: {{ printf "%s/menshen" .Environment.Name | quote }}
        property: superUserPassword
      - secretKey: MENSHEN_CLIENT_SECRET_BUREAUBLAD
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: menshenClientBureaublad
      - secretKey: MENSHEN_CLIENT_SECRET_DOCS
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: menshenClientDocs
      - secretKey: MENSHEN_CLIENT_SECRET_DRIVE
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: menshenClientDrive
      - secretKey: MENSHEN_CLIENT_SECRET_FIND
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: menshenClientFind
      - secretKey: OIDC_RP_CLIENT_SECRET
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: menshen_client_secret
      - secretKey: OIDC_RS_CLIENT_SECRET
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: menshen_client_secret
      - secretKey: TOKEN_EXCHANGE_TOKEN_HASH_KEY
        remoteKey: {{ printf "%s/menshen" .Environment.Name | quote }}
        property: tokenHashKey
      - secretKey: password
        remoteKey: {{ printf "%s/menshen" .Environment.Name | quote }}
        property: password
        hidden: true
    templateData:
      REDIS_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@menshen-valkey:6379/1"
