store:
  create: false   # ClusterSecretStore is rendered by the top-level openbao-store release

externalSecrets:
  - name: find-cluster-app
    target: find-cluster-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.find.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: database
  - name: find-cluster-superuser
    target: find-cluster-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: database_admin
  - name: find-valkey-auth
    target: find-valkey-auth
    data:
      - secretKey: default
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: password
  - name: menshen-cluster-app
    target: menshen-cluster-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.menshen.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/menshen" .Environment.Name | quote }}
        property: database
  - name: menshen-cluster-superuser
    target: menshen-cluster-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/menshen" .Environment.Name | quote }}
        property: database_admin
  - name: menshen-valkey-auth
    target: menshen-valkey-auth
    data:
      - secretKey: default
        remoteKey: {{ printf "%s/menshen" .Environment.Name | quote }}
        property: password
