name: menshen-cluster
owner: {{ .Values.database.menshen.user }}
password: {{ .Values.database.menshen.password }}
adminPassword: {{ .Values.database.menshen.adminpassword }}

# When the app is migrated to OpenBao-backed secrets, ESO provisions the
# `menshen-cluster-app` / `menshen-cluster-superuser` Secrets and this chart must not
# render its own.
external: {{ eq (dig "secrets" "backend" "derived" .Values) "external" }}
