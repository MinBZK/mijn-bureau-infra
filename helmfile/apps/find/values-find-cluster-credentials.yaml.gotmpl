name: find-cluster
owner: {{ .Values.database.find.user }}
password: {{ .Values.database.find.password }}
adminPassword: {{ .Values.database.find.adminpassword }}

# When the app is migrated to OpenBao-backed secrets, ESO provisions the
# `find-cluster-app` / `find-cluster-superuser` Secrets and this chart must not
# render its own.
external: {{ eq (dig "secrets" "backend" "derived" .Values) "external" }}
