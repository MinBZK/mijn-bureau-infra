store:
  create: false   # ClusterSecretStore is rendered by the top-level openbao-store release

externalSecrets:
  - name: messages-cluster-app
    target: messages-cluster-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.messages.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/messages" .Environment.Name | quote }}
        property: database
  - name: messages-cluster-superuser
    target: messages-cluster-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/messages" .Environment.Name | quote }}
        property: database_admin
  - name: messages-valkey-auth
    target: messages-valkey-auth
    data:
      - secretKey: default
        remoteKey: {{ printf "%s/messages" .Environment.Name | quote }}
        property: password
  - name: messages-seaweedfs
    target: messages-seaweedfs
    staticData:
      access-key: "admin"
    data:
      - secretKey: secret-key
        remoteKey: {{ printf "%s/seaweedfs" .Environment.Name | quote }}
        property: messages

  - name: messages
    target: messages
    type: Opaque
    data:
      - secretKey: DJANGO_SECRET_KEY
        remoteKey: {{ printf "%s/messages" .Environment.Name | quote }}
        property: secretkey
      - secretKey: SALT_KEY
        remoteKey: {{ printf "%s/messages" .Environment.Name | quote }}
        property: saltkey
      - secretKey: DB_PASSWORD
        remoteKey: {{ printf "%s/messages" .Environment.Name | quote }}
        property: database
      - secretKey: OIDC_RP_CLIENT_SECRET
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: messages_client_secret
      - secretKey: MDA_API_SECRET
        remoteKey: {{ printf "%s/messages" .Environment.Name | quote }}
        property: mdaApiSecret
      - secretKey: MTA_OUT_RELAY_PASSWORD
        remoteKey: {{ printf "%s/messages" .Environment.Name | quote }}
        property: mtaRelayPassword
      - secretKey: AI_API_KEY
        remoteKey: {{ printf "%s/ai" .Environment.Name | quote }}
        property: llm_apiKey
      - secretKey: STORAGE_MESSAGE_IMPORTS_SECRET_KEY
        remoteKey: {{ printf "%s/seaweedfs" .Environment.Name | quote }}
        property: messages
      - secretKey: STORAGE_MESSAGE_BLOBS_SECRET_KEY
        remoteKey: {{ printf "%s/seaweedfs" .Environment.Name | quote }}
        property: messages
      - secretKey: STORAGE_MESSAGE_EXPORTS_SECRET_KEY
        remoteKey: {{ printf "%s/seaweedfs" .Environment.Name | quote }}
        property: messages
      - secretKey: KEYCLOAK_CLIENT_SECRET
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: messages_client_secret
      - secretKey: OIDC_STORE_REFRESH_TOKEN_KEY
        remoteKey: {{ printf "%s/messages" .Environment.Name | quote }}
        property: oidc-refresh-token-key
      - secretKey: password
        remoteKey: {{ printf "%s/messages" .Environment.Name | quote }}
        property: password
        hidden: true
    templateData:
      REDIS_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@messages-valkey:6379/0"
      CELERY_BROKER_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@messages-valkey:6379/0"
  - name: messages-superuser
    target: messages-superuser
    type: Opaque
    data:
      - secretKey: DJANGO_SUPERUSER_PASSWORD
        remoteKey: {{ printf "%s/messages" .Environment.Name | quote }}
        property: adminPassword
    staticData:
      DJANGO_SUPERUSER_EMAIL: {{ .Values.secret.messages.adminUser | quote }}
  - name: messages-calendars-channel
    target: messages-calendars-channel
    type: Opaque
    data:
      - secretKey: CALENDARS_CHANNEL_ID
        remoteKey: {{ printf "%s/calendars" .Environment.Name | quote }}
        property: messages-calendars-channel-id
      - secretKey: CALENDARS_CHANNEL_API_KEY
        remoteKey: {{ printf "%s/calendars" .Environment.Name | quote }}
        property: messages-calendars-channel-api-key
