name: messages-cluster
owner: {{ .Values.database.messages.user }}
password: {{ .Values.database.messages.password }}
adminPassword: {{ .Values.database.messages.adminpassword }}

# When the app is migrated to OpenBao-backed secrets, ESO provisions the
# `messages-cluster-app` / `messages-cluster-superuser` Secrets and this chart must not
# render its own.
external: {{ eq (dig "secrets" "backend" "derived" .Values) "external" }}
