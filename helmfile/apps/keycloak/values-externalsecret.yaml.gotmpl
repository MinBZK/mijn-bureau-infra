store:
  create: false   # ClusterSecretStore is rendered by the top-level openbao-store release

externalSecrets:
  - name: keycloak-cluster-app
    target: keycloak-cluster-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.keycloak.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: database
  - name: keycloak-cluster-superuser
    target: keycloak-cluster-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: database_admin

  # --- Keycloak admin credentials (keycloak-keycloak) ---
  - name: keycloak-keycloak
    target: keycloak-keycloak
    type: Opaque
    data:
      - secretKey: admin-password
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: adminPassword

  # --- Realm client secrets + SMTP + demo users (keycloak-config-cli) ---
  - name: keycloak-config-cli
    target: keycloak-config-cli
    type: Opaque
    data:
      - secretKey: MB_CLIENT_SECRET_SYNAPSE
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: synapse_client_secret
      - secretKey: MB_CLIENT_SECRET_MEET
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: meet_client_secret
      - secretKey: MB_CLIENT_SECRET_CONVERSATIONS
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: conversations_client_secret
      - secretKey: MB_CLIENT_SECRET_DRIVE
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: drive_client_secret
      - secretKey: MB_CLIENT_SECRET_PROJECTS
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: projects_client_secret
      - secretKey: MB_CLIENT_SECRET_PEOPLE
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: people_client_secret
      - secretKey: MB_CLIENT_SECRET_CALENDARS
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: calendars_client_secret
      - secretKey: MB_CLIENT_SECRET_DICTAPHONE
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: dictaphone_client_secret
      - secretKey: MB_CLIENT_SECRET_MESSAGES
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: messages_client_secret
      - secretKey: MB_CLIENT_SECRET_NEXTCLOUD
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: nextcloud_client_secret
      - secretKey: MB_CLIENT_SECRET_DOCS
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: docs_client_secret
      - secretKey: MB_CLIENT_SECRET_BUREAUBLAD
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: bureaublad_client_secret
      - secretKey: MB_CLIENT_SECRET_MAS
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: mas_client_secret
      - secretKey: MB_CLIENT_SECRET_MENSHEN
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: menshen_client_secret
      - secretKey: MB_SMTP_PASSWORD
        remoteKey: {{ printf "%s/smtp" .Environment.Name | quote }}
        property: password
    staticDataList:
      {{- range $user := .Values.user }}
      - key: {{ printf "MB_USER_PASSWORD_%s" (regexReplaceAll "[^A-Z0-9_]" (upper $user.username) "_") | quote }}
        value: {{ $user.password | toJson }}
      {{- end }}
