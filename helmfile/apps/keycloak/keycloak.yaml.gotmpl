# Values for the codecentric/keycloakx chart.
#
# The chart runs the official Keycloak image and uses KC_* environment
# variables. The Bitnami image, paths and scripts are no longer used.

fullnameOverride: keycloak
nameOverride: keycloak

commonLabels:
  app.kubernetes.io/component: keycloak
  app.kubernetes.io/part-of: keycloak

image:
  repository: {{ printf "%s/%s" (coalesce .Values.container.keycloak.registry .Values.container.default.registry | default "quay.io") .Values.container.keycloak.repository | quote }}
  tag: {{ .Values.container.keycloak.tag | default "26.8.1" | quote }}
  pullPolicy: Always

imagePullSecrets:
  {{- with (coalesce .Values.container.keycloak.imagePullSecret .Values.container.default.imagePullSecret) }}
  - name: {{ . | quote }}
  {{- end }}

clusterDomain: {{ .Values.cluster.networking.domain | default "cluster.local" | quote }}

command:
  - /opt/keycloak/bin/kc.sh
  - start

replicas: 1
podManagementPolicy: Parallel

{{- $keycloakSecurity := dig "security" "keycloak" (dict) .Values }}
{{- $podSecurityContext := .Values.security.default.podSecurityContext }}
{{- if hasKey $keycloakSecurity "podSecurityContext" }}
{{- $podSecurityContext = $keycloakSecurity.podSecurityContext }}
{{- end }}
{{- $containerSecurityContext := .Values.security.default.containerSecurityContext }}
{{- if hasKey $keycloakSecurity "containerSecurityContext" }}
{{- $containerSecurityContext = $keycloakSecurity.containerSecurityContext }}
{{- end }}
podSecurityContext: {{ omit $podSecurityContext "enabled" | toYaml | nindent 2 }}
securityContext: {{ omit $containerSecurityContext "enabled" | toYaml | nindent 2 }}

{{- $preset := .Values.global.resourcesPreset | default "none" }}
{{- $perAppPreset := .Values.global.resourcesPresetPerApp.keycloak | default $preset }}
{{- $keycloakPresets := dict
  "nano" (dict "requests" (dict "cpu" "1" "memory" "1280Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "2" "memory" "2Gi" "ephemeral-storage" "2Gi"))
  "micro" (dict "requests" (dict "cpu" "1" "memory" "1280Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "2" "memory" "2Gi" "ephemeral-storage" "2Gi"))
  "small" (dict "requests" (dict "cpu" "1" "memory" "1280Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "2" "memory" "2Gi" "ephemeral-storage" "2Gi"))
  "medium" (dict "requests" (dict "cpu" "1" "memory" "1280Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "2" "memory" "2Gi" "ephemeral-storage" "2Gi"))
  "large" (dict "requests" (dict "cpu" "1.0" "memory" "2048Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "1.5" "memory" "3072Mi" "ephemeral-storage" "2Gi"))
  "xlarge" (dict "requests" (dict "cpu" "1.0" "memory" "3072Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "3.0" "memory" "6144Mi" "ephemeral-storage" "2Gi"))
  "2xlarge" (dict "requests" (dict "cpu" "1.0" "memory" "3072Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "6.0" "memory" "12288Mi" "ephemeral-storage" "2Gi"))
}}
{{- $standardPresets := dict
  "nano" (dict "requests" (dict "cpu" "100m" "memory" "128Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "150m" "memory" "192Mi" "ephemeral-storage" "2Gi"))
  "micro" (dict "requests" (dict "cpu" "250m" "memory" "256Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "375m" "memory" "384Mi" "ephemeral-storage" "2Gi"))
  "small" (dict "requests" (dict "cpu" "500m" "memory" "512Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "750m" "memory" "768Mi" "ephemeral-storage" "2Gi"))
  "medium" (dict "requests" (dict "cpu" "500m" "memory" "1024Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "750m" "memory" "1536Mi" "ephemeral-storage" "2Gi"))
  "large" (dict "requests" (dict "cpu" "1.0" "memory" "2048Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "1.5" "memory" "3072Mi" "ephemeral-storage" "2Gi"))
  "xlarge" (dict "requests" (dict "cpu" "1.0" "memory" "3072Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "3.0" "memory" "6144Mi" "ephemeral-storage" "2Gi"))
  "2xlarge" (dict "requests" (dict "cpu" "1.0" "memory" "3072Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "6.0" "memory" "12288Mi" "ephemeral-storage" "2Gi"))
}}
{{- if .Values.resource.keycloak.keycloak }}
resources: {{ toYaml .Values.resource.keycloak.keycloak | nindent 2 }}
{{- else if and (ne $perAppPreset "none") (hasKey $keycloakPresets $perAppPreset) }}
resources: {{ index $keycloakPresets $perAppPreset | toYaml | nindent 2 }}
{{- else }}
resources: {}
{{- end }}

database:
  vendor: postgres
  hostname: {{ .Values.database.keycloak.host | quote }}
  port: {{ .Values.database.keycloak.port }}
  database: {{ .Values.database.keycloak.name | quote }}
  username: {{ .Values.database.keycloak.user | quote }}
  {{- if eq .Environment.Name "demo" }}
  existingSecret: keycloak-cluster-app
  existingSecretKey: password
  {{- else }}
  # Production uses the externally managed database; the password comes from
  # the environment's derived database.keycloak.password value.
  password: {{ .Values.database.keycloak.password | quote }}
  {{- end }}

dbchecker:
  enabled: true
  image:
    repository: {{ printf "%s/%s" (coalesce .Values.container.busybox.registry .Values.container.default.registry | default "docker.io") .Values.container.busybox.repository | quote }}
    tag: {{ .Values.container.busybox.tag | default "1.37.0-musl" | quote }}
    pullPolicy: Always
  securityContext: {{ omit .Values.security.default.containerSecurityContext "enabled" | toYaml | nindent 4 }}
  {{- if and (ne $perAppPreset "none") (hasKey $standardPresets $perAppPreset) }}
  resources: {{ index $standardPresets $perAppPreset | toYaml | nindent 4 }}
  {{- else }}
  resources: {}
  {{- end }}

cache:
  stack: default

proxy:
  enabled: true
  mode: xforwarded
  http:
    enabled: true

http:
  relativePath: "/"
  managementRelativePath: ""

health:
  enabled: true

metrics:
  # Enables KC_METRICS_ENABLED and the readiness probe. Scraping remains
  # controlled by serviceMonitor.enabled.
  enabled: true

serviceMonitor:
  enabled: {{ .Values.metric.serviceMonitor.enabled | default false }}

prometheusRule:
  enabled: {{ .Values.metric.prometheusRule.enabled | default false }}

autoscaling:
  enabled: {{ .Values.autoscaling.horizontal.keycloak.enabled }}
  minReplicas: {{ .Values.autoscaling.horizontal.keycloak.minReplicas }}
  maxReplicas: {{ .Values.autoscaling.horizontal.keycloak.maxReplicas }}
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: {{ .Values.autoscaling.horizontal.keycloak.targetCPU }}
    {{- if .Values.autoscaling.horizontal.keycloak.targetMemory }}
    - type: Resource
      resource:
        name: memory
        target:
          type: Utilization
          averageUtilization: {{ .Values.autoscaling.horizontal.keycloak.targetMemory }}
    {{- end }}

{{- if .Values.pdb.keycloak.create }}
podDisruptionBudget:
  minAvailable: {{ .Values.pdb.keycloak.minAvailable }}
  {{- if hasKey .Values.pdb.keycloak "maxUnavailable" }}
  maxUnavailable: {{ .Values.pdb.keycloak.maxUnavailable }}
  {{- end }}
{{- else }}
podDisruptionBudget: {}
{{- end }}

httpRoute:
  {{- if eq .Values.cluster.routingMode "gateway-api" }}
  enabled: true
  servicePort: 80
  parentRefs:
    - name: {{ .Values.cluster.gateway.name | quote }}
      namespace: {{ .Values.cluster.gateway.namespace | quote }}
      sectionName: https
  hostnames:
    - {{ printf "%s.%s" .Values.global.hostname.keycloak .Values.global.domain | quote }}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      filters:
        - type: ResponseHeaderModifier
          responseHeaderModifier:
            set:
              - name: Strict-Transport-Security
                value: "max-age=31536000; includeSubDomains; preload"
  {{- else }}
  enabled: false
  {{- end }}

ingress:
  {{- if eq .Values.cluster.routingMode "ingress" }}
  {{- $certificate := dig "cluster" "certificate" (dict) .Values }}
  {{- $issuerRef := dig "issuerRef" (dict) $certificate }}
  {{- $issuerName := dig "name" "" $issuerRef }}
  enabled: true
  ingressClassName: {{ .Values.cluster.ingress.className | quote }}
  annotations:
    {{- with .Values.cluster.ingress.annotations }}
    {{- toYaml . | nindent 4 }}
    {{- end }}
    {{- if $issuerName }}
    cert-manager.io/cluster-issuer: {{ $issuerName | quote }}
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "nginx" }}
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    nginx.ingress.kubernetes.io/configuration-snippet: |
      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "haproxy-openshift" }}
    haproxy.router.openshift.io/hsts_header: max-age=31536000;includeSubDomains;preload
    {{- end }}
    {{- if eq .Values.cluster.ingress.type "traefik" }}
    traefik.ingress.kubernetes.io/router.middlewares: '{{ .Values.application.keycloak.namespace }}-hsts-header@kubernetescrd'
    {{- end }}
  rules:
    - host: {{ printf "%s.%s" .Values.global.hostname.keycloak .Values.global.domain | quote }}
      paths:
        - path: /
          pathType: Prefix
  {{- if or $issuerName .Values.tls.keycloak }}
  tls:
    {{- with .Values.tls.keycloak }}
    {{- toYaml . | nindent 4 }}
    {{- else }}
    - hosts:
        - {{ printf "%s.%s" .Values.global.hostname.keycloak .Values.global.domain | quote }}
      secretName: keycloak-tls
    {{- end }}
  {{- end }}
  {{- else }}
  enabled: false
  {{- end }}

networkPolicy:
  enabled: true
  {{- $gateway := dig "cluster" "gateway" (dict) .Values }}
  {{- $gatewayNamespace := dig "namespace" "" $gateway }}
  extraFrom:
    {{- if and (eq .Values.cluster.routingMode "gateway-api") $gatewayNamespace }}
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{ $gatewayNamespace | quote }}
    {{- end }}
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{ .Values.application.keycloak.namespace | quote }}
    {{- if .Values.metric.enabled }}
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{ .Values.metric.namespace | default "monitoring" | quote }}
    {{- end }}
  # Preserve the old chart's allow-all egress. Keycloak needs the database,
  # and the DNS policy test recognizes a {} egress rule as allow-all.
  egress:
    - {}

extraEnv: |
  - name: KC_BOOTSTRAP_ADMIN_USERNAME
    value: {{ .Values.secret.keycloak.adminUser | quote }}
  - name: KC_BOOTSTRAP_ADMIN_PASSWORD
    valueFrom:
      secretKeyRef:
        name: keycloak-keycloak
        key: admin-password
  - name: KC_HOSTNAME
    value: {{ printf "https://%s.%s/" .Values.global.hostname.keycloak .Values.global.domain | quote }}
  - name: KC_HOSTNAME_STRICT
    value: "false"
  - name: KC_LOG_LEVEL
    value: "INFO"
  - name: KC_DB_SCHEMA
    value: "public"
  - name: KC_SPI_ADMIN_REALM
    value: "master"

extraManifests:
  # Keep the admin Secret name used by the deployment scripts and docs.
  - |
    apiVersion: v1
    kind: Secret
    metadata:
      name: keycloak-keycloak
      namespace: {{ "{{ .Release.Namespace }}" }}
      labels:
        app.kubernetes.io/name: keycloak
        app.kubernetes.io/instance: keycloak-keycloak
        app.kubernetes.io/version: {{ .Values.container.keycloak.tag | quote }}
        app.kubernetes.io/component: keycloak
        app.kubernetes.io/part-of: keycloak
        app.kubernetes.io/managed-by: Helm
    type: Opaque
    stringData:
      admin-password: {{ .Values.secret.keycloak.adminPassword | quote }}
  {{- if eq .Values.cluster.ingress.type "traefik" }}
  - |
    apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: hsts-header
      namespace: {{ "{{ .Release.Namespace }}" }}
      labels:
        app.kubernetes.io/name: keycloak
        app.kubernetes.io/instance: keycloak-keycloak
        app.kubernetes.io/version: {{ .Values.container.keycloak.tag | quote }}
        app.kubernetes.io/component: keycloak
        app.kubernetes.io/part-of: keycloak
        app.kubernetes.io/managed-by: Helm
    spec:
      headers:
        stsSeconds: 31536000
        stsPreload: true
        stsIncludeSubdomains: true
  {{- end }}
