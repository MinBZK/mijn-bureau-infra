fullnameOverride: keycloak-config-cli

image:
  registry: {{ coalesce .Values.container.keycloak_cli.registry .Values.container.default.registry | default "docker.io" | quote }}
  repository: {{ .Values.container.keycloak_cli.repository | default "adorsys/keycloak-config-cli" | quote }}
  tag: {{ .Values.container.keycloak_cli.tag | default "6.5.1-26.5.5" | quote }}
  pullPolicy: Always

imagePullSecrets:
  {{- with (coalesce .Values.container.keycloak_cli.imagePullSecret .Values.container.default.imagePullSecret) }}
  - name: {{ . | quote }}
  {{- end }}

keycloak:
  url: "http://keycloak-http:80/"
  user: {{ .Values.secret.keycloak.adminUser | quote }}
  existingSecret: keycloak-keycloak
  existingSecretKey: admin-password

serviceAccountName: keycloak
automountServiceAccountToken: false

{{- $preset := .Values.global.resourcesPreset | default "none" }}
{{- $perAppPreset := .Values.global.resourcesPresetPerApp.keycloak | default $preset }}
{{- $presets := dict
  "nano" (dict "requests" (dict "cpu" "100m" "memory" "128Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "150m" "memory" "192Mi" "ephemeral-storage" "2Gi"))
  "micro" (dict "requests" (dict "cpu" "250m" "memory" "256Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "375m" "memory" "384Mi" "ephemeral-storage" "2Gi"))
  "small" (dict "requests" (dict "cpu" "500m" "memory" "512Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "750m" "memory" "768Mi" "ephemeral-storage" "2Gi"))
  "medium" (dict "requests" (dict "cpu" "500m" "memory" "1024Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "750m" "memory" "1536Mi" "ephemeral-storage" "2Gi"))
  "large" (dict "requests" (dict "cpu" "1.0" "memory" "2048Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "1.5" "memory" "3072Mi" "ephemeral-storage" "2Gi"))
  "xlarge" (dict "requests" (dict "cpu" "1.0" "memory" "3072Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "3.0" "memory" "6144Mi" "ephemeral-storage" "2Gi"))
  "2xlarge" (dict "requests" (dict "cpu" "1.0" "memory" "3072Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "6.0" "memory" "12288Mi" "ephemeral-storage" "2Gi"))
}}
{{- if .Values.resource.keycloak.keycloak }}
resources: {{ toYaml .Values.resource.keycloak.keycloak | nindent 2 }}
{{- else if and (ne $perAppPreset "none") (hasKey $presets $perAppPreset) }}
resources: {{ index $presets $perAppPreset | toYaml | nindent 2 }}
{{- else }}
resources: {}
{{- end }}

podSecurityContext: {{ omit .Values.security.default.podSecurityContext "enabled" | toYaml | nindent 2 }}
securityContext: {{ omit .Values.security.default.containerSecurityContext "enabled" | toYaml | nindent 2 }}

networkPolicy:
  enabled: true
  egress:
    - {}

job:
  backoffLimit: 1
  ttlSecondsAfterFinished: 300
  hookWeight: "5"

import:
  filesLocations: /config/*
  varSubstitutionEnabled: true
  availabilityCheckEnabled: true
  availabilityCheckTimeout: 300s
  secrets:
    MB_CLIENT_SECRET_SYNAPSE: {{ .Values.authentication.client.synapse.client_secret | quote }}
    MB_CLIENT_SECRET_MEET: {{ .Values.authentication.client.meet.client_secret | quote }}
    MB_CLIENT_SECRET_CONVERSATIONS: {{ .Values.authentication.client.conversations.client_secret | quote }}
    MB_CLIENT_SECRET_DRIVE: {{ .Values.authentication.client.drive.client_secret | quote }}
    MB_CLIENT_SECRET_PROJECTS: {{ .Values.authentication.client.projects.client_secret | quote }}
    MB_CLIENT_SECRET_CALENDARS: {{ .Values.authentication.client.calendars.client_secret | quote }}
    MB_CLIENT_SECRET_DICTAPHONE: {{ .Values.authentication.client.dictaphone.client_secret | quote }}
    MB_CLIENT_SECRET_MESSAGES: {{ .Values.authentication.client.messages.client_secret | quote }}
    MB_CLIENT_SECRET_NEXTCLOUD: {{ .Values.authentication.client.nextcloud.client_secret | quote }}
    MB_CLIENT_SECRET_DOCS: {{ .Values.authentication.client.docs.client_secret | quote }}
    MB_CLIENT_SECRET_BUREAUBLAD: {{ .Values.authentication.client.bureaublad.client_secret | quote }}
    {{- if eq .Environment.Name "demo" }}
    {{- range $user := .Values.user }}
    MB_USER_PASSWORD_{{ regexReplaceAll "[^A-Z0-9_]" (upper $user.username) "_" }}: {{ $user.password | quote }}
    {{- end }}
    {{- end }}
  files:
    master.json: |
      {
        "realm" : "master",
        "attributes": {
          "frontendUrl": "https://{{ .Values.global.hostname.keycloak }}.{{ .Values.global.domain }}"
        }
      }
    mijnbureau.json: |
      {
        "realm" : "mijnbureau",
        "displayName": "Mijn Bureau",
        "displayNameHtml": "<b>Mijn Bureau</b>",
        "defaultSignatureAlgorithm": "RS256",
        "enabled" : true,
        "revokeRefreshToken": true,
        "editUsernameAllowed": false,
        "registrationAllowed": false,
        "duplicateEmailsAllowed": false,
        "rememberMe": true,
        "loginWithEmailAllowed": true,
        "bruteForceProtected": true,
        "permanentLockout": false,
        "maxTemporaryLockouts": 0,
        "bruteForceStrategy": "LINEAR",
        "maxFailureWaitSeconds": 900,
        "minimumQuickLoginWaitSeconds": 60,
        "waitIncrementSeconds": 60,
        "quickLoginCheckMilliSeconds": 1000,
        "maxDeltaTimeSeconds": 43200,
        "failureFactor": 30,
        "clients": [
          {
            "clientId": "{{ .Values.authentication.client.synapse.client_id }}",
            "name": "Chat",
            "description": "Matrix-based chat with Synapse",
            "rootUrl": "https://{{ .Values.global.hostname.synapse }}.{{ .Values.global.domain }}",
            "adminUrl": "https://{{ .Values.global.hostname.synapse }}.{{ .Values.global.domain }}",
            "baseUrl": "https://{{ .Values.global.hostname.synapse }}.{{ .Values.global.domain }}",
            "surrogateAuthRequired": false,
            "enabled": true,
            "alwaysDisplayInConsole": true,
            "clientAuthenticatorType": "client-secret",
            "secret": "$(env:MB_CLIENT_SECRET_SYNAPSE)",
            "redirectUris": [
              "/_synapse/client/oidc/callback"
            ],
            "webOrigins": [
              "https://{{ .Values.global.hostname.synapse }}.{{ .Values.global.domain }}"
            ],
            "notBefore": 0,
            "bearerOnly": false,
            "consentRequired": false,
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "publicClient": false,
            "frontchannelLogout": false,
            "protocol": "openid-connect",
            "attributes": {
              "realm_client": "false",
              "client.secret.creation.time": "1759388679",
              "backchannel.logout.session.required": "true",
              "backchannel.logout.url": "https://{{ .Values.global.hostname.synapse }}.{{ .Values.global.domain }}/_synapse/client/oidc/backchannel_logout",
              "standard.token.exchange.enabled": "false",
              "frontchannel.logout.session.required": "true",
              "post.logout.redirect.uris": "https://{{ .Values.global.hostname.synapse }}.{{ .Values.global.domain }}/*"
            }
