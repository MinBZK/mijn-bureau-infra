fullnameOverride: keycloak-config-cli

{{- $acr := .Values.authentication.acr }}

secrets:
  # When true (secrets.backend: external), ESO owns the `keycloak-config-cli`
  # Secret (realm client secrets + SMTP + demo-user passwords).
  external: {{ eq (dig "secrets" "backend" "derived" .Values) "external" }}

image:
  registry: {{ coalesce .Values.container.keycloak_cli.registry .Values.container.default.registry | default "docker.io" | quote }}
  repository: {{ .Values.container.keycloak_cli.repository | default "adorsys/keycloak-config-cli" | quote }}
  tag: {{ .Values.container.keycloak_cli.tag | default "6.5.1-26.5.5" | quote }}
  pullPolicy: Always

imagePullSecrets:
  {{- with (coalesce .Values.container.keycloak_cli.imagePullSecret .Values.container.default.imagePullSecret) }}
  - name: {{ . | quote }}
  {{- end }}

keycloak:
  url: "http://keycloak-http:80/"
  user: {{ .Values.secret.keycloak.adminUser | quote }}
  existingSecret: keycloak-keycloak
  existingSecretKey: admin-password

serviceAccountName: keycloak
automountServiceAccountToken: false

{{- $preset := .Values.global.resourcesPreset | default "none" }}
{{- $perAppPreset := .Values.global.resourcesPresetPerApp.keycloak | default $preset }}
{{- $presets := dict
  "nano" (dict "requests" (dict "cpu" "100m" "memory" "128Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "150m" "memory" "192Mi" "ephemeral-storage" "2Gi"))
  "micro" (dict "requests" (dict "cpu" "250m" "memory" "256Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "375m" "memory" "384Mi" "ephemeral-storage" "2Gi"))
  "small" (dict "requests" (dict "cpu" "500m" "memory" "512Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "750m" "memory" "768Mi" "ephemeral-storage" "2Gi"))
  "medium" (dict "requests" (dict "cpu" "500m" "memory" "1024Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "750m" "memory" "1536Mi" "ephemeral-storage" "2Gi"))
  "large" (dict "requests" (dict "cpu" "1.0" "memory" "2048Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "1.5" "memory" "3072Mi" "ephemeral-storage" "2Gi"))
  "xlarge" (dict "requests" (dict "cpu" "1.0" "memory" "3072Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "3.0" "memory" "6144Mi" "ephemeral-storage" "2Gi"))
  "2xlarge" (dict "requests" (dict "cpu" "1.0" "memory" "3072Mi" "ephemeral-storage" "50Mi") "limits" (dict "cpu" "6.0" "memory" "12288Mi" "ephemeral-storage" "2Gi"))
}}
{{- if .Values.resource.keycloak.keycloak }}
resources: {{ toYaml .Values.resource.keycloak.keycloak | nindent 2 }}
{{- else if and (ne $perAppPreset "none") (hasKey $presets $perAppPreset) }}
resources: {{ index $presets $perAppPreset | toYaml | nindent 2 }}
{{- else }}
resources: {}
{{- end }}

podSecurityContext: {{ omit .Values.security.default.podSecurityContext "enabled" | toYaml | nindent 2 }}
securityContext: {{ omit .Values.security.default.containerSecurityContext "enabled" | toYaml | nindent 2 }}

networkPolicy:
  enabled: true
  egress:
    - {}

job:
  backoffLimit: 1
  ttlSecondsAfterFinished: 300
  hookWeight: "5"

import:
  filesLocations: /config/*
  varSubstitutionEnabled: true
  availabilityCheckEnabled: true
  availabilityCheckTimeout: 300s
  secrets:
    MB_CLIENT_SECRET_SYNAPSE: {{ .Values.authentication.client.synapse.client_secret | quote }}
    MB_CLIENT_SECRET_MEET: {{ .Values.authentication.client.meet.client_secret | quote }}
    MB_CLIENT_SECRET_CONVERSATIONS: {{ .Values.authentication.client.conversations.client_secret | quote }}
    MB_CLIENT_SECRET_DRIVE: {{ .Values.authentication.client.drive.client_secret | quote }}
    MB_CLIENT_SECRET_PROJECTS: {{ .Values.authentication.client.projects.client_secret | quote }}
    MB_CLIENT_SECRET_CONTACTS: {{ .Values.authentication.client.contacts.client_secret | quote }}
    MB_CLIENT_SECRET_CALENDARS: {{ .Values.authentication.client.calendars.client_secret | quote }}
    MB_CLIENT_SECRET_DICTAPHONE: {{ .Values.authentication.client.dictaphone.client_secret | quote }}
    MB_CLIENT_SECRET_MESSAGES: {{ .Values.authentication.client.messages.client_secret | quote }}
    MB_CLIENT_SECRET_NEXTCLOUD: {{ .Values.authentication.client.nextcloud.client_secret | quote }}
    MB_CLIENT_SECRET_DOCS: {{ .Values.authentication.client.docs.client_secret | quote }}
    MB_CLIENT_SECRET_BUREAUBLAD: {{ .Values.authentication.client.bureaublad.client_secret | quote }}
    MB_CLIENT_SECRET_MAS: {{ .Values.authentication.client.mas.client_secret | quote }}
    MB_CLIENT_SECRET_MENSHEN: {{ .Values.authentication.client.menshen.client_secret | quote }}
    MB_SMTP_PASSWORD: {{ .Values.smtp.password | quote }}
    {{- if eq .Environment.Name "demo" }}
    {{- range $user := .Values.user }}
    MB_USER_PASSWORD_{{ regexReplaceAll "[^A-Z0-9_]" (upper $user.username) "_" }}: {{ $user.password | quote }}
    {{- end }}
    {{- end }}
  files:
    master.json: |
      {
        "realm" : "master",
        "attributes": {
          "frontendUrl": "https://{{ .Values.global.hostname.keycloak }}.{{ .Values.global.domain }}"
        }
      }
    {{- $userProfile := dict
      "attributes" (list
        (dict
          "name" "username"
          "displayName" "${username}"
          "validations" (dict
            "length" (dict "min" 3 "max" 255)
            "username-prohibited-characters" (dict)
            "up-username-not-idn-homograph" (dict)
          )
          "permissions" (dict
            "view" (list "admin" "user")
            "edit" (list "admin")
          )
          "multivalued" false
        )
        (dict
          "name" "email"
          "displayName" "${email}"
          "validations" (dict
            "email" (dict)
            "length" (dict "max" 255)
          )
          "required" (dict "roles" (list "user"))
          "permissions" (dict
            "view" (list "admin" "user")
            "edit" (list "admin")
          )
          "multivalued" false
        )
        (dict
          "name" "firstName"
          "displayName" "${firstName}"
          "validations" (dict
            "length" (dict "max" 255)
            "person-name-prohibited-characters" (dict)
          )
          "required" (dict "roles" (list "user"))
          "permissions" (dict
            "view" (list "admin" "user")
            "edit" (list "admin")
          )
          "multivalued" false
        )
        (dict
          "name" "lastName"
          "displayName" "${lastName}"
          "validations" (dict
            "length" (dict "max" 255)
            "person-name-prohibited-characters" (dict)
          )
          "required" (dict "roles" (list "user"))
          "permissions" (dict
            "view" (list "admin" "user")
            "edit" (list "admin")
          )
          "multivalued" false
        )
      )
      "groups" (list
        (dict
          "name" "user-metadata"
          "displayHeader" "User metadata"
          "displayDescription" "Attributes, which refer to user metadata"
        )
      )
    }}
    mijnbureau.json: |
      {
        "realm" : "mijnbureau",
        "displayName": "Mijn Bureau",
        "displayNameHtml": "<b>Mijn Bureau</b>",
        "defaultSignatureAlgorithm": "RS256",
        "enabled" : true,
        "browserFlow": "mijnbureau-browser",
        "organizationsEnabled": true,
        "revokeRefreshToken": true,
        "ssoSessionIdleTimeout": 43200,
        "ssoSessionMaxLifespan": 43200,
        "editUsernameAllowed": false,
        "registrationAllowed": false,
        "duplicateEmailsAllowed": false,
        "webAuthnPolicyRpEntityName": "Mijn Bureau",
        "webAuthnPolicySignatureAlgorithms": ["ES256", "RS256"],
        "webAuthnPolicyRpId": "",
        "webAuthnPolicyAttestationConveyancePreference": "not specified",
        "webAuthnPolicyAuthenticatorAttachment": {{ $acr.webauthn.attachment | quote }},
        "webAuthnPolicyRequireResidentKey": "not specified",
        "webAuthnPolicyUserVerificationRequirement": {{ $acr.webauthn.userVerification | quote }},
        "webAuthnPolicyCreateTimeout": {{ $acr.webauthn.createTimeout }},
        "webAuthnPolicyAvoidSameAuthenticatorRegister": false,
        "webAuthnPolicyAcceptableAaguids": [],
        "smtpServer": {
          {{- if .Values.smtp.host }}
          "host" : {{ .Values.smtp.host | quote }},
          "port" : {{ .Values.smtp.port | quote }},
          "from" : {{ .Values.smtp.from.email | quote }},
          {{- if .Values.smtp.username }}
          "user" : {{ .Values.smtp.username | quote }},
          "password" : "$(env:MB_SMTP_PASSWORD)",
          "auth" : "true",
          {{- end }}
          "starttls" : {{ ternary "true" "false" .Values.smtp.tls.enabled | quote }},
          "ssl" : "false"
          {{- end }}
        },
        "rememberMe": true,
        "loginWithEmailAllowed": true,
        "bruteForceProtected": true,
        "permanentLockout": false,
        "maxTemporaryLockouts": 0,
        "bruteForceStrategy": "LINEAR",
        "maxFailureWaitSeconds": 900,
        "minimumQuickLoginWaitSeconds": 60,
        "waitIncrementSeconds": 60,
        "quickLoginCheckMilliSeconds": 1000,
        "maxDeltaTimeSeconds": 43200,
        "failureFactor": 30,
        "clients": [
          {
            "clientId": "{{ .Values.authentication.client.synapse.client_id }}",
            "name": "Chat",
            "description": "Matrix-based chat with Synapse",
            "rootUrl": "https://{{ .Values.global.hostname.synapse }}.{{ .Values.global.domain }}",
            "adminUrl": "https://{{ .Values.global.hostname.synapse }}.{{ .Values.global.domain }}",
            "baseUrl": "https://{{ .Values.global.hostname.synapse }}.{{ .Values.global.domain }}",
            "surrogateAuthRequired": false,
            "enabled": true,
            "alwaysDisplayInConsole": true,
            "clientAuthenticatorType": "client-secret",
            "secret": "$(env:MB_CLIENT_SECRET_SYNAPSE)",
            "redirectUris": [
              "/_synapse/client/oidc/callback"
            ],
            "webOrigins": [
              "https://{{ .Values.global.hostname.synapse }}.{{ .Values.global.domain }}"
            ],
            "notBefore": 0,
            "bearerOnly": false,
            "consentRequired": false,
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "publicClient": false,
            "frontchannelLogout": false,
            "protocol": "openid-connect",
            "attributes": {
              "default.acr.values": {{ index $acr.clients "synapse" | default $acr.defaultLevel | quote }},
              "minimum.acr.value": {{ index $acr.clients "synapse" | default $acr.defaultLevel | quote }},
              "realm_client": "false",
              "client.secret.creation.time": "1759388679",
              "backchannel.logout.session.required": "true",
              "backchannel.logout.url": "https://{{ .Values.global.hostname.synapse }}.{{ .Values.global.domain }}/_synapse/client/oidc/backchannel_logout",
              "standard.token.exchange.enabled": "false",
              "frontchannel.logout.session.required": "true",
              "post.logout.redirect.uris": "https://{{ .Values.global.hostname.synapse }}.{{ .Values.global.domain }}/*"
            }
          },
          {
            "clientId": "{{ .Values.authentication.client.meet.client_id }}",
            "name": "Meet",
            "description": "livekit-based video conferencing with Meet",
            "rootUrl": "https://{{ .Values.global.hostname.meet }}.{{ .Values.global.domain }}",
            "adminUrl": "https://{{ .Values.global.hostname.meet }}.{{ .Values.global.domain }}",
            "baseUrl": "https://{{ .Values.global.hostname.meet }}.{{ .Values.global.domain }}",
            "surrogateAuthRequired": false,
            "enabled": true,
            "alwaysDisplayInConsole": true,
            "clientAuthenticatorType": "client-secret",
            "secret": "$(env:MB_CLIENT_SECRET_MEET)",
            "redirectUris": [
              "https://{{ .Values.global.hostname.meet }}.{{ .Values.global.domain }}/api/v1.0/callback/",
              "https://{{ .Values.global.hostname.meet }}.{{ .Values.global.domain }}/api/v1.0/logout-callback/"
            ],
            "webOrigins": [
              "https://{{ .Values.global.hostname.meet }}.{{ .Values.global.domain }}"
            ],
            "notBefore": 0,
            "bearerOnly": false,
            "consentRequired": false,
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "publicClient": false,
            "frontchannelLogout": false,
            "protocol": "openid-connect",
            "attributes": {
              "default.acr.values": {{ index $acr.clients "meet" | default $acr.defaultLevel | quote }},
              "minimum.acr.value": {{ index $acr.clients "meet" | default $acr.defaultLevel | quote }},
              "realm_client": "false",
              "oidc.ciba.grant.enabled": "false",
              "client.secret.creation.time": "1759388679",
              "backchannel.logout.session.required": "true",
              "standard.token.exchange.enabled": "false",
              "backchannel.logout.url": "https://{{ .Values.global.hostname.meet }}.{{ .Values.global.domain }}/api/v1.0/backchannel-logout/",
              "post.logout.redirect.uris": "https://{{ .Values.global.hostname.meet }}.{{ .Values.global.domain }}/*",
              "oauth2.device.authorization.grant.enabled": "false",
              "display.on.consent.screen": "false",
              "backchannel.logout.revoke.offline.tokens": "false"
            }
          },
          {
            "clientId": "{{ .Values.authentication.client.conversations.client_id }}",
            "name": "Conversations",
            "description": "AI assistant with LaSuite conversations",
            "rootUrl": "https://{{ .Values.global.hostname.conversations }}.{{ .Values.global.domain }}",
            "adminUrl": "https://{{ .Values.global.hostname.conversations }}.{{ .Values.global.domain }}",
            "baseUrl": "https://{{ .Values.global.hostname.conversations }}.{{ .Values.global.domain }}",
            "surrogateAuthRequired": false,
            "enabled": true,
            "alwaysDisplayInConsole": true,
            "clientAuthenticatorType": "client-secret",
            "secret": "$(env:MB_CLIENT_SECRET_CONVERSATIONS)",
            "redirectUris": [
              "https://{{ .Values.global.hostname.conversations }}.{{ .Values.global.domain }}/api/v1.0/callback/",
              "https://{{ .Values.global.hostname.conversations }}.{{ .Values.global.domain }}/api/v1.0/logout-callback/"
            ],
            "webOrigins": [
              "https://{{ .Values.global.hostname.conversations }}.{{ .Values.global.domain }}"
            ],
            "notBefore": 0,
            "bearerOnly": false,
            "consentRequired": false,
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "publicClient": false,
            "frontchannelLogout": true,
            "protocol": "openid-connect",
            "protocolMappers": [
              {
                "name": "audience-docs",
                "protocol": "openid-connect",
                "protocolMapper": "oidc-audience-mapper",
                "consentRequired": false,
                "config": {
                  "included.client.audience": "{{ .Values.authentication.client.docs.client_id }}",
                  "id.token.claim": "false",
                  "access.token.claim": "true",
                  "lightweight.claim": "false"
                }
              },
              {
                "name": "audience-self",
                "protocol": "openid-connect",
                "protocolMapper": "oidc-audience-mapper",
                "consentRequired": false,
                "config": {
                  "included.client.audience": "{{ .Values.authentication.client.conversations.client_id }}",
                  "id.token.claim": "false",
                  "access.token.claim": "true",
                  "lightweight.claim": "false"
                }
              }
            ],
            "attributes": {
              "default.acr.values": {{ index $acr.clients "conversations" | default $acr.defaultLevel | quote }},
              "minimum.acr.value": {{ index $acr.clients "conversations" | default $acr.defaultLevel | quote }},
              "realm_client": "false",
              "oidc.ciba.grant.enabled": "false",
              "client.secret.creation.time": "1759388679",
              "standard.token.exchange.enabled": "false",
              "frontchannel.logout.url": "https://{{ .Values.global.hostname.conversations }}.{{ .Values.global.domain }}/api/v1.0/logout/",
              "post.logout.redirect.uris": "https://{{ .Values.global.hostname.conversations }}.{{ .Values.global.domain }}/*",
              "frontchannel.logout.session.required": "false",
              "oauth2.device.authorization.grant.enabled": "false",
              "display.on.consent.screen": "false"
            }
          },
          {
            "clientId": "{{ .Values.authentication.client.drive.client_id }}",
            "name": "Drive",
            "description": "AI assistant with LaSuite drive",
            "rootUrl": "https://{{ .Values.global.hostname.drive }}.{{ .Values.global.domain }}",
            "adminUrl": "https://{{ .Values.global.hostname.drive }}.{{ .Values.global.domain }}",
            "baseUrl": "https://{{ .Values.global.hostname.drive }}.{{ .Values.global.domain }}",
            "surrogateAuthRequired": false,
            "enabled": true,
            "alwaysDisplayInConsole": true,
            "clientAuthenticatorType": "client-secret",
            "secret": "$(env:MB_CLIENT_SECRET_DRIVE)",
            "redirectUris": [
              "https://{{ .Values.global.hostname.drive }}.{{ .Values.global.domain }}/api/v1.0/callback/",
              "https://{{ .Values.global.hostname.drive }}.{{ .Values.global.domain }}/api/v1.0/logout-callback/"
            ],
            "webOrigins": [
              "https://{{ .Values.global.hostname.drive }}.{{ .Values.global.domain }}"
            ],
            "notBefore": 0,
            "bearerOnly": false,
            "consentRequired": false,
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "publicClient": false,
            "frontchannelLogout": true,
            "protocol": "openid-connect",
            "protocolMappers": [
              {
                "name": "audience-menshen",
                "protocol": "openid-connect",
                "protocolMapper": "oidc-audience-mapper",
                "consentRequired": false,
                "config": {
                  "included.client.audience": "{{ .Values.authentication.client.menshen.client_id }}",
                  "id.token.claim": "false",
                  "access.token.claim": "true",
                  "lightweight.claim": "false"
                }
              }
            ],
            "attributes": {
              "default.acr.values": {{ index $acr.clients "drive" | default $acr.defaultLevel | quote }},
              "minimum.acr.value": {{ index $acr.clients "drive" | default $acr.defaultLevel | quote }},
              "realm_client": "false",
              "oidc.ciba.grant.enabled": "false",
              "client.secret.creation.time": "1759388679",
              "standard.token.exchange.enabled": "false",
              "frontchannel.logout.url": "https://{{ .Values.global.hostname.drive }}.{{ .Values.global.domain }}/api/v1.0/logout/",
              "post.logout.redirect.uris": "https://{{ .Values.global.hostname.drive }}.{{ .Values.global.domain }}/*##https://{{ .Values.global.hostname.bureaublad }}.{{ .Values.global.domain }}/##https://{{ .Values.global.hostname.bureaublad }}.{{ .Values.global.domain }}",
              "frontchannel.logout.session.required": "false",
              "oauth2.device.authorization.grant.enabled": "false",
              "display.on.consent.screen": "false"
            }
          },
          {
            "clientId": "{{ .Values.authentication.client.projects.client_id }}",
            "name": "Projects",
            "description": "Collaborative project management from LaSuite",
            "rootUrl": "https://{{ .Values.global.hostname.projects }}.{{ .Values.global.domain }}",

            "adminUrl": "https://{{ .Values.global.hostname.projects }}.{{ .Values.global.domain }}",
            "baseUrl": "https://{{ .Values.global.hostname.projects }}.{{ .Values.global.domain }}",
            "surrogateAuthRequired": false,
            "enabled": true,
            "alwaysDisplayInConsole": true,
            "clientAuthenticatorType": "client-secret",
            "secret": "$(env:MB_CLIENT_SECRET_PROJECTS)",
            "redirectUris": [
              "https://{{ .Values.global.hostname.projects }}.{{ .Values.global.domain }}/oidc-callback"
            ],
            "webOrigins": [
              "https://{{ .Values.global.hostname.projects }}.{{ .Values.global.domain }}"
            ],
            "notBefore": 0,
            "bearerOnly": false,
            "consentRequired": false,
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "publicClient": false,
            "frontchannelLogout": false,
            "protocol": "openid-connect",
            "attributes": {
              "default.acr.values": {{ index $acr.clients "projects" | default $acr.defaultLevel | quote }},
              "minimum.acr.value": {{ index $acr.clients "projects" | default $acr.defaultLevel | quote }},
              "realm_client": "false",
              "oidc.ciba.grant.enabled": "false",
              "client.secret.creation.time": "[PHONE]",
              "standard.token.exchange.enabled": "false",
              "post.logout.redirect.uris": "https://{{ .Values.global.hostname.projects }}.{{ .Values.global.domain }}/*##https://{{ .Values.global.hostname.bureaublad }}.{{ .Values.global.domain }}/##https://{{ .Values.global.hostname.bureaublad }}.{{ .Values.global.domain }}",
              "frontchannel.logout.session.required": "false",
              "oauth2.device.authorization.grant.enabled": "false",
              "display.on.consent.screen": "false"
            }
          },
          {
            "clientId": "{{ .Values.authentication.client.contacts.client_id }}",
            "name": "Contacts",
            "description": "Shared contacts and address book service from LaSuite",
            "rootUrl": "https://{{ .Values.global.hostname.contacts }}.{{ .Values.global.domain }}",
            "adminUrl": "https://{{ .Values.global.hostname.contacts }}.{{ .Values.global.domain }}",
            "baseUrl": "https://{{ .Values.global.hostname.contacts }}.{{ .Values.global.domain }}",
            "surrogateAuthRequired": false,
            "enabled": true,
            "alwaysDisplayInConsole": true,
            "clientAuthenticatorType": "client-secret",
            "secret": "$(env:MB_CLIENT_SECRET_CONTACTS)",
            "redirectUris": [
              "https://{{ .Values.global.hostname.contacts }}.{{ .Values.global.domain }}/api/v1.0/callback/",
              "https://{{ .Values.global.hostname.contacts }}.{{ .Values.global.domain }}/api/v1.0/logout-callback/"
            ],
            "webOrigins": [
              "https://{{ .Values.global.hostname.contacts }}.{{ .Values.global.domain }}"
            ],
            "notBefore": 0,
            "bearerOnly": false,
            "consentRequired": false,
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "publicClient": false,
            "frontchannelLogout": true,
            "protocol": "openid-connect",
            "attributes": {
              "default.acr.values": {{ index $acr.clients "contacts" | default $acr.defaultLevel | quote }},
              "minimum.acr.value": {{ index $acr.clients "contacts" | default $acr.defaultLevel | quote }},
              "realm_client": "false",
              "oidc.ciba.grant.enabled": "false",
              "standard.token.exchange.enabled": "false",
              "frontchannel.logout.url": "https://{{ .Values.global.hostname.contacts }}.{{ .Values.global.domain }}/api/v1.0/logout/",
              "post.logout.redirect.uris": "https://{{ .Values.global.hostname.contacts }}.{{ .Values.global.domain }}/*##https://{{ .Values.global.hostname.bureaublad }}.{{ .Values.global.domain }}/##https://{{ .Values.global.hostname.bureaublad }}.{{ .Values.global.domain }}",
              "frontchannel.logout.session.required": "false",
              "oauth2.device.authorization.grant.enabled": "false",
              "display.on.consent.screen": "false"
            }
          },
          {
            "clientId": "{{ .Values.authentication.client.calendars.client_id }}",
            "name": "Calendars",
