            "name": "Messages",
            "description": "Collaborative inbox and email from LaSuite",
            "rootUrl": "https://{{ .Values.global.hostname.messages }}.{{ .Values.global.domain }}",
            "adminUrl": "https://{{ .Values.global.hostname.messages }}.{{ .Values.global.domain }}",
            "baseUrl": "https://{{ .Values.global.hostname.messages }}.{{ .Values.global.domain }}",
            "surrogateAuthRequired": false,
            "enabled": true,
            "alwaysDisplayInConsole": true,
            "clientAuthenticatorType": "client-secret",
            "secret": "$(env:MB_CLIENT_SECRET_MESSAGES)",
            "redirectUris": [
              "https://{{ .Values.global.hostname.messages }}.{{ .Values.global.domain }}/api/v1.0/callback/",
              "https://{{ .Values.global.hostname.messages }}.{{ .Values.global.domain }}/api/v1.0/logout-callback/"
            ],
            "webOrigins": [
              "https://{{ .Values.global.hostname.messages }}.{{ .Values.global.domain }}"
            ],
            "notBefore": 0,
            "bearerOnly": false,
            "consentRequired": false,
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "publicClient": false,
            "frontchannelLogout": true,
            "protocol": "openid-connect",
            "attributes": {
              "realm_client": "false",
              "oidc.ciba.grant.enabled": "false",
              "client.secret.creation.time": "[PHONE]",
              "standard.token.exchange.enabled": "false",
              "frontchannel.logout.url": "https://{{ .Values.global.hostname.messages }}.{{ .Values.global.domain }}/api/v1.0/logout/",
              "frontchannel.logout.session.required": "false",
              "post.logout.redirect.uris": "https://{{ .Values.global.hostname.messages }}.{{ .Values.global.domain }}/*##https://{{ .Values.global.hostname.bureaublad }}.{{ .Values.global.domain }}/##https://{{ .Values.global.hostname.bureaublad }}.{{ .Values.global.domain }}",
              "oauth2.device.authorization.grant.enabled": "false",
              "display.on.consent.screen": "false"
            },
            "protocolMappers": [
              {
                "name": "audience-messages",
                "protocol": "openid-connect",
                "protocolMapper": "oidc-audience-mapper",
                "consentRequired": false,
                "config": {
                  "included.client.audience": "{{ .Values.authentication.client.messages.client_id }}",
                  "access.token.claim": "true",
                  "id.token.claim": "false",
                  "userinfo.token.claim": "false"
                }
              }
            ]
          },
          {
            "clientId": "account",
            "enabled": false
          },
          {
            "clientId": "account-console",
            "enabled": false
          }
        ],
        "defaultRoles": ["offline_access", "uma_authorization"],
        {{- if eq .Environment.Name "demo" }}
        "users" : [
          {{- $users := .Values.user }}
          {{- range $index, $user := $users }}
          {
            "username" : {{ $user.username | quote }},
            "firstName" : {{ $user.firstname | quote }},
            "lastName" : {{ $user.lastname | quote }},
            "email" : {{ $user.email | quote }},
            "emailVerified" : true,
            "credentials" : [ {
              "type" : "password",
              "value": "$(env:MB_USER_PASSWORD_{{ regexReplaceAll "[^A-Z0-9_]" (upper $user.username) "_" }})",
              "temporary": false
            } ],
            "enabled" : true
          }{{- if lt $index (sub (len $users) 1) }},{{- end }}
          {{- end }}
        ],
        {{- end }}
        "internationalizationEnabled": true,
        "eventsEnabled": true,
        "eventsExpiration": 86400,
        "adminEventsEnabled": true,
        "supportedLocales": [
          "en",
          "{{ .Values.global.defaultLocale }}"
        ],
        "defaultLocale": "{{ .Values.global.defaultLocale }}"
      }
