        "authenticationFlows": [
          {
            "alias": "mijnbureau-browser",
            "description": "Browser flow with ACR step-up: password (1), OTP (2), WebAuthn (3)",
            "providerId": "basic-flow",
            "topLevel": true,
            "builtIn": false,
            "authenticationExecutions": [
              {
                "authenticator": "auth-cookie",
                "requirement": "ALTERNATIVE",
                "priority": 10
              },
              {
                "authenticator": "identity-provider-redirector",
                "requirement": "ALTERNATIVE",
                "priority": 20
              },
              {
                "authenticatorFlow": true,
                "flowAlias": "mijnbureau-forms",
                "requirement": "ALTERNATIVE",
                "priority": 30
              }
            ]
          },
          {
            "alias": "mijnbureau-forms",
            "description": "ACR level conditions; lowest level first",
            "providerId": "basic-flow",
            "topLevel": false,
            "builtIn": false,
            "authenticationExecutions": [
              {
                "authenticatorFlow": true,
                "flowAlias": "mijnbureau-acr-1",
                "requirement": "CONDITIONAL",
                "priority": 10
              },
              {
                "authenticatorFlow": true,
                "flowAlias": "mijnbureau-acr-2",
                "requirement": "CONDITIONAL",
                "priority": 20
              },
              {
                "authenticatorFlow": true,
                "flowAlias": "mijnbureau-acr-3",
                "requirement": "CONDITIONAL",
                "priority": 30
              }
            ]
          },
          {
            "alias": "mijnbureau-acr-1",
            "description": "ACR1: username and password",
            "providerId": "basic-flow",
            "topLevel": false,
            "builtIn": false,
            "authenticationExecutions": [
              {
                "authenticator": "conditional-level-of-authentication",
                "authenticatorConfig": "mijnbureau-loa-1",
                "requirement": "REQUIRED",
                "priority": 10
              },
              {
                "authenticator": "auth-username-password-form",
                "requirement": "REQUIRED",
                "priority": 20
              }
            ]
          },
          {
            "alias": "mijnbureau-acr-2",
            "description": "ACR2: password plus OTP",
            "providerId": "basic-flow",
            "topLevel": false,
            "builtIn": false,
            "authenticationExecutions": [
              {
                "authenticator": "conditional-level-of-authentication",
                "authenticatorConfig": "mijnbureau-loa-2",
                "requirement": "REQUIRED",
                "priority": 10
              },
              {
                "authenticator": "auth-otp-form",
                "requirement": "REQUIRED",
                "priority": 20
              }
            ]
          },
          {
            "alias": "mijnbureau-acr-3",
            "description": "ACR3: password, OTP and WebAuthn user verification",
            "providerId": "basic-flow",
            "topLevel": false,
            "builtIn": false,
            "authenticationExecutions": [
              {
                "authenticator": "conditional-level-of-authentication",
                "authenticatorConfig": "mijnbureau-loa-3",
                "requirement": "REQUIRED",
                "priority": 10
              },
              {
                "authenticator": "webauthn-authenticator",
                "requirement": "REQUIRED",
                "priority": 20
              }
            ]
          }
        ],
        "authenticatorConfig": [
          {
            "alias": "mijnbureau-loa-1",
            "config": {
              "loa-condition-level": "1",
              "loa-max-age": {{ index $acr.maxAge "1" | quote }}
            }
          },
          {
            "alias": "mijnbureau-loa-2",
            "config": {
              "loa-condition-level": "2",
              "loa-max-age": {{ index $acr.maxAge "2" | quote }}
            }
          },
          {
            "alias": "mijnbureau-loa-3",
            "config": {
              "loa-condition-level": "3",
              "loa-max-age": {{ index $acr.maxAge "3" | quote }}
            }
          }
        ],
        "components": {
          "org.keycloak.userprofile.UserProfileProvider": [
            {
              "providerId": "declarative-user-profile",
              "subComponents": {},
              "config": {
                "kc.user.profile.config": [
                  {{ $userProfile | toJson | quote }}
                ]
              }
            }
          ]
        },
        "defaultRoles": ["offline_access", "uma_authorization"],
        {{- if eq .Environment.Name "demo" }}
        "users" : [
          {{- $users := .Values.user }}
          {{- range $index, $user := $users }}
          {
            "username" : {{ $user.username | quote }},
            "firstName" : {{ $user.firstname | quote }},
            "lastName" : {{ $user.lastname | quote }},
            "email" : {{ $user.email | quote }},
            "emailVerified" : true,
            "credentials" : [ {
              "type" : "password",
              "value": "$(env:MB_USER_PASSWORD_{{ regexReplaceAll "[^A-Z0-9_]" (upper $user.username) "_" }})",
              "temporary": false
            } ],
            "enabled" : true
          }{{- if lt $index (sub (len $users) 1) }},{{- end }}
          {{- end }}
        ],
        {{- end }}
        {{- if eq .Environment.Name "demo" }}
        "organizations": [
          {
            "name": {{ .Values.authentication.organization.name | quote }},
            "alias": {{ .Values.authentication.organization.alias | quote }},
            "description": {{ .Values.authentication.organization.description | quote }},
            "enabled": true,
            "domains": [
              { "name": {{ coalesce .Values.authentication.organization.domain .Values.global.domain | quote }}, "verified": true }
            ],
            "members": [
              {{- range $index, $user := .Values.user }}
              { "username": {{ $user.username | quote }} }{{- if lt $index (sub (len $.Values.user) 1) }},{{- end }}
              {{- end }}
            ]
          }
        ],
        {{- end }}
        "internationalizationEnabled": true,
        "eventsEnabled": true,
        "eventsExpiration": 259200,
        "adminEventsEnabled": true,
        "attributes": {
          "adminEventsExpiration": "2592000",
          "acr.loa.map": {{ $acr.levels | toJson | quote }}
        },
        "supportedLocales": [
          "en",
          "{{ .Values.global.defaultLocale }}"
        ],
        "defaultLocale": "{{ .Values.global.defaultLocale }}"
      }
