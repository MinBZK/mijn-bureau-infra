name: keycloak-cluster
owner: {{ .Values.database.keycloak.user }}
password: {{ .Values.database.keycloak.password }}
adminPassword: {{ .Values.database.keycloak.adminpassword }}

# When the app is migrated to OpenBao-backed secrets, ESO provisions the
# `keycloak-cluster-app` / `keycloak-cluster-superuser` Secrets and this chart must not
# render its own.
external: {{ eq (dig "secrets" "backend" "derived" .Values) "external" }}
