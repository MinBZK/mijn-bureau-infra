name: projects-cluster
owner: {{ .Values.database.projects.user }}
password: {{ .Values.database.projects.password }}
adminPassword: {{ .Values.database.projects.adminpassword }}

# When the app is migrated to OpenBao-backed secrets, ESO provisions the
# `projects-cluster-app` / `projects-cluster-superuser` Secrets and this chart must not
# render its own.
external: {{ eq (dig "secrets" "backend" "derived" .Values) "external" }}
