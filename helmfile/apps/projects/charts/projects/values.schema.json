{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Projects helm chart values",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "defaultStorageClass": {
          "type": "string"
        },
        "security": {
          "type": "object",
          "properties": {
            "allowInsecureImages": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "kubeVersion": {
      "type": "string"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "namespaceOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object"
    },
    "commonAnnotations": {
      "type": "object"
    },
    "clusterDomain": {
      "type": "string"
    },
    "extraDeploy": {
      "type": "array"
    },
    "diagnosticMode": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "command": {
          "type": "array"
        },
        "args": {
          "type": "array"
        }
      }
    },
    "projects": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "registry": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": ["string", "integer"]
            },
            "digest": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            },
            "pullSecrets": {
              "type": "array"
            }
          }
        },
        "secretKey": {
          "type": "string"
        },
        "baseUrl": {
          "type": "string"
        },
        "logoutRedirectUrl": {
          "type": "string"
        },
        "serviceName": {
          "type": "string"
        },
        "theme": {
          "type": "object"
        },
        "adminEmail": {
          "type": "string"
        },
        "adminPassword": {
          "type": "string"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "containerPorts": {
          "type": "object"
        },
        "extraContainerPorts": {
          "type": "array"
        },
        "livenessProbe": {
          "$ref": "#/definitions/probe"
        },
        "readinessProbe": {
          "$ref": "#/definitions/probe"
        },
        "startupProbe": {
          "$ref": "#/definitions/probe"
        },
        "customLivenessProbe": {
          "type": "object"
        },
        "customReadinessProbe": {
          "type": "object"
        },
        "customStartupProbe": {
          "type": "object"
        },
        "resourcesPreset": {
          "$ref": "#/definitions/resourcesPreset"
        },
        "resources": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "existingConfigmap": {
          "type": "string"
        },
        "command": {
          "type": "array"
        },
        "args": {
          "type": "array"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        },
        "hostAliases": {
          "type": "array"
        },
        "deploymentAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podAffinityPreset": {
          "type": "string",
          "enum": ["", "soft", "hard"]
        },
        "podAntiAffinityPreset": {
          "type": "string",
          "enum": ["", "soft", "hard"]
        },
        "nodeAffinityPreset": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "updateStrategy": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["RollingUpdate", "Recreate"]
            }
          }
        },
        "priorityClassName": {
          "type": "string"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "schedulerName": {
          "type": "string"
        },
        "runtimeClassName": {
          "type": "string"
        },
        "terminationGracePeriodSeconds": {
          "type": ["integer", "string"]
        },
        "lifecycleHooks": {
          "type": "object"
        },
        "extraEnvVars": {
          "type": "array"
        },
        "extraEnvVarsCM": {
          "type": "string"
        },
        "extraEnvVarsSecret": {
          "type": "string"
        },
        "extraVolumes": {
          "type": "array"
        },
        "extraVolumeMounts": {
          "type": "array"
        },
        "sidecars": {
          "type": "array"
        },
        "initContainers": {
          "type": "array"
        },
        "pdb": {
          "$ref": "#/definitions/pdb"
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "hpa": {
              "$ref": "#/definitions/hpa"
            }
          }
        }
      }
    },
    "authentication": {
      "type": "object",
      "properties": {
        "issuer": {
          "type": "string"
        },
        "fullnameAttributes": {
          "type": "string"
        },
        "scopes": {
          "type": "string"
        },
        "emailAttribute": {
          "type": "string"
        },
        "client": {
          "type": "object",
          "properties": {
            "client_id": {
              "type": "string"
            },
            "client_secret": {
              "type": "string"
            }
          }
        }
      }
    },
    "externalRedis": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": ["integer", "string"]
        },
        "password": {
          "type": "string"
        }
      }
    },
    "externalMinio": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "accessKey": {
          "type": "string"
        },
        "secretKey": {
          "type": "string"
        },
        "bucket": {
          "type": "string"
        },
        "pathStyle": {
          "type": "boolean"
        }
      }
    },
    "smtp": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "secure": {
          "type": "boolean"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "from": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "ports": {
          "type": "object"
        },
        "nodePorts": {
          "type": "object"
        },
        "clusterIP": {
          "type": "string"
        },
        "loadBalancerIP": {
          "type": "string"
        },
        "loadBalancerSourceRanges": {
          "type": "array"
        },
        "externalTrafficPolicy": {
          "type": "string",
          "enum": ["Cluster", "Local"]
        },
        "annotations": {
          "type": "object"
        },
        "extraPorts": {
          "type": "array"
        },
        "sessionAffinity": {
          "type": "string",
          "enum": ["None", "ClientIP"]
        },
        "sessionAffinityConfig": {
          "type": "object"
        }
      }
    },
    "networkPolicy": {
      "$ref": "#/definitions/networkPolicy"
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "pathType": {
          "type": "string",
          "enum": ["Prefix", "Exact", "ImplementationSpecific"]
        },
        "apiVersion": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "ingressClassName": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "tls": {
          "type": "boolean"
        },
        "selfSigned": {
          "type": "boolean"
        },
        "extraHosts": {
          "type": "array"
        },
        "extraPaths": {
          "type": "array"
        },
        "extraTls": {
          "type": "array"
        },
        "secrets": {
          "type": "array"
        },
        "extraRules": {
          "type": "array"
        }
      }
    },
    "serviceAccount": {
      "$ref": "#/definitions/serviceAccount"
    },
    "cluster": {
      "type": "object",
      "properties": {
        "routingMode": {
          "type": "string",
          "enum": ["ingress", "gateway-api"]
        },
        "ingress": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["nginx", "traefik"]
            },
            "className": {
              "type": "string"
            }
          }
        },
        "gateway": {
          "type": "object"
        },
        "tls": {
          "type": "object",
          "properties": {
            "selfSigned": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "resourcesPreset": {
      "type": "string",
      "enum": [
        "",
        "none",
        "nano",
        "micro",
        "small",
        "medium",
        "large",
        "xlarge",
        "2xlarge"
      ]
    },
    "probe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "initialDelaySeconds": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        },
        "timeoutSeconds": {
          "type": "integer"
        },
        "failureThreshold": {
          "type": "integer"
        },
        "successThreshold": {
          "type": "integer"
        }
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": ["null", "string", "integer"]
        },
        "maxUnavailable": {
          "type": ["null", "string", "integer"]
        }
      }
    },
    "hpa": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPU": {
          "type": ["integer", "string"]
        },
        "targetMemory": {
          "type": ["string", "integer"]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowExternal": {
          "type": "boolean"
        },
        "allowExternalEgress": {
          "type": "boolean"
        },
        "addExternalClientAccess": {
          "type": "boolean"
        },
        "ingressNSMatchLabels": {
          "type": "object"
        },
        "ingressNSPodMatchLabels": {
          "type": "object"
        },
        "ingressPodMatchLabels": {
          "type": "object"
        },
        "extraIngress": {
          "type": "array"
        },
        "extraEgress": {
          "type": "array"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    }
  }
}
