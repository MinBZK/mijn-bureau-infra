store:
  create: false   # ClusterSecretStore is rendered by the top-level openbao-store release

externalSecrets:
  - name: projects-cluster-app
    target: projects-cluster-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.projects.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/projects" .Environment.Name | quote }}
        property: database
  - name: projects-cluster-superuser
    target: projects-cluster-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/projects" .Environment.Name | quote }}
        property: database_admin
  - name: projects-valkey-auth
    target: projects-valkey-auth
    data:
      - secretKey: default
        remoteKey: {{ printf "%s/projects" .Environment.Name | quote }}
        property: password
  - name: projects-minio
    target: projects-minio
    staticData:
      root-user: "admin"
    data:
      - secretKey: root-password
        remoteKey: {{ printf "%s/minio" .Environment.Name | quote }}
        property: projects

  - name: projects
    target: projects
    type: Opaque
    data:
      - secretKey: SECRET_KEY
        remoteKey: {{ printf "%s/projects" .Environment.Name | quote }}
        property: secretkey
      - secretKey: OIDC_CLIENT_SECRET
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: projects_client_secret
      - secretKey: DEFAULT_ADMIN_PASSWORD
        remoteKey: {{ printf "%s/projects" .Environment.Name | quote }}
        property: adminPassword
      - secretKey: SMTP_PASSWORD
        remoteKey: {{ printf "%s/smtp" .Environment.Name | quote }}
        property: password
      - secretKey: password
        remoteKey: {{ printf "%s/projects" .Environment.Name | quote }}
        property: password
        hidden: true
      - secretKey: dbpassword
        remoteKey: {{ printf "%s/projects" .Environment.Name | quote }}
        property: database
        hidden: true
    templateData:
      REDIS_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@projects-valkey:6379/0"
      DATABASE_URL: "postgresql://{{ .Values.database.projects.user }}:{{ "{{" }} .dbpassword {{ "}}" }}@{{ .Values.database.projects.host }}:{{ .Values.database.projects.port }}/{{ .Values.database.projects.name }}"
