bases:
  - "../../bases/default.yaml.gotmpl"

releases:
  - name: "projects-cluster-credentials"
    chart: ../common/charts/cnpg-cluster-credentials
    {{- if .Values.application.projects.namespace }}
    namespace: {{ .Values.application.projects.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.projects.enabled) | toYaml }}
    values:
      - "values-cnpg-cluster-credentials.yaml.gotmpl"

  - name: "projects-cluster"
    chart: ../common/charts/cluster
    {{- if .Values.application.projects.namespace }}
    namespace: {{ .Values.application.projects.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.projects.enabled) | toYaml }}
    needs:
      - {{ if .Values.application.projects.namespace }}{{ .Values.application.projects.namespace }}/{{ end }}projects-cluster-credentials
    values:
      - "values-cnpg-cluster.yaml.gotmpl"

  - name: projects-valkey
    chart: ../common/charts/valkey
    {{- if .Values.application.projects.namespace }}
    namespace: {{ .Values.application.projects.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.projects.enabled) | toYaml }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-valkey.yaml.gotmpl"
      - "values-valkey.yaml.gotmpl"

  - name: projects-minio
    chart: ../common/charts/minio
    version: "17.0.11"
    {{- if .Values.application.projects.namespace }}
    namespace: {{ .Values.application.projects.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.projects.enabled) | toYaml }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-cluster-ingress.yaml.gotmpl"
      - "values-minio.yaml.gotmpl"

  - name: "projects"
    chart: charts/projects
    condition: application.projects.enabled
    {{- if .Values.application.projects.namespace }}
    namespace: {{ .Values.application.projects.namespace }}
    {{- end }}
    {{- if and (eq .Environment.Name "demo") ( .Values.application.projects.enabled) }}
    needs:
      - {{ if .Values.application.projects.namespace }}{{ .Values.application.projects.namespace }}/{{ end }}projects-cluster
      - {{ if .Values.application.projects.namespace }}{{ .Values.application.projects.namespace }}/{{ end }}projects-valkey
      - {{ if .Values.application.projects.namespace }}{{ .Values.application.projects.namespace }}/{{ end }}projects-minio
    {{- end }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-cluster-ingress.yaml.gotmpl"
      - "values.yaml.gotmpl"
