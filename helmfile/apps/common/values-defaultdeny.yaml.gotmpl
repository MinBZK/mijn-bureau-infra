# Build the default-deny coverage from enabled applications with an explicit
# namespace. Apps without a namespace land in whichever namespace helmfile
# happens to target; baseline policies cannot cover them.
namespaces:
  {{- $entries := list }}
  {{- range $app, $cfg := .Values.application }}
    {{- if and (kindIs "map" $cfg) (dig "enabled" false $cfg) (dig "namespace" nil $cfg) }}
      {{- $entries = append $entries (printf "- name: %s" (dig "namespace" nil $cfg | quote)) }}
    {{- end }}
  {{- end }}
  {{- if $entries }}
  {{- range $entries }}
  {{ . }}
  {{- end }}
  {{- else }}
  []
  {{- end }}

# The CloudNativePG operator (cnpg-system) must reach instance pods on the
# instance-manager port; allow it in every isolated namespace.
allowedCrossNamespaceIngress:
  {{- range .Values.cluster.networkPolicy.defaultDeny.allow }}
  - name: {{ .name | quote }}
    ports: {{ .ports | toJson }}
  {{- end }}

# Baseline egress isolation for every covered namespace.
egress:
  enabled: {{ .Values.cluster.networkPolicy.defaultDeny.egress.enabled | default false }}

# DNS egress allowed by the default-deny-egress policy; mirrors
# cluster.networking.dns so pods can keep resolving names.
dns: {{ .Values.cluster.networking.dns | toYaml | nindent 2 }}

# Cluster-internal flows every application namespace relies on:
# - Keycloak for OIDC authentication (service port 80 and 443)
# - the Messages MTA for outbound mail submission (port 25)
allowedCrossNamespaceEgress:
  {{- if .Values.application.keycloak.enabled }}
  - name: {{ .Values.application.keycloak.namespace | quote }}
    ports: [80, 443]
  {{- end }}
  {{- if .Values.application.messages.enabled }}
  - name: {{ .Values.application.messages.namespace | quote }}
    ports: [25]
  {{- end }}
