bases:
  - "../../bases/default.yaml.gotmpl"

releases:
  - name: gateway
    chart: ../common/charts/gateway
    installed: {{ eq .Values.cluster.routingMode "gateway-api" | toYaml }}
    {{- if .Values.cluster.gateway.namespace }}
    namespace: {{ .Values.cluster.gateway.namespace | quote }}
    {{- end }}
    values:
      - "values-gateway.yaml.gotmpl"

  # Baseline ingress isolation: every enabled app namespace gets a
  # default-deny-ingress NetworkPolicy unless explicitly opted out.
  - name: defaultdeny
    chart: ../common/charts/defaultdeny
    installed: {{ .Values.cluster.networkPolicy.defaultDeny.enabled | toYaml }}
    namespace: kube-system
    values:
      - "values-defaultdeny.yaml.gotmpl"
