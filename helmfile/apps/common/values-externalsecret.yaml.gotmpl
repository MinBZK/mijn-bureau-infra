store:
  create: {{ eq (dig "secrets" "backend" "derived" .Values) "external" }}
  name: {{ dig "secrets" "store" "name" "openbao" .Values | quote }}
  server: {{ dig "secrets" "store" "server" "https://openbao.example.internal" .Values | quote }}
  mount: {{ dig "secrets" "store" "mount" "secret" .Values | quote }}
  pathPrefix: {{ dig "secrets" "store" "pathPrefix" "mijnbureau" .Values | quote }}
  version: v2
  auth:
    kubernetes:
      mountPath: kubernetes
      role: ""
      serviceAccount: {{ dig "secrets" "store" "kubernetes" "serviceAccount" "external-secrets" .Values | quote }}
      audience: {{ dig "secrets" "store" "kubernetes" "audience" "vault" .Values | quote }}

externalSecrets: []
