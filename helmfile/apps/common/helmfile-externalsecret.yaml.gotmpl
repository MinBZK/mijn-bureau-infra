bases:
  - "../../bases/default.yaml.gotmpl"

releases:
  # Cluster-scoped ClusterSecretStore pointing at OpenBao. Rendered only when
  # at least one app (or the global backend) is switched to external secrets.
  - name: openbao-store
    chart: ../common/charts/externalsecret
    installed: {{ eq (dig "secrets" "backend" "derived" .Values) "external" | toYaml }}
    values:
      - "values-externalsecret.yaml.gotmpl"
