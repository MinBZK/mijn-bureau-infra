store:
  create: false   # ClusterSecretStore is rendered by the top-level openbao-store release

externalSecrets:
  - name: bureaublad-valkey-auth
    target: bureaublad-valkey-auth
    data:
      - secretKey: default
        remoteKey: {{ printf "%s/bureaublad" .Environment.Name | quote }}
        property: password

  - name: bureaublad
    target: bureaublad
    type: Opaque
    data:
      - secretKey: AI_API_KEY
        remoteKey: {{ printf "%s/ai" .Environment.Name | quote }}
        property: llm_apiKey
      - secretKey: OIDC_CLIENT_SECRET
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: bureaublad_client_secret
      - secretKey: SECRET_KEY
        remoteKey: {{ printf "%s/bureaublad" .Environment.Name | quote }}
        property: secretkey
      - secretKey: MENSHEN_CLIENT_SECRET
        remoteKey: {{ printf "%s/find" .Environment.Name | quote }}
        property: menshenClientBureaublad
      - secretKey: password
        remoteKey: {{ printf "%s/bureaublad" .Environment.Name | quote }}
        property: password
        hidden: true
    templateData:
      REDIS_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@bureaublad-valkey:6379/1"
