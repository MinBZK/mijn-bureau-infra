bases:
  - "../../bases/default.yaml.gotmpl"

releases:
  - name: bureaublad-valkey
    chart: ../common/charts/valkey
    {{- if .Values.application.bureaublad.namespace }}
    namespace: {{ .Values.application.bureaublad.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") (.Values.application.bureaublad.enabled) | toYaml }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-valkey.yaml.gotmpl"
      - "values-valkey.yaml.gotmpl"

  - name: bureaublad
    chart: charts/bureaublad
    condition: application.bureaublad.enabled
    {{- if .Values.application.bureaublad.namespace }}
    namespace: {{ .Values.application.bureaublad.namespace }}
    {{- end }}
    {{- if and (eq .Environment.Name "demo") (.Values.application.bureaublad.enabled) }}
    needs:
      - {{ if .Values.application.bureaublad.namespace }}{{ .Values.application.bureaublad.namespace }}/{{ end }}bureaublad-valkey
    {{- end }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-cluster-ingress.yaml.gotmpl"
      - "values.yaml.gotmpl"
