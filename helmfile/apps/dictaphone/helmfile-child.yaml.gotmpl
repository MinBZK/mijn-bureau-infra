bases:
  - "../../bases/default.yaml.gotmpl"

releases:
  - name: dictaphone-cluster-credentials
    chart: ../common/charts/cnpg-cluster-credentials
    {{- if .Values.application.dictaphone.namespace }}
    namespace: {{ .Values.application.dictaphone.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") (.Values.application.dictaphone.enabled) | toYaml }}
    values:
      - "values-cnpg-cluster-credentials.yaml.gotmpl"

  - name: dictaphone-cluster
    chart: ../common/charts/cluster
    {{- if .Values.application.dictaphone.namespace }}
    namespace: {{ .Values.application.dictaphone.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") (.Values.application.dictaphone.enabled) | toYaml }}
    needs:
      - {{ if .Values.application.dictaphone.namespace }}{{ .Values.application.dictaphone.namespace }}/{{ end }}dictaphone-cluster-credentials
    values:
      - "values-cnpg-cluster.yaml.gotmpl"

  - name: dictaphone-valkey
    chart: ../common/charts/valkey
    {{- if .Values.application.dictaphone.namespace }}
    namespace: {{ .Values.application.dictaphone.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") (.Values.application.dictaphone.enabled) | toYaml }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-valkey.yaml.gotmpl"
      - "values-valkey.yaml.gotmpl"

  - name: dictaphone-seaweedfs
    chart: ../common/charts/seaweedfs
    {{- if .Values.application.dictaphone.namespace }}
    namespace: {{ .Values.application.dictaphone.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") (.Values.application.dictaphone.enabled) | toYaml }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-cluster-ingress.yaml.gotmpl"
      - "../common/values-seaweedfs.yaml.gotmpl"
      - "values-seaweedfs.yaml.gotmpl"

  # Media proxy with auth subrequest for /media (playback + downloads).
  # Gateway API has no auth_request; the in-pod nginx does it against the
  # backend's media-auth endpoint, same pattern as docs-nginx.
  - name: dictaphone-nginx
    chart: ../common/charts/nginx
    {{- if .Values.application.dictaphone.namespace }}
    namespace: {{ .Values.application.dictaphone.namespace }}
    {{- end }}
    condition: application.dictaphone.enabled
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-cluster-ingress.yaml.gotmpl"
      - "values-nginx.yaml.gotmpl"

  - name: dictaphone
    chart: charts/dictaphone
    condition: application.dictaphone.enabled
    {{- if .Values.application.dictaphone.namespace }}
    namespace: {{ .Values.application.dictaphone.namespace }}
    {{- end }}
    {{- if and (eq .Environment.Name "demo") (.Values.application.dictaphone.enabled) }}
    needs:
      - {{ if .Values.application.dictaphone.namespace }}{{ .Values.application.dictaphone.namespace }}/{{ end }}dictaphone-cluster
      - {{ if .Values.application.dictaphone.namespace }}{{ .Values.application.dictaphone.namespace }}/{{ end }}dictaphone-valkey
      - {{ if .Values.application.dictaphone.namespace }}{{ .Values.application.dictaphone.namespace }}/{{ end }}dictaphone-seaweedfs
    {{- end }}
    values:
      - "../common/values-cluster-dns.yaml.gotmpl"
      - "../common/values-cluster-ingress.yaml.gotmpl"
      - "values.yaml.gotmpl"

  # ESO-synced infra secrets (OpenBao -> Kubernetes). Rendered only when
  # the app is switched to external secrets; replaces the inline CNPG/
  # valkey/seaweedfs Secrets rendered by the releases above.
  - name: dictaphone-externalsecret
    chart: ../common/charts/externalsecret
    {{- if .Values.application.dictaphone.namespace }}
    namespace: {{ .Values.application.dictaphone.namespace }}
    {{- end }}
    installed: {{ and (eq .Environment.Name "demo") ( .Values.application.dictaphone.enabled) (eq (dig "secrets" "backend" "derived" .Values) "external") | toYaml }}
    values:
      - "values-externalsecret.yaml.gotmpl"
