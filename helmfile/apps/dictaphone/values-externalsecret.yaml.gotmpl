store:
  create: false   # ClusterSecretStore is rendered by the top-level openbao-store release

externalSecrets:
  - name: dictaphone-cluster-app
    target: dictaphone-cluster-app
    type: kubernetes.io/basic-auth
    staticData:
      username: {{ .Values.database.dictaphone.user | quote }}
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/dictaphone" .Environment.Name | quote }}
        property: database
  - name: dictaphone-cluster-superuser
    target: dictaphone-cluster-superuser
    type: kubernetes.io/basic-auth
    staticData:
      username: "postgres"
    data:
      - secretKey: password
        remoteKey: {{ printf "%s/dictaphone" .Environment.Name | quote }}
        property: database_admin
  - name: dictaphone-valkey-auth
    target: dictaphone-valkey-auth
    data:
      - secretKey: default
        remoteKey: {{ printf "%s/dictaphone" .Environment.Name | quote }}
        property: password
  - name: dictaphone-seaweedfs
    target: dictaphone-seaweedfs
    staticData:
      access-key: "admin"
    data:
      - secretKey: secret-key
        remoteKey: {{ printf "%s/seaweedfs" .Environment.Name | quote }}
        property: dictaphone

  - name: dictaphone
    target: dictaphone
    type: Opaque
    data:
      - secretKey: DJANGO_SECRET_KEY
        remoteKey: {{ printf "%s/dictaphone" .Environment.Name | quote }}
        property: secretkey
      - secretKey: SIMPLE_JWT_SIGNING_KEY
        remoteKey: {{ printf "%s/dictaphone" .Environment.Name | quote }}
        property: jwtSigningKey
      - secretKey: DB_PASSWORD
        remoteKey: {{ printf "%s/dictaphone" .Environment.Name | quote }}
        property: database
      - secretKey: OIDC_RP_CLIENT_SECRET
        remoteKey: {{ printf "%s/keycloak" .Environment.Name | quote }}
        property: dictaphone_client_secret
      - secretKey: AUDIO_EXTRACTOR_TRANSCODING_TOKEN
        remoteKey: {{ printf "%s/dictaphone" .Environment.Name | quote }}
        property: audioExtractorTranscodingToken
      - secretKey: AUDIO_EXTRACTOR_VALIDATION_TOKEN
        remoteKey: {{ printf "%s/dictaphone" .Environment.Name | quote }}
        property: audioExtractorValidationToken
      - secretKey: AI_SERVICE_API_KEY
        remoteKey: {{ printf "%s/dictaphone" .Environment.Name | quote }}
        property: aiServiceApiKey
      - secretKey: AI_WEBHOOK_API_KEY
        remoteKey: {{ printf "%s/dictaphone" .Environment.Name | quote }}
        property: aiWebhookApiKey
      - secretKey: DOCS_SERVER_TO_SERVER_API_KEY
        remoteKey: {{ printf "%s/docs" .Environment.Name | quote }}
        property: serverToServerApiToken
      - secretKey: DJANGO_EMAIL_HOST_PASSWORD
        remoteKey: {{ printf "%s/smtp" .Environment.Name | quote }}
        property: password
      - secretKey: password
        remoteKey: {{ printf "%s/dictaphone" .Environment.Name | quote }}
        property: password
        hidden: true
    templateData:
      REDIS_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@dictaphone-valkey:6379/1"
      CELERY_BROKER_URL: "redis://default:{{ "{{" }} .password {{ "}}" }}@dictaphone-valkey:6379/1"
      CELERY_RESULT_BACKEND: "redis://default:{{ "{{" }} .password {{ "}}" }}@dictaphone-valkey:6379/1"
  - name: dictaphone-superuser
    target: dictaphone-superuser
    type: Opaque
    data:
      - secretKey: DJANGO_SUPERUSER_PASSWORD
        remoteKey: {{ printf "%s/dictaphone" .Environment.Name | quote }}
        property: adminPassword
    staticData:
      DJANGO_SUPERUSER_EMAIL: {{ .Values.secret.dictaphone.adminUser | quote }}
