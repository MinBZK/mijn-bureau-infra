name: dictaphone-cluster
owner: {{ .Values.database.dictaphone.user }}
password: {{ .Values.database.dictaphone.password }}
adminPassword: {{ .Values.database.dictaphone.adminpassword }}

# When the app is migrated to OpenBao-backed secrets, ESO provisions the
# `dictaphone-cluster-app` / `dictaphone-cluster-superuser` Secrets and this chart must not
# render its own.
external: {{ eq (dig "secrets" "backend" "derived" .Values) "external" }}
