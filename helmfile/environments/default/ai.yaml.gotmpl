ai:
  # AI / LLM endpoint. Defaults to the in-cluster ollama;
  # override per environment to point at an external LLM.
  llm:
    model: ~
    endpoint:
      host: ~
      port: ~
      path: "v1"
      isSsl: true
      isInternal: false
    apiKey: ~

  # Dictaphone transcription service. Point `serviceUrl` at a service
  # compatible with the LaSuite Meeting Summary API.
  dictaphone:
    serviceUrl: ~
    serviceApiKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "dictaphone" "aiServiceApiKey" | sha1sum | quote }}
    webhookApiKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "dictaphone" "aiWebhookApiKey" | sha1sum | quote }}
