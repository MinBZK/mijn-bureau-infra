ai:
  llm:
    model: ~
    endpoint:
      host: ~
      port: ~
      path: "v1"
      isSsl: true
      isInternal: false
    apiKey: ~

  # OCR for conversations document upload (chat attachments). Deploys the
  # in-cluster ocr-shim, which translates the Mistral OCR schema that
  # conversations' AdaptivePdfParser speaks into an OpenRouter chat
  # completion using the file-parser plugin (mistral-ocr engine).
  ocr:
    enabled: false
    # Model name sent to the OCR endpoint (OCR_MODEL). Informational for the
    # shim; upstream the mistral-ocr engine is used regardless.
    model: "mistral-ocr-latest"
    # Cheap chat model used by the shim's completion call; the file-parser
    # plugin (mistral-ocr) does the actual OCR, this model only replies "OK".
    # Mistral keeps the whole request with one provider.
    chatModel: "mistralai/ministral-3b-2512"
    # Upstream chat-completions endpoint the shim calls. Any OpenAI-compatible
    # endpoint whose file-parser plugin supports the mistral-ocr engine works;
    # point it at a proxy or gateway here if traffic must not go direct.
    endpoint: ~
    # OpenRouter API key held by the shim. Empty falls back to ai.llm.apiKey.
    apiKey: ~

  # WhisperX-compatible speech-to-text endpoint used for batch transcription.
  whisperx:
    baseUrl: ~
    apiKey: ~
    # Model name understood by the configured endpoint, for example large-v3.
    # Leave empty to use the summary service default.
    asrModel: ~
    # ISO 639-1 language code. Leave empty to use global.defaultLocale.
    defaultLanguage: ~
    # Deploy the OpenAI translation shim (meet-openai-shim) that rewrites the
    # summary worker's WhisperX-style requests for the OpenAI audio
    # transcriptions API. Set baseUrl to the shim service when enabled.
    shim: false

  # Real-time speech-to-text provider used by the Meet LiveKit agents.
  # provider can be deepgram, kyutai or voxtral-vllm.
  stt:
    provider: "voxtral"
    deepgram:
      apiKey: ~
      model: "nova-3"
      # "multi" enables automatic multilingual code-switching.
      language: "multi"
    kyutai:
      baseUrl: ~
      apiKey: ~
    voxtral:
      baseUrl: ~
      apiKey: ~
      model: "voxtral-mini-4b-realtime-2602"
      targetStreamingDelayMs: 480

  dictaphone:
    serviceUrl: ~
    serviceApiKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "dictaphone" "aiServiceApiKey" | sha1sum | quote }}
    webhookApiKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "dictaphone" "aiWebhookApiKey" | sha1sum | quote }}
