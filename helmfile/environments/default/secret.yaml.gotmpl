secret:

  keycloak:
    adminUser: admin
    adminPassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "keycloak" "adminPassword" | sha1sum | quote}}
  collabora:
    credentials:
      username: "admin"
      password: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "collabora" "adminPassword" | sha1sum | quote }}

  nextcloud:
    adminUser: admin
    adminPassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "nextcloud" "adminPassword" | sha1sum | quote }}

  meet:
    adminUser: admin@example.com
    adminPassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "meet" "adminPassword" | sha1sum | quote }}
    summaryApiToken: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "meet" "summaryApiToken" | sha1sum | quote }}
    summaryWebhookApiToken: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "meet" "summaryWebhookApiToken" | sha1sum | quote }}

  conversations:
    adminUser: admin@example.com
    adminPassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "conversations" "adminPassword" | sha1sum | quote }}

  docs:
    superUser:
      email: admin@example.com
      password: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "docs" "superUserPassword" | sha1sum | quote}}

  drive:
    adminUser: admin@example.com
    adminPassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "drive" "adminPassword" | sha1sum | quote }}

  projects:
    adminUser: admin@example.com
    adminPassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "projects" "adminPassword" | sha1sum | quote }}

  calendars:
    adminUser: admin@example.com
    adminPassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "calendars" "adminPassword" | sha1sum | quote }}

  dictaphone:
    adminUser: admin@example.com
    adminPassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "dictaphone" "adminPassword" | sha1sum | quote }}

  messages:
    adminUser: admin@example.com
    adminPassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "messages" "adminPassword" | sha1sum | quote }}
    secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "messages" "secretkey" | sha1sum | quote }}
    saltKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "messages" "saltkey" | sha1sum | quote }}
    mdaApiSecret: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "messages" "mdaApiSecret" | sha1sum | quote }}
    # Used only when application.messages.relayHost is set.
    mtaRelayPassword: {{ env "MESSAGES_MTA_RELAY_PASSWORD" | default "" | quote }}
