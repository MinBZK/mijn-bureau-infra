cache:
  synapse:
    host: "element-valkey"
    port: 6379
    isInternal: true
    password: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "synapse" "password" | sha1sum | quote }}
  nextcloud:
    host: "nextcloud-valkey"
    port: 6379
    isInternal: true
    password: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "nextcloud" "password" | sha1sum | quote }}
