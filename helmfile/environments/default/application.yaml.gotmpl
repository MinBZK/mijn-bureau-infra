application:
  # branding hosts the MijnBureau header logos and per-app runtime styling,
  # consumed runtime by the apps' FRONTEND_CSS_URL and
  # theme-customization hooks
  branding:
    enabled: true
    namespace: ~

  # this creates a self hosted AI LLM system using Ollama. It can handle small loads.
  ollama:
    enabled: true
    namespace: ~
    model: "llama3.2:1b"
    gpu:
      enabled: false
      type:
      number:
      mig:
        enabled:
        devices:

  # keycloak is an identity and access management solution. If you have your own identity provider please disable this system and configure the OIDC settings in the authentication.yaml file.
  keycloak:
    enabled: true
    namespace: ~

  # element is a matrix based chat solution
  element:
    enabled: true
    namespace: ~
    synapse:
      architecture: monolith
      registrationSharedSecret: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "synapse" "registrationSharedSecret" | sha1sum | quote }}
      formSecret: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "synapse" "formSecret" | sha1sum | quote }}
    # Matrix Authentication Service: OIDC broker in front of Synapse, needed
    # by native clients (Element X). Enable to deploy MAS; Synapse delegates
    # auth to it via MSC3861 when application.element.mas.enabled is true.
    mas:
      enabled: true
      # Synapse↔MAS shared secret: lets MAS act on the homeserver as admin.
      sharedSecret: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "mas" "sharedSecret" | sha1sum | quote }}
      # ULID for the synapse compat client in MAS. Static per client (ULIDs
      # never rotate via the derives mechanism); change only if you must
      # re-bind the client registration.
      synapseClientUlid: "01JCCW00000000000000000000"
    # Ketesa (github.com/etkecc/ketesa, formerly Synapse Admin): browser-based
    # admin UI for users, rooms, media and federation. Static SPA with no
    # backend; the browser talks to Synapse's admin API directly.
    ketesa:
      enabled: false
      # Optional IP allowlist (CIDR ranges) for the Ketesa admin panel; renders
      # an Envoy Gateway SecurityPolicy when routingMode is gateway-api. Leave
      # empty to keep the panel publicly reachable (not recommended when
      # ketesa is enabled, since the Synapse admin API it drives is powerful).
      ipAllowlist: []
    # Element Call: MatrixRTC video/audio calling in Element Web, backed by
    # MatrixRTC transports announced through Synapse's well-known client data
    # and authenticated by lk-jwt-service against the LiveKit SFU.
    call:
      enabled: true
      # lk-jwt-service application service tokens (MSC4502/MSC4512 wiring with
      # Synapse). as_token authenticates lk-jwt towards Synapse, hs_token is
      # Synapse's credential towards the service; both sides read them from
      # these values (lk-jwt Secret and Synapse's registration file).
      asToken: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "lkjwt" "asToken" | sha1sum | quote }}
      hsToken: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "lkjwt" "hsToken" | sha1sum | quote }}

  # Collabora Online is a standalone real-time collaborative document server  that runs in a browser, and integrates with file storage platforms Nextcloud via WOPI or WebSocket APIs.
  collabora:
    enabled: true
    namespace: ~
    # required when running on OpenShift clusters with restricted security context constraints.
    enableInsecureCoolWSD: false

  # nextcloud is a self hosted file sharing platform
  nextcloud:
    enabled: false
    namespace: ~
    defaultQuota: "10 GB"
    uploadLimit: "512M"

  # livekit is a video conferencing backend system
  livekit:
    enabled: true
    namespace: ~
    loadBalancerIP: ~ # initial ip address for loadbalancer, cronjob will update it every hour
    portRangeStart: 30001 # UDP port range for loadbalancer
    portRangeEnd: 30009
    turnTLSecretName: ~
    # LiveKit's embedded TURN server (UDP). Helps participants behind
    # firewalls that block the RTC high-port range. Enabling creates an extra
    # LoadBalancer service (turn-hostname.domain must point at it via DNS).
    turn:
      enabled: false
      loadBalancerIP: ~ # optional pin, otherwise the LB controller assigns
    keys:
      apikey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "livekit" "apikey" | sha1sum | quote }}
      # Dedicated key for Element Call (lk-jwt-service); deliberately separate
      # from the apikey/meet key so credentials can be rotated independently.
      elementcall: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "livekit" "elementcall" | sha1sum | quote }}
    # LiveKit Egress records rooms and streams them to S3/RTMP. Meet uses it
    # for room recordings; the upload target is objectstore.meet. All other
    # egress settings have sane defaults in the livekit-egress chart.
    egress:
      enabled: true

  # meet is a video conferencing frontend for livekit
  meet:
    enabled: true
    namespace: ~
    secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "meet" "secretkey" | sha1sum | quote }}
    # Optional LiveKit agents; they need object storage and an STT provider.
    agents:
      enabled: false
      # The subtitles agent is opt-in and additionally needs ai.stt.
      subtitles:
        enabled: false
      envVars: {}
    # Summarization only needs ai.llm. Transcription additionally needs
    # ai.whisperx.baseUrl and is enabled automatically when that is set.
    summary:
      enabled: true
      envVars: {}
    # Who may record: false restricts start/stop to the room host and
    # co-hosts; true (upstream default) lets any signed-in participant record.
    recording:
      authenticatedParticipantsEnabled: false
      # Recording expiry, mirrored by a SeaweedFS filer TTL on the
      # recordings/ prefix (see helmfile/apps/meet/values-seaweedfs.yaml.gotmpl).
      expirationDays: 7
      # Shown to users as the recording cap (milliseconds). LiveKit Egress
      # does not enforce it; recording storage is bounded by the TTL above.
      maxDurationMs: 7200000
      # Default screen-recording resolution: 540p, 720p or 1080p.
      encodingResolution: 1080p
    celeryBackend:
      enabled: true

  # conversations is an prototype AI assistant from LaSuite
  conversations:
    enabled: true
    namespace: ~
    secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "conversations" "secretkey" | sha1sum | quote }}

  # docs is a note taking and document collaboration system from LaSuite
  docs:
    enabled: true
    namespace: ~
    # Token used for server-to-server calls into docs (dictaphone reads
    # details on processed audio, meet fetches meeting notes). Shared as an
    # env var; rotate it by rotating the master derivation seed.
    serverToServerApiToken: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "docs" "serverToServerApiToken" | sha1sum | quote }}
    backend:
      django:
        secretKey: {{ print ( derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "docs" "djangoSecretKey" | sha1sum ) ( derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "docs" "djangoSecretKey2" | sha1sum ) | trunc 63 | quote }}
    frontend:
      # When the GPLv3 is acceptable, this can be set to true. See https://github.com/suitenumerique/docs/blob/main/docs/env.md#impress-frontend-image
      publishAsMit: false
    yProvider:
      key: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "docs" "yProviderKey" | sha1sum | quote }}

  bureaublad:
    enabled: true
    namespace: ~
    backend:
      secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "bureaublad" "secretkey" | sha1sum | quote }}
    frontend:

  # drive is a document management system from LaSuite
  drive:
    enabled: true
    namespace: ~
    secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "drive" "secretkey" | sha1sum | quote }}
    secrettoServerKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "drive" "secrettoServerKey" | sha1sum | quote }}

  # find is the global search service from LaSuite. It indexes Docs and Drive
  # content in OpenSearch (one index per service) and exposes authenticated
  # full-text search endpoints. Search/delete are authenticated with user
  # tokens exchanged through Menshen, La Suite's OAuth 2.0 Token Exchange
  # server, which ships as part of this app.
  find:
    enabled: true
    namespace: ~
    secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "find" "secretkey" | sha1sum | quote }}
    # Whether Docs/Drive route their search API through Find. Indexing into
    # Find is active whenever find is enabled. Search additionally needs
    # Menshen token-exchange support in the deployed Docs/Drive images.
    searchEnabled: true
    # OpenSearch index prefix. Indices are named `{prefix}-{service}`.
    opensearchIndexPrefix: "find"
    # Service tokens Docs and Drive push their content with. Find requires
    # tokens of exactly 50 characters; only their hash is stored.
    serviceTokens:
      docs: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "find" "serviceTokenDocs" | sha256sum | trunc 50 | quote }}
      drive: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "find" "serviceTokenDrive" | sha256sum | trunc 50 | quote }}
    # Menshen token-exchange server. Find introspects search tokens with the
    # "find" client; Docs/Drive exchange user tokens with their own clients.
    menshen:
      enabled: true
      clientSecrets:
        find: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "find" "menshenClientFind" | sha1sum | quote }}
        docs: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "find" "menshenClientDocs" | sha1sum | quote }}
        drive: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "find" "menshenClientDrive" | sha1sum | quote }}
        bureaublad: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "find" "menshenClientBureaublad" | sha1sum | quote }}

  # projects is a collaborative project management system from LaSuite
  # theme overrides branding (favicon, colors, fonts, header/footer, feedback
  # widgets) and is passed to the Projects THEME env var. Empty keeps nothing
  # of the built-in LaSuite default theme.
  projects:
    enabled: true
    namespace: ~
    secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "projects" "secretkey" | sha1sum | quote }}
    theme: ~

  # contacts is the shared contacts and address book service from LaSuite.
  # It feeds people/group suggestions to Docs, Drive, Messages and Calendars.
  contacts:
    enabled: false
    namespace: ~
    secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "contacts" "secretkey" | sha1sum | quote }}
    saltKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "contacts" "saltkey" | sha1sum | quote }}

  # calendars is a calendar and scheduling application from LaSuite
  calendars:
    enabled: true
    namespace: ~
    secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "calendars" "secretkey" | sha1sum | quote }}
    saltKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "calendars" "saltkey" | sha1sum | quote }}
    caldav:
      inboundApiKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "calendars" "caldav_inbound" | sha1sum | quote }}
      outboundApiKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "calendars" "caldav_outbound" | sha1sum | quote }}
      internalApiKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "calendars" "caldav_internal" | sha1sum | quote }}

  # dictaphone is the Assistant Transcripts transcription and meeting workflow from LaSuite
  dictaphone:
    enabled: false
    namespace: ~
    secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "dictaphone" "secretkey" | sha1sum | quote }}
    jwtSigningKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "dictaphone" "jwtSigningKey" | sha1sum | quote }}
    audioExtractor:
      transcodingToken: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "dictaphone" "audioExtractorTranscodingToken" | sha1sum | quote }}
      validationToken: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "dictaphone" "audioExtractorValidationToken" | sha1sum | quote }}

  # messages is the collaborative inbox and email application from LaSuite
  messages:
    enabled: true
    namespace: ~
    # Mail domain that users receive mail on.
    mailDomain: ~
    # Hostname that MX records point at. Defaults to mail.<global.domain>.
    technicalDomain: ~
    # Optional public SMTP address to pin on the LoadBalancer.
    loadBalancerIP: ~
    # Optional outbound SMTP relay host or host:port. Leave empty for direct
    relayHost: ~
    relayUsername: ~
    # Extra environment variables for the backend and worker. Merged after the
    # repo-spam defaults, so entries here override them (e.g. SPAM_CONFIG).
    extraEnvVars: []
    # rspamd scan engine (helmfile/apps/messages/charts/rspamd): spam scoring,
    # DKIM/DMARC sender-auth banners and virus scanning of attachments via the
    # ClamAV clamd socket. While enabled, mail is held (RETRY, fail-closed)
    # if rspamd is unreachable — disable rspamd to scan nothing instead.
    rspamd:
      enabled: true
    # DKIM/DMARC sender-auth banners ("identity could not be verified",
    # "likely a forgery") from the rspamd scan's symbols. Set false to skip
    # sender-auth checks so no banner is shown; spam scoring stays active.
    inboundAuthEnabled: true

  # Clam AV is a virus toolkit
  clamav:
    enabled: true
    namespace: ~
