secrets:
  # ---------------------------------------------------------------------------
  # Secret backend.
  #
  #   derived   — (default) passwords are derived from MIJNBUREAU_MASTER_PASSWORD
  #               Charts render their own Kubernetes Secrets.
  #   external  — secrets come from OpenBao via External Secrets Operator (ESO).
  #               Charts stop rendering inline Secrets and consume the
  #               ESO-synced Secret instead. Applies to every app.
  # ---------------------------------------------------------------------------
  backend: derived

  # OpenBao / ESO store configuration. Overridden per environment in
  # helmfile/environments/<env>/*.yaml.gotmpl.
  store:
    name: openbao                                     # ClusterSecretStore name
    server: "https://openbao.<yourdomain>"            # OpenBao API address
    mount: kv                                         # KV v2 mount
    pathPrefix: mijnbureau                            # -> kv/data/mijnbureau/<env>/<owner>/<key>
    kubernetes:
      serviceAccount: external-secrets                # SA in the ESO namespace
      audience: vault
