---
global:
  domain: "kubernetes.local"
  # global.matrixDomain is the public-facing domain of the synapse server
  matrixDomain: ""

  # resourcePreset sets the default resources for all applications
  # allowed values "none","nano" "micro" "small" "medium" "large" "xlarge" "2xlarge"
  resourcesPreset: "small"

  # per-app resource presets override the global default above
  # if not set, the app falls back to global.resourcesPreset
  resourcesPresetPerApp:
    collabora: "small"
    elementweb: "nano"
    # Ketesa is a static SPA served by static-web-server.
    ketesa: "nano"
    keycloak: "small"
    ollama: "small"
    synapse: "large"
    livekit: "medium"
    # Egress needs ~4 CPUs per room composite recording. The preset still
    # caps it at 3 CPUs; set resource.livekit.egress for production sizing.
    livekitEgress: "xlarge"
    meet:
      backend: "micro"
      frontend: "nano"
      celeryBackend: "micro"
      agents: "micro"
      summary: "micro"
    nextcloud: "medium"
    docs:
      backend: "micro"
      frontend: "nano"
      celery: "micro"
      yProvider: "micro"
      yhub: "small"
      docspec: "micro"
    drive:
      backend: "micro"
      frontend: "nano"
    conversations:
      backend: "micro"
      frontend: "nano"
      celery: "micro"
      celeryBeat: "micro"
    projects: "micro"
    people:
      backend: "micro"
      frontend: "nano"
      celery: "micro"
      celeryBeat: "nano"
    calendars:
      backend: "micro"
      worker: "micro"
      frontend: "nano"
      caldav: "micro"
    dictaphone:
      backend: "micro"
      frontend: "nano"
      celery: "micro"
      audioExtractor: "micro"
      s3Gateway: "nano"
    messages:
      backend: "micro"
      worker: "micro"
      frontend: "nano"
      mta: "small"
      opensearch: "medium"
    bureaublad:
      backend: "micro"
      frontend: "nano"
    find:
      backend: "micro"
      opensearch: "medium"
    menshen:
      backend: "micro"

  # specify the subdomain for each component. this name will be combined with the base domain specified in the `domain` variable above
  hostname:
    keycloak: "id"
    element: "element"
    synapse: "matrix"
    # Matrix Authentication Service (OIDC broker for Element X / native clients)
    mas: "mas"
    # Element Call (MatrixRTC) embedded SPA used by Element Web for in-app calls
    element-call: "element-call"
    # MatrixRTC authorization service (element-hq/lk-jwt-service)
    livekit-jwt: "livekit-jwt"
    # Ketesa, the Synapse admin UI (github.com/etkecc/ketesa)
    ketesa: "ketesa"
    collabora: "collabora"
    nextcloud: "nextcloud"
    livekit: "livekit"
    meet: "meet"
    meet-minio: "meet-minio"
    conversations: "conversations"
    docs: "docs"
    bureaublad: "bureaublad"
    drive: "drive"
    projects: "projects"
    people: "people"
    calendars: "calendars"
    projects-minio: "projects-minio"
    people-minio: "people-minio"
    dictaphone: "dictaphone"
    dictaphone-minio: "dictaphone-minio"
    messages: "messages"
    messages-minio: "messages-minio"
    # Central branding assets host: one folder per application with the
    # MijnBureau header logo and runtime theme.css
    branding: "static"
    drive-minio: "drive-minio"
    # LaSuite Find global search API (+ admin) and its Menshen token-exchange
    # server. Only the admin UIs need public exposure; Docs/Drive reach both
    # services in-cluster.
    find: "find"
    menshen: "menshen"

  defaultLocale: "nl"

  # Global TLS configuration for all applications
  tls:
    enabled: true
    selfSigned: false
