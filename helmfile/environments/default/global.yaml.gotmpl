---
global:
  domain: "kubernetes.local"
  # global.matrixDomain is the public-facing domain of the synapse server
  matrixDomain: ""

  # resourcePreset sets the default resources for all applications
  # allowed values "none","nano" "micro" "small" "medium" "large" "xlarge" "2xlarge"
  resourcesPreset: "small"

  # per-app resource presets override the global default above
  # if not set, the app falls back to global.resourcesPreset
  resourcesPresetPerApp:
    collabora: "small"
    elementweb: "nano"
    keycloak: "small"
    ollama: "small"
    synapse: "large"
    livekit: "medium"
    # Egress needs ~4 CPUs per room composite recording. The preset still
    # caps it at 3 CPUs; set resource.livekit.egress for production sizing.
    livekitEgress: "xlarge"
    meet:
      backend: "micro"
      frontend: "nano"
      celeryBackend: "micro"
      agents: "micro"
      summary: "micro"
    nextcloud: "medium"
    docs:
      backend: "micro"
      frontend: "nano"
      celery: "micro"
      yProvider: "micro"
      docspec: "micro"
    drive:
      backend: "micro"
      frontend: "nano"
    conversations:
      backend: "micro"
      frontend: "nano"
      celery: "micro"
      celeryBeat: "micro"
    projects: "micro"
    calendars:
      backend: "micro"
      worker: "micro"
      frontend: "nano"
      caldav: "micro"
    dictaphone:
      backend: "micro"
      frontend: "nano"
      celery: "micro"
      audioExtractor: "micro"
      s3Gateway: "nano"
    messages:
      backend: "micro"
      worker: "micro"
      frontend: "nano"
      mta: "small"
      opensearch: "medium"
    bureaublad:
      backend: "micro"
      frontend: "nano"

  # specify the subdomain for each component. this name will be combined with the base domain specified in the `domain` variable above
  hostname:
    keycloak: "id"
    element: "element"
    synapse: "matrix"
    collabora: "collabora"
    nextcloud: "nextcloud"
    livekit: "livekit"
    meet: "meet"
    meet-minio: "meet-minio"
    conversations: "conversations"
    docs: "docs"
    bureaublad: "bureaublad"
    drive: "drive"
    projects: "projects"
    calendars: "calendars"
    projects-minio: "projects-minio"
    dictaphone: "dictaphone"
    dictaphone-minio: "dictaphone-minio"
    messages: "messages"
    messages-minio: "messages-minio"
    conversations-static: "static-conversations"
    drive-static: "static-drive"
    meet-static: "static-meet"
    docs-static: "static-docs"
    drive-minio: "drive-minio"
    openzaak: "zaken"

  defaultLocale: "nl"

  # Global TLS configuration for all applications
  tls:
    enabled: true
    selfSigned: false
