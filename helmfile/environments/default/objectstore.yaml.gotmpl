objectstore:
  # Region matches the nextcloud/helm community chart default. Required by
  # AWS-SDK-for-PHP for SigV4 signing — empty regions cause flaky behavior.
  nextcloud:
    bucket: "nextcloud"
    username: "admin"
    endpoint: "nextcloud-minio"
    port: 9000
    useSSL: false
    region: "eu-west-1"
    isInternal: true
    rootPassword: {{ derivePassword 1 "long" (env "MIJNBUREAU_MASTER_PASSWORD" | default "mijn-bureau") "minio" "nextcloud" | sha1sum | quote }}

  docs:
    bucket: "docs"
    username: "admin"
    endpoint: "docs-minio"
    port: 9000
    useSSL: false
    isInternal: true
    rootPassword: {{ derivePassword 1 "long" (env "MIJNBUREAU_MASTER_PASSWORD" | default "mijn-bureau") "minio" "docs" | sha1sum | quote }}

  drive:
    bucket: "drive"
    username: "admin"
    endpoint: "drive-minio"
    port: 9000
    useSSL: false
    isInternal: true
    rootPassword: {{ derivePassword 1 "long" (env "MIJNBUREAU_MASTER_PASSWORD" | default "mijn-bureau") "minio" "drive" | sha1sum | quote }}

  meet:
    bucket: "meet-media-storage"
    username: "admin"
    endpoint: "meet-minio"
    port: 9000
    useSSL: false
    region: "eu-west-1"
    isInternal: true
    rootPassword: {{ derivePassword 1 "long" (env "MIJNBUREAU_MASTER_PASSWORD" | default "mijn-bureau") "minio" "meet" | sha1sum | quote }}

  projects:
    bucket: "projects"
    username: "admin"
    endpoint: "projects-minio"
    port: 9000
    useSSL: false
    isInternal: true
    rootPassword: {{ derivePassword 1 "long" (env "MIJNBUREAU_MASTER_PASSWORD" | default "mijn-bureau") "minio" "projects" | sha1sum | quote }}

  dictaphone:
    bucket: "dictaphone"
    username: "admin"
    endpoint: "dictaphone-minio"
    port: 9000
    useSSL: false
    region: "eu-west-1"
    isInternal: true
    rootPassword: {{ derivePassword 1 "long" (env "MIJNBUREAU_MASTER_PASSWORD" | default "mijn-bureau") "minio" "dictaphone" | sha1sum | quote }}

  conversations:
    bucket: "conversations-media-storage"
    username: "admin"
    endpoint: "conversations-minio"
    port: 9000
    useSSL: false
    region: "eu-west-1"
    isInternal: true
    rootPassword: {{ derivePassword 1 "long" (env "MIJNBUREAU_MASTER_PASSWORD" | default "mijn-bureau") "minio" "conversations" | sha1sum | quote }}

  messages:
    username: "admin"
    endpoint: "messages-minio"
    port: 9000
    useSSL: false
    region: "eu-west-1"
    isInternal: true
    rootPassword: {{ derivePassword 1 "long" (env "MIJNBUREAU_MASTER_PASSWORD" | default "mijn-bureau") "minio" "messages" | sha1sum | quote }}
    # Public endpoint used to rewrite presigned import upload URLs. In the
    # demo environment this defaults to messages-minio.<global.domain>.
    publicUrl: ~
    buckets:
      media: "st-messages-media-storage"
      imports: "msg-imports"
      blobs: "msg-blobs"
      exports: "msg-exports"
