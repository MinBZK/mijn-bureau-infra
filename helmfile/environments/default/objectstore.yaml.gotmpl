objectstore:
  # Region matches the nextcloud/helm community chart default. Required by
  # AWS-SDK-for-PHP for SigV4 signing — empty regions cause flaky behavior.
  #
  # `endpoint` is the in-cluster Service of the per-app object store and
  # `port` the S3 gateway port. `accessKey`/`secretKey` are the admin
  # credentials derived from MIJNBUREAU_MASTER_PASSWORD.
  nextcloud:
    bucket: "nextcloud"
    accessKey: "admin"
    endpoint: "nextcloud-seaweedfs"
    port: 8333
    useSSL: false
    region: "eu-west-1"
    isInternal: true
    secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "seaweedfs" "nextcloud" | sha1sum | quote }}

  docs:
    bucket: "docs"
    accessKey: "admin"
    endpoint: "docs-seaweedfs"
    port: 8333
    useSSL: false
    isInternal: true
    secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "seaweedfs" "docs" | sha1sum | quote }}

  drive:
    bucket: "drive"
    accessKey: "admin"
    endpoint: "drive-seaweedfs"
    port: 8333
    useSSL: false
    isInternal: true
    secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "seaweedfs" "drive" | sha1sum | quote }}

  meet:
    bucket: "meet-media-storage"
    accessKey: "admin"
    endpoint: "meet-seaweedfs"
    port: 8333
    useSSL: false
    region: "eu-west-1"
    isInternal: true
    secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "seaweedfs" "meet" | sha1sum | quote }}

  projects:
    bucket: "projects"
    accessKey: "admin"
    endpoint: "projects-seaweedfs"
    port: 8333
    useSSL: false
    isInternal: true
    secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "seaweedfs" "projects" | sha1sum | quote }}

  people:
    bucket: "people-media-storage"
    accessKey: "admin"
    endpoint: "people-seaweedfs"
    port: 8333
    useSSL: false
    region: "eu-west-1"
    isInternal: true
    secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "seaweedfs" "people" | sha1sum | quote }}

  dictaphone:
    bucket: "dictaphone"
    accessKey: "admin"
    endpoint: "dictaphone-seaweedfs"
    port: 8333
    useSSL: false
    region: "eu-west-1"
    isInternal: true
    secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "seaweedfs" "dictaphone" | sha1sum | quote }}
    # The dictaphone S3-gateway-proxy serves presigned URLs to the Meet
    # frontend, which lives in another namespace.
    publicUrl: ~

  conversations:
    bucket: "conversations-media-storage"
    accessKey: "admin"
    endpoint: "conversations-seaweedfs"
    port: 8333
    useSSL: false
    region: "eu-west-1"
    isInternal: true
    secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "seaweedfs" "conversations" | sha1sum | quote }}

  messages:
    accessKey: "admin"
    endpoint: "messages-seaweedfs"
    port: 8333
    useSSL: false
    region: "eu-west-1"
    isInternal: true
    secretKey: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD") "seaweedfs" "messages" | sha1sum | quote }}
    # Public endpoint used to rewrite presigned import upload URLs. In the
    # demo environment this defaults to messages-objectstore.<global.domain>.
    publicUrl: ~
    buckets:
      media: "st-messages-media-storage"
      imports: "msg-imports"
      blobs: "msg-blobs"
      exports: "msg-exports"
