autoscaling:
  horizontal:
    ollama:
      enabled: true
      minReplicas: 1
      maxReplicas: 3
      targetCPU: 80
      targetMemory: ""
    keycloak:
      enabled: true
      minReplicas: 2
      maxReplicas: 3
      targetCPU: 75
      targetMemory: ""
    element:
      enabled: true
      minReplicas: 1
      maxReplicas: 3
      targetCPU: 75
    livekit:
      enabled: true
      minReplicas: 1
      maxReplicas: 3
      targetCPU: 60
      targetMemory: ""
    livekitEgress:
      # Egress is busy for the duration of a recording, so CPU based HPA is
      # of limited use. Scale replicas based on concurrent recordings instead.
      enabled: false
      minReplicas: 1
      maxReplicas: 3
      targetCPU: 60
      targetMemory: ""
    nextcloud:
      enabled: true
      minReplicas: 1
      maxReplicas: 3
      targetCPU: 75
      targetMemory: ""
    collabora:
      # it is disabled. Because after scaling it breaks the collaborative editing and copy/paste.
      enabled: false
      minReplicas: 1
      maxReplicas: 3
      targetCPU: 75
      targetMemory: ""
    meet:
      backend:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
      frontend:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
    conversations:
      backend:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
      celery:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
      frontend:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
    docs:
      backend:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
      celery:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
      frontend:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
      docspec:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
      yProvider:
        # Disabled, see: https://github.com/MinBZK/mijn-bureau-infra/issues/219
        enabled: false
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
    bureaublad:
      backend:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
      frontend:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
    drive:
      backend:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
      frontend:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
      celery:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
    projects:
      # Requires Redis and object storage, both enabled in the default environment.
      enabled: true
      minReplicas: 1
      maxReplicas: 3
      targetCPU: 80
      targetMemory: ""
    calendars:
      backend:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
      worker:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
      frontend:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
      caldav:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
    dictaphone:
      backend:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
      frontend:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
      celery:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
    messages:
      backend:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
      worker:
        # The worker runs the Celery beat scheduler. Keep a single replica
        # unless you split beat into its own deployment.
        enabled: false
        minReplicas: 1
        maxReplicas: 1
        targetCPU: 80
        targetMemory: ""
      frontend:
        enabled: true
        minReplicas: 1
        maxReplicas: 3
        targetCPU: 80
        targetMemory: ""
      mta:
        enabled: false
        minReplicas: 1
        maxReplicas: 1
        targetCPU: 80
        targetMemory: ""
    clamav:
      enabled: true
      minReplicas: 1
      maxReplicas: 3
      targetCPU: 75
      targetMemory: ""

  vertical:
    synapse:
      master:
        enabled: false
        annotations: {}
        controlledResources: []
        maxAllowed: {}
        minAllowed: {}
        updatePolicy:
          updateMode: Recreate
      worker:
        default:
          enabled: false
          annotations: {}
          controlledResources: []
          maxAllowed: {}
          minAllowed: {}
          updatePolicy:
            updateMode: Recreate
    docs:
      backend:
        enabled: true
        annotations: {}
        controlledResources: []
        maxAllowed: {}
        minAllowed: {}
        updatePolicy:
          updateMode: Recreate
      celery:
        enabled: false
        annotations: {}
        controlledResources: []
        maxAllowed: {}
        minAllowed: {}
        updatePolicy:
          updateMode: Recreate
      frontend:
        enabled: false
        annotations: {}
        controlledResources: []
        maxAllowed: {}
        minAllowed: {}
        updatePolicy:
          updateMode: Recreate
      yProvider:
        enabled: false
        annotations: {}
        controlledResources: []
        maxAllowed: {}
        minAllowed: {}
        updatePolicy:
          updateMode: Recreate
