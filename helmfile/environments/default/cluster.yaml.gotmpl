---
### This file contains all the kubernetes cluster-wide settings, please edit it to match your environment.
cluster:
  networking:
    domain: cluster.local
    podSubnet:
      - "10.244.0.0/16"
    serviceSubnet:
      - "10.96.0.0/12"
    # DNS egress in network policies.
    dns:
      external:
        port: 53  # Allowed to any destination.
      internal:
        # Set either field to add an internal DNS rule. The port defaults to 53.
        port: ~
        namespace: ~  # Leave unset to allow the internal port to any destination.

  # Baseline network isolation.
  networkPolicy:
    defaultDeny:
      # When enabled, every enabled application's explicit namespace receives a
      # default-deny-ingress NetworkPolicy: inbound traffic is only accepted
      # from pods of the same namespace or via the chart-provided policies
      # (charts set allowExternal/ingress match labels). One-off non-app
      # namespaces stay unaffected. Egress is component-policy territory.
      enabled: true
      # Cross-namespace ingress exceptions applied in every isolated
      # namespace. CloudNativePG's operator (in its own namespace) needs to
      # reach instance-manager (8000) on PostgreSQL clusters; metrics scraping
      # (9187) is included for producers that run the CNPG exporter.
      allow:
        - name: cnpg-system
          ports: [8000, 9187]

  # routingMode selects the routing technology.
  # Allowed values: ingress, gateway-api, none.
  # For ingress mode, set cluster.ingress.type to traefik (default), nginx or haproxy-openshift
  routingMode: ingress

  ingress:                # ingress config (used when routingMode = ingress)
    type: traefik       # traefik, nginx or haproxy-openshift
    className: ~
    # Annotations applied to every Ingress resource.
    annotations: ~

  gateway:                # Gateway API config (used when routingMode = gateway-api)
    name: mijnbureau-gateway
    namespace: ~   # defaults to same namespace as the route
    className: ~   # gatewayClassName for the Gateway resource
    certManagerClusterIssuer: ~
    # allowedRoutesNamespacesFrom controls which namespaces may attach HTTPRoutes to the Gateway.
    # Defaults to "All" because MijnBureau supports per-app namespaces.
    # For shared/production clusters consider "Selector" with an appropriate namespace label.
    allowedRoutesNamespacesFrom: ~
    # Annotations applied to every HTTPRoute resource.
    annotations: ~
  # Runtime class name for sandbox technology such as gvisor or kata
  runtimeClassName: ""
