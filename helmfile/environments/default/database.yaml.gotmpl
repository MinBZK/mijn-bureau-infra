database:
  keycloak:
    name: keycloak
    host: keycloak-cluster-rw
    port: 5432
    user: keycloak
    password: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "keycloak" "database" | sha1sum | quote}}
    adminpassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "keycloak" "database_admin" | sha1sum | quote}}

  synapse:
    type: psycopg2
    name: synapse
    host: element-cluster-rw
    port: 5432
    isInternal: true
    user: synapse
    password: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "synapse" "database" | sha1sum | quote}}
    adminpassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "synapse" "database_admin" | sha1sum | quote}}

  nextcloud:
    type: postgresql
    host: nextcloud-cluster-rw
    name: nextcloud
    user: nextcloud
    port: 5432
    isInternal: true
    password: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "nextcloud" "database" | sha1sum | quote}}
    adminpassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "nextcloud" "database_admin" | sha1sum | quote}}

  meet:
    type: postgresql
    host: meet-cluster-rw
    name: meet
    user: meet
    port: 5432
    isInternal: true
    password: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "meet" "database" | sha1sum | quote}}
    adminpassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "meet" "database_admin" | sha1sum | quote}}

  conversations:
    type: postgresql
    host: conversations-cluster-rw
    name: conversations
    user: conversations
    port: 5432
    isInternal: true
    password: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "conversations" "database" | sha1sum | quote}}
    adminpassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "conversations" "database_admin" | sha1sum | quote}}

  docs:
    engine: django.db.backends.postgresql_psycopg2
    name: docs
    host: docs-cluster-rw
    port: 5432
    isInternal: true
    user: docs
    password: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "docs" "database" | sha1sum | quote}}
    adminpassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "docs" "database_admin" | sha1sum | quote}}

  drive:
    type: postgresql
    host: drive-cluster-rw
    name: drive
    user: drive
    port: 5432
    isInternal: true
    password: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "drive" "database" | sha1sum | quote}}
    adminpassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "drive" "database_admin" | sha1sum | quote}}

  projects:
    type: postgresql
    host: projects-cluster-rw
    name: projects
    user: projects
    port: 5432
    isInternal: true
    password: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "projects" "database" | sha1sum | quote}}
    adminpassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "projects" "database_admin" | sha1sum | quote}}

  calendars:
    type: postgresql
    host: calendars-cluster-rw
    name: calendars
    user: calendars
    port: 5432
    isInternal: true
    password: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "calendars" "database" | sha1sum | quote}}
    adminpassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "calendars" "database_admin" | sha1sum | quote}}

  dictaphone:
    engine: django.db.backends.postgresql_psycopg2
    type: postgresql
    host: dictaphone-cluster-rw
    name: dictaphone
    user: dictaphone
    port: 5432
    isInternal: true
    password: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "dictaphone" "database" | sha1sum | quote}}
    adminpassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "dictaphone" "database_admin" | sha1sum | quote}}

  messages:
    type: postgresql
    host: messages-cluster-rw
    name: messages
    user: messages
    port: 5432
    isInternal: true
    password: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "messages" "database" | sha1sum | quote}}
    adminpassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "messages" "database_admin" | sha1sum | quote}}

  # openzaak requires postgis and pg_trgm; the demo environment provisions a
  # CNPG postgis cluster for it.
  openzaak:
    type: postgresql
    host: openzaak-cluster-rw
    name: openzaak
    user: openzaak
    port: 5432
    isInternal: true
    password: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "openzaak" "database" | sha1sum | quote}}
    adminpassword: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "openzaak" "database_admin" | sha1sum | quote}}
