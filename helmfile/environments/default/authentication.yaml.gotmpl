authentication:

  # Organization seeded into the in-cluster keycloak realm (demo environments
  # only). Member seeding follows the demo user list; the email domain defaults
  # to global.domain when `domain` is left empty.
  organization:
    name: "Mijn Bureau"
    alias: "mijnbureau"
    description: "Demo organization; all seeded demo users are members."
    domain: ~

  # OpenID Connect (OIDC) endpoints. Default to the in-cluster keycloak;
  # override per environment to point at an external identity provider.
  oidc:
    issuer: ~
    authorization_endpoint: ~
    token_endpoint: ~
    introspection_endpoint: ~
    userinfo_endpoint: ~
    end_session_endpoint: ~
    jwks_uri: ~
    discovery_endpoint: ~
    # Leave empty if the claim is not supplied.
    claims:
      username: preferred_username
      display_name: name
      given_name: given_name
      family_name: family_name
      # email field is required
      email: email
      email_verified: email_verified

  # Authentication Context Class Reference (ACR) assurance levels enforced by
  # Keycloak. The realm maps every ACR value to a numeric Level of Authentication
  # (LoA); the step-up browser flow then demands the matching factors:
  #   1 = username + password
  #   2 = + OTP
  #   3 = + WebAuthn (platform biometric / fingerprint)
  # Every client defaults to level 1. Raise a client in `clients` to require
  # step-up; Keycloak prompts for the missing factor on the next login.
  acr:
    # Level used for clients that are not listed in `clients`.
    defaultLevel: "1"
    levels:
      "1": 1
      "2": 2
      "3": 3
    # How long (seconds) a completed level stays valid in the SSO session.
    maxAge:
      "1": 43200
      "2": 43200
      "3": 3600
    # Per-client overrides, keyed by the entries under `client` below.
    # Example: docs: "2"
    clients: {}
    webauthn:
      # "required" forces a user-verifying authenticator (Touch ID, Windows
      # Hello, device biometrics). Use "not specified" to allow any WebAuthn
      # authenticator.
      userVerification: "required"
      # Use "platform" to exclude cross-platform (USB/NFC) security keys.
      attachment: "not specified"
      createTimeout: 0

  client:
    meet:
      client_id: "meet"
      client_secret: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "keycloak" "meet_client_secret" | sha1sum | quote}}
    synapse:
      client_id: "synapse"
      client_secret: {{ derivePassword 1 "long" ( requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "keycloak" "synapse_client_secret" | sha1sum | quote }}
    # MAS is an OIDC client of Keycloak (upstream password flow) and the OIDC
    # provider for Matrix clients. client_secret here is the MAS side of the
    # keycloak federation.
    mas:
      client_id: "mas"
      client_secret: {{ derivePassword 1 "long" ( requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "keycloak" "mas_client_secret" | sha1sum | quote }}
    nextcloud:
      client_id: "nextcloud"
      client_secret: {{ derivePassword 1 "long" ( requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "keycloak" "nextcloud_client_secret" | sha1sum | quote}}
    conversations:
      client_id: "conversations"
      client_secret: {{ derivePassword 1 "long" ( requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "keycloak" "conversations_client_secret" | sha1sum | quote}}
    docs:
      client_id: "docs"
      client_secret: {{ derivePassword 1 "long" ( requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "keycloak" "docs_client_secret" | sha1sum | quote }}
    bureaublad:
      client_id: "bureaublad"
      client_secret: {{ derivePassword 1 "long" ( requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "keycloak" "bureaublad_client_secret" | sha1sum | quote }}
    drive:
      client_id: "drive"
      client_secret: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "keycloak" "drive_client_secret" | sha1sum | quote}}
    projects:
      client_id: "projects"
      client_secret: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "keycloak" "projects_client_secret" | sha1sum | quote}}
    contacts:
      client_id: "contacts"
      client_secret: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "keycloak" "contacts_client_secret" | sha1sum | quote}}
    calendars:
      client_id: "calendars"
      client_secret: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "keycloak" "calendars_client_secret" | sha1sum | quote}}
    dictaphone:
      client_id: "dictaphone"
      client_secret: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "keycloak" "dictaphone_client_secret" | sha1sum | quote}}
    messages:
      client_id: "messages"
      client_secret: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "keycloak" "messages_client_secret" | sha1sum | quote}}
    # menshen introspects Docs/Drive user tokens in Keycloak with this client;
    # the docs/drive clients carry an "audience-menshen" protocol mapper so
    # their access tokens include menshen in the audience.
    menshen:
      client_id: "menshen"
      client_secret: {{ derivePassword 1 "long" (requiredEnv "MIJNBUREAU_MASTER_PASSWORD" ) "keycloak" "menshen_client_secret" | sha1sum | quote}}
