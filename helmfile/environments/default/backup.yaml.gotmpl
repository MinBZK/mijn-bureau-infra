# for backup to work, you need to have the velero kubernetes operator installed and configured in your cluster.
# we currently support backups to S3 compatible object storage, such as SeaweedFS. other options are available, see https://velero.io/docs/v1.18/supported-providers/ for more information.
backup:
  enabled: false
  schedule: "0 0 * * *"
  retention: 720h0m0s
  namespace: velero

  # Provide credentials here or via a SOPS secrets file under `backup.cnpg`.
  cnpg:
    endpointURL: ""            # e.g. "https://s3.example.com"
    bucket: ""                 # e.g. "mijnbureau-backups"
    region: "eu-west-1"
    accessKey: ""
    secretKey: ""
    # Object-store destination prefix inside the bucket; each cluster appends
    # its own name (<bucket>/<pathPrefix>/<app>).
    pathPrefix: "postgresql"
    # WAL/data transfer settings and retention for barman-cloud.
    walCompression: "gzip"
    walEncryption: "AES256"
    dataCompression: "gzip"
    dataEncryption: "AES256"
    retentionPolicy: "30d"
    scheduledBackups:
      - name: daily-backup
        schedule: "0 0 0 * * *"
        backupOwnerReference: self
        method: barmanObjectStore

  BackupStorageLocation:
    provider: aws
    objectStorage:
      bucket: my-velero-backups-bucket
      prefix: mijnbureau-backups
    config:
      region: us-east-1
      publicUrl: "https://your-s3-compatible-endpoint.com"

  VolumeSnapshotLocation:
    provider: aws
    config:
      region: us-east-1
      publicUrl: "https://your-s3-compatible-endpoint.com"
